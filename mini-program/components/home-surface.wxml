<import src="./published-content.wxml" />

<view class="home-page" style="background-color: {{theme.pageBackgroundColor}};">
  <view wx:if="{{state === 'ready'}}" class="home-header store-home-header" style="background-color: {{theme.headerBackgroundColor}}; color: {{theme.brandTextColor}}; padding-top: {{headerPadding}}px;">
    <view class="store-brand-row" style="padding-right: {{capsuleRight}}px;">
      <view class="store-logo"><image src="{{storeLogoUrl || '/assets/ui/parcel.svg'}}" mode="aspectFit" data-url="{{storeLogoUrl}}" binderror="onStoreLogoError" aria-label="前置仓Logo"/></view><view class="store-brand-body"><view class="store-name-line"><text class="brand">{{diningVisit ? diningVisit.restaurant.name : (store ? store.name : '请选择前置仓')}}</text><button wx:if="{{!diningVisit}}" class="store-switch" bindtap="chooseStore">⇄ 切换</button></view><view class="store-hours">{{diningVisit ? diningVisit.table.number + ' 桌 · 送至本店餐桌' : (store ? (store.acceptingOrders ? '营业接单 · ' : '暂停接单 · ') + store.openingHours : '选择前置仓，查看商品与库存')}}</view></view>
    </view><view wx:if="{{diningVisit}}" class="restaurant-address">{{diningVisit.restaurant.address}}</view><view wx:if="{{storeError}}" class="store-location-help" bindtap="chooseStore">{{storeError}}</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-skeleton" role="status" aria-label="正在准备首页"><view class="skeleton-header"><view class="skeleton-logo"/><view class="skeleton-copy"><view class="skeleton-title"/><view class="skeleton-subtitle"/></view></view><view class="skeleton-search"/><view class="skeleton-banner"/><view class="skeleton-content"/><view class="skeleton-caption">正在准备首页…</view></view>
  <view wx:elif="{{state === 'unpublished'}}" class="home-state">
    <view class="state-title">首页内容准备中</view>
    <view class="state-copy">商品分类仍可浏览，欢迎先去看看。</view>
    <button class="state-action" bindtap="browseCatalog">浏览商品分类</button>
  </view>
  <view wx:elif="{{state === 'error' || state === 'expired' || state === 'auth'}}" class="home-state" role="alert">
    <view class="state-title">{{state === 'expired' || state === 'auth' ? '请重新扫描餐桌码' : '首页加载失败'}}</view>
    <view class="state-copy">{{error}}</view>
    <button wx:if="{{state !== 'expired' && state !== 'auth'}}" class="state-action" bindtap="loadHome">重新加载</button><button wx:else class="state-action" bindtap="scan">重新扫码</button>
    <button wx:if="{{state !== 'expired' && state !== 'auth'}}" class="text-action" bindtap="browseCatalog">浏览商品分类</button>
  </view>
  <block wx:else>
    <template is="published-content" data="{{components: components, keyword: keyword, failedAssets: failedAssets, couponState: couponState, couponData: couponData, couponError: couponError, couponClaim: couponClaim}}" />
  </block>
</view>
<storefront-shell wx:if="{{state !== 'loading'}}" show-navigation="{{true}}" show-service="{{true}}" />
