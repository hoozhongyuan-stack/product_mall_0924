.commerce-line{display:flex;gap:20rpx;padding:20rpx 0;border-top:1rpx solid var(--mall-border);font-size:28rpx;line-height:1.5}.commerce-image{width:112rpx;height:112rpx;flex:none;background:var(--mall-canvas);border-radius:8rpx}.commerce-placeholder{display:flex;align-items:center;justify-content:center;font-size:20rpx;color:var(--mall-muted)}.commerce-body{flex:1;min-width:0;overflow-wrap:anywhere}.commerce-name{font-weight:600}.commerce-spec{color:var(--mall-muted);font-size:24rpx;margin:4rpx 0}.commerce-price-row{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}.commerce-price{color:var(--mall-brand);font-weight:600}.commerce-count{font-size:24rpx;color:var(--mall-muted)}
