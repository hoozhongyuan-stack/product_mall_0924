@import "../../styles/purchase.wxss";
.shopping-page { padding: 0 24rpx calc(150rpx + env(safe-area-inset-bottom)); }
.cart-heading { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; }
.page-title { font-size: 36rpx; font-weight: 700; }
.manage-button { margin: 0; min-height: 72rpx; padding: 0 12rpx; line-height: 72rpx; font-size: 27rpx; color: var(--mall-muted); background: transparent; }
.cart-card { background: #fff; border-radius: 12rpx; padding: 24rpx 20rpx; margin-bottom: 16rpx; }
.cart-item { display: flex; gap: 16rpx; align-items: center; }
.item-check { flex: none; width: 40rpx; }
checkbox { transform: scale(.82); transform-origin: left center; }
.thumb { width: 140rpx; height: 140rpx; border-radius: 8rpx; background: #ECEDEF; flex: none; }
.fallback { font-size: 22rpx; color: var(--mall-muted); display: flex; align-items: center; justify-content: center; }
.cart-info { flex: 1; min-width: 0; }
.name { font-size: 28rpx; font-weight: 600; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.muted, .hint { color: var(--mall-muted); font-size: 23rpx; line-height: 1.5; }
.cart-info>.muted { margin-top: 6rpx; }
.price { color: var(--mall-brand); font-weight: 700; font-size: 30rpx; white-space: nowrap; }
.cart-price-line { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; margin-top: 18rpx; }
.cart-stepper { display: flex; align-items: center; margin-left: auto; border: 1rpx solid var(--mall-border); border-radius: 6rpx; overflow: hidden; }
.cart-stepper button { margin: 0; padding: 0; width: 48rpx; height: 52rpx; line-height: 52rpx; font-size: 26rpx; border-radius: 0; background: var(--mall-canvas); }
.cart-stepper text { min-width: 50rpx; text-align: center; font-size: 24rpx; }
.change-notice { margin-top: 22rpx; padding: 16rpx; color: var(--mall-brand); background: var(--mall-brand-soft); border-radius: 8rpx; font-size: 24rpx; line-height: 1.6; }
.old-price { color: var(--mall-muted); }
.warning { color: var(--mall-danger); }
.change-actions { display: flex; justify-content: flex-end; gap: 16rpx; flex-wrap: wrap; margin-top: 20rpx; }
.change-actions button { margin: 0; padding: 0 24rpx; min-height: 72rpx; line-height: 72rpx; font-size: 24rpx; }
.remove-button { color: var(--mall-muted); background: #fff; border: 1rpx solid #D4D8DB; }
.hint { padding: 16rpx 8rpx; }
.hint button { color: var(--mall-brand); background: #fff; font-size: 25rpx; margin-top: 16rpx; }
.footer { position: fixed; z-index: 9; bottom: calc(112rpx + env(safe-area-inset-bottom)); left: 0; right: 0; display: flex; align-items: center; gap: 14rpx; padding: 18rpx 24rpx; background: #fff; border-top: 1rpx solid var(--mall-border); }
.all { display: flex; align-items: center; white-space: nowrap; font-size: 25rpx; }
.footer-summary { flex: 1; min-width: 0; text-align: right; font-size: 25rpx; }
.footer-summary .muted { font-size: 19rpx; }
.footer button { margin: 0; flex: none; padding: 0 26rpx; min-height: 84rpx; line-height: 84rpx; font-size: 26rpx; }
.state { text-align: center; padding: 150rpx 20rpx; color: var(--mall-muted); font-size: 27rpx; }
.empty-title { color: var(--mall-text); font-weight: 700; font-size: 34rpx; }
.empty-copy { margin-top: 20rpx; line-height: 1.6; }
.state button { margin-top: 32rpx; background: var(--mall-brand); color: #fff; font-size: 28rpx; }
@media (max-width:320px) { .shopping-page { padding-left: 16rpx; padding-right: 16rpx; } .cart-card { padding-left: 16rpx; padding-right: 16rpx; } .thumb { width: 112rpx; height: 128rpx; } .cart-item { gap: 12rpx; } .footer { gap: 8rpx; padding-left: 16rpx; padding-right: 16rpx; } .footer button { padding: 0 16rpx; font-size: 24rpx; } .footer .price { font-size: 27rpx; } }
