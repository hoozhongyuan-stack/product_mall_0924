.shopping-page{min-height:100vh;background:#f7f7f2;color:#243329;padding:24rpx 24rpx 150rpx;box-sizing:border-box}.page-title{font-size:38rpx;font-weight:700;margin:18rpx 0 28rpx}.state{text-align:center;padding:160rpx 24rpx;color:#607466}.state button{margin-top:24rpx;background:#24583d;color:#fff}.cart-card{display:flex;gap:16rpx;background:#fff;border-radius:16rpx;padding:20rpx;margin-bottom:16rpx}.thumb{width:128rpx;height:128rpx;border-radius:8rpx;background:#edf1e9;flex:none}.fallback{font-size:20rpx;color:#607466;display:flex;align-items:center;justify-content:center}.cart-info{flex:1;min-width:0}.name{font-size:27rpx;font-weight:600;line-height:1.4}.muted,.hint{color:#607466;font-size:22rpx;line-height:1.5}.price{color:#a03927;font-weight:700}.cart-actions{display:flex;align-items:center;gap:16rpx;margin-top:12rpx}.cart-actions button{margin:0;padding:0;width:48rpx;height:48rpx;line-height:48rpx;font-size:26rpx}.cart-actions .remove{margin-left:auto;width:auto;padding:0 10rpx;color:#b42318;background:#fff;font-size:22rpx}.warning{margin-top:10rpx;color:#b42318;font-size:22rpx}.warning button{display:inline-block;font-size:22rpx;color:#24583d}.hint{padding:16rpx}.footer{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx 24rpx env(safe-area-inset-bottom);background:#fff;box-shadow:0 -3rpx 20rpx #dce6dd}.footer button{margin:0;font-size:23rpx}.footer .all{background:#fff;color:#24583d;padding:0 10rpx}.footer .primary{background:#24583d;color:#fff;padding:0 20rpx}
.orders-entry{margin:0 0 24rpx;padding:16rpx 24rpx;min-height:80rpx;line-height:1.5;background:#fff;color:#24583d;font-size:27rpx;border:1rpx solid #b7cbb9}
