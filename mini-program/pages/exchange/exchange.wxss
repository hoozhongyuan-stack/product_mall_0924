@import "../member/member.wxss";
.entry-actions{display:flex;gap:16rpx;margin-bottom:24rpx}.entry-actions button{flex:1;margin:0;min-width:0}.exchange-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;align-items:start}.offer-card{display:block;min-width:0;margin:0;padding:0;background:#fff;color:var(--mall-text);text-align:left;overflow:hidden;border-radius:12rpx}.offer-image,.image-fallback{width:100%;height:300rpx;background:var(--mall-brand-soft);display:block}.image-fallback{display:flex;align-items:center;justify-content:center;font-size:24rpx;color:var(--mall-muted);text-align:center;padding:20rpx;box-sizing:border-box}.offer-copy{padding:20rpx}.offer-name{font-size:28rpx;font-weight:700;line-height:1.5;margin-bottom:12rpx;overflow-wrap:anywhere}.points-price{color:var(--mall-brand);font-weight:700;font-size:32rpx;line-height:1.4;font-variant-numeric:tabular-nums;margin:12rpx 0}.detail-image{width:100%;height:550rpx;border-radius:12rpx;margin-bottom:24rpx}.product-title{font-size:36rpx;margin-bottom:12rpx}.field-label{display:block;font-weight:700;margin:20rpx 0 12rpx}.quantity-input{box-sizing:border-box;background:var(--mall-canvas);color:var(--mall-text);padding:20rpx 24rpx;min-height:88rpx;border-radius:8rpx;font-size:30rpx}.address-block,.valid-copy{margin-top:24rpx}.exchange-page .row>text:first-child{flex:1}.exchange-page .row>text:last-child{flex:1}.exchange-page .row .points-price{font-size:30rpx;margin:0}
.offer-card { border-radius: 12rpx; }
.offer-image, .exchange-grid .image-fallback { height: calc((100vw - 68rpx) / 2); }
.offer-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.detail-image { height: calc(100vw - 48rpx); border-radius: 12rpx; }
.exchange-detail-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.exchange-footer { position: fixed; z-index: 9; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid var(--mall-border); }
.exchange-footer .points-price { margin: 4rpx 0 0; }
.exchange-footer button { margin: 0; min-height: 88rpx; flex: none; }
