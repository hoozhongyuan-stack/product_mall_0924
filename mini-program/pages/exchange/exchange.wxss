@import "../member/member.wxss";
.entry-actions{display:flex;gap:16rpx;margin-bottom:24rpx}.entry-actions button{flex:1;margin:0;min-width:0}.exchange-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;align-items:start}.offer-card{display:block;min-width:0;margin:0;padding:0;background:#fff;color:#243329;text-align:left;overflow:hidden;border-radius:16rpx}.offer-image,.image-fallback{width:100%;height:300rpx;background:#edf3ed;display:block}.image-fallback{display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#607466;text-align:center;padding:20rpx;box-sizing:border-box}.offer-copy{padding:20rpx}.offer-name{font-size:28rpx;font-weight:700;line-height:1.5;margin-bottom:12rpx;overflow-wrap:anywhere}.points-price{color:#24583d;font-weight:700;font-size:32rpx;line-height:1.4;font-variant-numeric:tabular-nums;margin:12rpx 0}.detail-image{width:100%;height:550rpx;border-radius:16rpx;margin-bottom:24rpx}.product-title{font-size:36rpx;margin-bottom:12rpx}.field-label{display:block;font-weight:700;margin:20rpx 0 12rpx}.quantity-input{box-sizing:border-box;background:#f4f6f1;color:#243329;padding:20rpx 24rpx;min-height:88rpx;border-radius:8rpx;font-size:30rpx}.address-block,.valid-copy{margin-top:24rpx}.exchange-page .row>text:first-child{flex:1}.exchange-page .row>text:last-child{flex:1}.exchange-page .row .points-price{font-size:30rpx;margin:0}
