<view class="member-page exchange-page">
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在加载兑换商品与会员积分…</view>
  <view wx:elif="{{state === 'auth'}}" class="state"><view>{{error}}</view><button bindtap="login">登录后兑换</button></view>
  <view wx:elif="{{state === 'submitted'}}" class="state" role="status"><view>积分兑换成功</view><view class="muted">已按成交快照扣除积分，可从兑换订单查看履约进度。</view><view wx:if="{{submitError}}" class="error">{{submitError}}</view><button bindtap="openOrders">查看兑换订单</button></view>
  <view wx:elif="{{state !== 'ready'}}" class="state" role="alert"><view>{{error}}</view><button wx:if="{{state !== 'unavailable'}}" bindtap="refresh">重新加载</button><button class="secondary" bindtap="openMall">返回积分商城</button></view>
  <block wx:else>
    <view wx:if="{{!offer}}" class="page-title">兑换结果待核对</view><view wx:if="{{!offer && error}}" class="intro">{{error}}</view>
    <block wx:if="{{offer}}"><image wx:if="{{offer.image && !failedImage}}" class="detail-image" src="{{offer.image}}" mode="aspectFill" binderror="onImageError" aria-label="{{offer.productName}}"/><view wx:else class="image-fallback detail-image">图片暂不可显示</view>
    <view class="section"><view class="page-title product-title">{{offer.productName}}</view><view class="points-price">{{offer.pointsLabel}} / {{offer.saleUnit}}</view><view class="muted">{{offer.specLabel}}</view><view class="row"><text>履约方式</text><text>{{offer.fulfillmentLabel}}</text></view><view class="muted">{{offer.deliveryCopy}}</view><view class="row"><text>当前可兑换数量</text><text>{{offer.availableQuantity}} {{offer.saleUnit}}</text></view><view class="muted">{{offer.rulesCopy}}</view></view>
    </block>
    <view wx:if="{{pending}}" class="section"><view class="section-title">兑换结果等待核对</view><view class="muted">已保留原兑换凭证。核对完成前不能创建另一笔兑换，避免重复扣除积分。</view><view class="row"><text>原兑换积分</text><text>{{pending.totalPoints}} 积分</text></view><button bindtap="retrySubmit" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '正在核对…' : '核对同一兑换结果'}}</button></view>
    <block wx:else>
      <view class="section"><view class="section-title">兑换数量与履约信息</view><label for="exchange-quantity" class="field-label">数量（1—99 {{offer.saleUnit}}）</label><input id="exchange-quantity" class="quantity-input" aria-label="兑换数量" type="number" maxlength="2" value="{{quantity}}" bindinput="onQuantity" disabled="{{submitting}}"/><view wx:if="{{offer.fulfillmentKind === 'SHIP'}}" class="address-block"><view class="field-label">收货地址</view><block wx:if="{{address}}"><view>{{address.recipientName}}　{{address.phone}}</view><view class="muted">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view></block><view wx:else class="muted">请选择收货地址，配送费用已包含在积分售价内。</view><button class="secondary" bindtap="chooseAddress" disabled="{{submitting}}">{{address ? '更改收货地址' : '选择收货地址'}}</button></view><view wx:else class="muted valid-copy">核销固定截止日 {{offer.redeemValidUntil}}。兑换后在订单详情查看凭证和剩余核销数量。</view><view wx:if="{{availablePoints !== null}}" class="row"><text>当前可用积分</text><text>{{availablePoints}} 积分</text></view><button wx:if="{{availablePoints === null}}" bindtap="login">登录后核对兑换积分</button><button wx:else class="secondary" bindtap="requestQuote" disabled="{{quoteState === 'loading' || submitting}}" loading="{{quoteState === 'loading'}}">{{quoteState === 'loading' ? '正在核对…' : '核对兑换积分'}}</button><view wx:if="{{quoteError}}" class="error" role="alert">{{quoteError}}</view></view>
      <view wx:if="{{quote}}" class="section"><view class="section-title">确认兑换</view><view class="row"><text>兑换数量</text><text>{{quote.quantity}} {{offer.saleUnit}}</text></view><view class="row"><text>可用积分</text><text>{{quote.availableLabel}}</text></view><view class="row"><text>本次兑换</text><text class="points-price">{{quote.totalLabel}}</text></view><view class="row"><text>兑换后可用积分</text><text>{{quote.remainingLabel}}</text></view><view class="muted">报价有效至 {{quote.expiryLabel}}。提交时服务端再次校验积分、库存与履约信息。</view><view wx:if="{{quoteWarning}}" class="notice" role="status">{{quoteWarning}}</view><button bindtap="submit" disabled="{{!canSubmit || submitting}}" loading="{{submitting}}">{{submitting ? '正在提交兑换…' : '确认使用 ' + quote.totalLabel + ' 兑换'}}</button></view>
    </block>
    <view wx:if="{{submitError}}" class="error" role="alert">{{submitError}}</view>
    <view class="section"><view class="section-title">取消与售后</view><view class="muted">未发货或未核销前可申请取消兑换，需平台审核通过后退还积分。履约后按商品售后规则办理。返还积分的有效期以成交快照及原积分批次为准。</view><button class="secondary" bindtap="openOrders">查看兑换订单</button></view>
  </block>
</view>
