@import "../member/member.wxss";
.coupon-head{display:flex;justify-content:space-between;align-items:center;gap:24rpx;margin-bottom:16rpx}.coupon-value{font-size:44rpx;font-weight:700;line-height:1.2;color:var(--mall-brand);font-variant-numeric:tabular-nums}.status-label{font-size:26rpx;color:var(--mall-brand)}.coupon .section-title{margin-bottom:12rpx}.valid-copy{margin-top:16rpx}.products{margin:20rpx 0}.product-link{background:transparent;color:var(--mall-brand);text-align:left;padding:16rpx 0;margin:0;min-height:88rpx;border-radius:0;line-height:1.5;text-decoration:underline}.top-link{margin:0 0 24rpx}.coupon-tabs{display:flex;gap:8rpx;margin-bottom:24rpx}.coupon-tabs .tab{min-width:0;flex:1;margin:0;padding:16rpx 4rpx;font-size:26rpx;background:var(--mall-brand-soft);color:var(--mall-brand)}.coupon-tabs .selected{background:var(--mall-brand);color:#fff}.success-copy{margin:24rpx 0;color:var(--mall-success)}.notice{margin-bottom:24rpx}.coupon{margin-top:24rpx}
.coupon { border-radius: 12rpx; overflow: hidden; border: 1rpx solid var(--mall-border); padding: 28rpx; }
.coupon-head { padding: 0 0 22rpx; margin-bottom: 22rpx; border-bottom: 1rpx dashed var(--mall-border); }
.coupon-head .muted { margin-top: 10rpx; font-size: 23rpx; }
.coupon-value { font-size: 50rpx; color: var(--mall-brand); }
.coupon .section-title { font-size: 29rpx; }
.coupon .status-label { color: var(--mall-muted); font-size: 24rpx; }
.coupon-tabs { border-bottom: 1rpx solid var(--mall-border); gap: 0; }
.coupon-tabs .tab { min-height: 88rpx; background: transparent; color: var(--mall-muted); border-radius: 0; border-bottom: 3rpx solid transparent; padding: 20rpx 4rpx; }
.coupon-tabs .selected { color: var(--mall-brand); background: transparent; border-bottom-color: var(--mall-brand); font-weight: 700; }
.coupon .product-link { min-height: 64rpx; padding: 8rpx 0; font-size: 25rpx; }
