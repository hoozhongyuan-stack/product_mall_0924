.location-page{min-height:100vh;box-sizing:border-box;padding:24rpx 24rpx calc(210rpx + env(safe-area-inset-bottom));background:var(--mall-canvas);color:var(--mall-text)}.search-panel{background:#fff;border-radius:16rpx;padding:24rpx}.search-row{display:flex;gap:16rpx;margin-bottom:20rpx}.search-row input{font-size:26rpx;min-height:88rpx;background:var(--mall-canvas);border-radius:8rpx;padding:0 16rpx;box-sizing:border-box}.city{width:180rpx;flex:none}.query{flex:1;min-width:0}.primary{background:var(--mall-brand);color:#fff;font-size:28rpx;min-height:88rpx}.primary[disabled]{background:#e6c8ca;color:#fff}.location-actions{display:flex;gap:16rpx;margin-top:20rpx}.location-actions button{flex:1;margin:0;font-size:24rpx;min-height:88rpx;background:#fff;color:var(--mall-brand);border:1rpx solid var(--mall-border)}.hint,.footer-copy{color:var(--mall-muted);font-size:24rpx;line-height:1.6}.hint{margin:24rpx 4rpx}.message{padding:20rpx;margin:20rpx 0;background:#fff2e4;color:#87450b;border-radius:10rpx;font-size:24rpx;line-height:1.6}.good{background:#eaf5ef;color:#256341}.state{text-align:center;color:var(--mall-muted);font-size:26rpx;padding:60rpx 20rpx}.poi{text-align:left;background:#fff;margin:16rpx 0;padding:24rpx;border:2rpx solid transparent;border-radius:14rpx;line-height:1.6}.poi::after{border:0}.selected{border-color:var(--mall-brand);background:#fff7f7}.poi-title{font-size:30rpx;font-weight:600}.poi-region,.poi-address{font-size:24rpx;color:var(--mall-muted);margin-top:8rpx;overflow-wrap:break-word}.footer{position:fixed;left:0;right:0;bottom:0;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid var(--mall-border)}.footer-copy{margin-bottom:12rpx}

.primary,.poi{width:100%;box-sizing:border-box}.hint,.footer-copy,.poi-region,.poi-address,.location-actions button,.message{font-size:max(24rpx,12px)}
