<view class="address-page">
 <view class="address-context">{{deliveryMode === 'DELIVERY' ? '配送到家 · ' + storeName : selecting ? '选择收货地址后返回当前订单。' : '管理常用收货地址。'}}</view>
 <view wx:if="{{state === 'loading'}}" class="state" role="status">正在核对收货地址…</view>
 <view wx:elif="{{state === 'empty'}}" class="state"><view class="state-title">还没有收货地址</view><view>新增收货地址，填写准确的送达信息。</view></view>
 <view wx:elif="{{state === 'error' || state === 'auth'}}" class="state" role="alert">{{error}}<button wx:if="{{state === 'auth'}}" bindtap="login">登录后查看</button><button wx:else bindtap="refresh">重新加载</button></view>
 <block wx:else>
  <view wx:if="{{selectionError}}" class="selection-error" role="alert">{{selectionError}}</view>
  <view wx:for="{{addresses}}" wx:key="id" class="address-card {{selecting && selectedId === item.id ? 'selected' : ''}}">
   <view class="person"><text>{{item.recipientName}}</text><text class="phone">{{item.phone}}</text><text wx:if="{{item.isDefault}}" class="default-label">默认</text></view>
   <view class="address-copy">{{item.mainAddress}}</view><view class="region-copy">{{item.regionLabel}}</view>
   <view wx:if="{{deliveryMode === 'DELIVERY'}}" class="address-eligibility {{item.canDelivery ? 'eligible' : 'ineligible'}}">{{item.eligibility.message}}</view>
   <view class="actions"><button data-id="{{item.id}}" bindtap="edit">{{deliveryMode === 'DELIVERY' && item.needsLocation ? '补全收货位置' : '编辑地址'}}</button><view class="action-links">
    <button wx:if="{{selecting && (deliveryMode !== 'DELIVERY' || item.canDelivery)}}" class="use-address" data-id="{{item.id}}" bindtap="select">{{selectedId === item.id ? '当前已选' : '使用此地址'}}</button>
    <button wx:elif="{{selecting && deliveryMode === 'DELIVERY' && item.eligibility.code === 'OUT_OF_RANGE'}}" class="use-address" data-id="{{item.id}}" bindtap="otherStores">查看其他前置仓</button>
    <button wx:elif="{{!selecting}}" class="delete-action" data-id="{{item.id}}" bindtap="remove">删除</button>
   </view></view>
  </view>
  <view wx:if="{{deliveryMode === 'DELIVERY'}}" class="address-context">默认地址也需核对配送范围。超范围地址可保留，但不能用于当前仓配送订单。</view>
 </block>
 <view wx:if="{{state !== 'auth'}}" class="footer"><button bindtap="add">新增收货地址</button></view>
</view>
