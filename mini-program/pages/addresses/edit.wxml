<view class="edit-page">
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在加载地址…</view>
  <view wx:elif="{{state === 'error'}}" class="state" role="alert">{{error}}<button bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="form-intro">{{delivery ? '先选择收货位置，再补充门牌与联系人。' : '用于快递商品配送，请填写准确的收货信息。'}}</view>
    <block wx:if="{{delivery}}">
      <view class="field"><view class="field-label">收货位置 <text class="required">*</text></view><button class="location-select" bindtap="chooseLocation" disabled="{{busy}}"><view class="location-name">{{form.poiName || '搜索并选择小区、大厦或街道'}}</view><view class="field-help">{{form.poiName ? form.province + ' · ' + form.city + ' · ' + form.district : '地区和地图位置一起确认'}}</view><view wx:if="{{form.poiName}}" class="field-help">{{form.locationAddress}}</view><view class="location-action">{{form.poiName ? '更换位置' : '选择收货位置'}}</view></button><view wx:if="{{fieldErrors.poiName}}" class="field-error" role="alert">{{fieldErrors.poiName}}</view><view wx:if="{{legacyDetail}}" class="field-help">原地址：{{legacyDetail}}。请核对并单独补充下方门牌信息。</view><view wx:if="{{eligibility}}" class="eligibility {{eligibility.code === 'ELIGIBLE' ? 'eligible' : ''}}">{{eligibility.message}}{{eligibility.code === 'OUT_OF_RANGE' ? ' 地址仍可保存，请选择其他前置仓或交付方式。' : ''}}</view></view>
      <view class="field"><label for="door-detail">楼栋／单元／门牌号 <text class="required">*</text></label><input id="door-detail" value="{{form.doorDetail}}" data-key="doorDetail" bindinput="change" maxlength="100" placeholder="例如：3栋2单元1201室" disabled="{{busy}}" aria-label="楼栋单元或门牌号，必填" /><view class="field-help">修改门牌不会清除所选位置。</view><view wx:if="{{fieldErrors.doorDetail}}" class="field-error" role="alert">{{fieldErrors.doorDetail}}</view></view>
    </block>
    <block wx:else>    <view class="field"><view class="field-label">所在地区 <text class="required">*</text></view><picker mode="region" value="{{[form.province, form.city, form.district]}}" bindchange="changeRegion" disabled="{{busy}}" aria-label="选择省份、城市和区县"><view class="region-value {{!form.province ? 'field-placeholder' : ''}}">{{form.province ? form.province + ' / ' + form.city + ' / ' + form.district : '请选择省份、城市、区县'}}<view class="chevron" aria-hidden="true"></view></view></picker><view wx:if="{{fieldErrors.province || fieldErrors.city || fieldErrors.district}}" class="field-error" role="alert">请选择完整的所在地区。</view></view>
    <view class="field"><label for="address-detail">详细地址 <text class="required">*</text></label><input id="address-detail" value="{{form.detail}}" data-key="detail" bindinput="change" maxlength="200" placeholder="街道、小区、门牌号等" placeholder-class="field-placeholder" disabled="{{busy}}" aria-label="详细地址，必填" /><view wx:if="{{fieldErrors.detail}}" class="field-error" role="alert">{{fieldErrors.detail}}</view><view class="field-help">请填写门牌号等便于送达的信息。</view></view>
    </block>
    <view class="field"><label for="recipient-name">收货人姓名 <text class="required">*</text></label><input id="recipient-name" value="{{form.recipientName}}" data-key="recipientName" bindinput="change" maxlength="40" placeholder="请输入收货人姓名" placeholder-class="field-placeholder" disabled="{{busy}}" aria-label="收货人姓名，必填" /><view wx:if="{{fieldErrors.recipientName}}" class="field-error" role="alert">{{fieldErrors.recipientName}}</view></view>
    <view class="field"><label for="recipient-phone">手机号码 <text class="required">*</text></label><input id="recipient-phone" value="{{form.phone}}" data-key="phone" bindinput="change" maxlength="20" type="number" placeholder="中国大陆手机号码" placeholder-class="field-placeholder" disabled="{{busy}}" aria-label="手机号码，必填" /><view wx:if="{{fieldErrors.phone}}" class="field-error" role="alert">{{fieldErrors.phone}}</view></view>
    <view class="field switch"><view class="field-label">设为默认地址</view><switch checked="{{form.isDefault}}" color="#A3202B" bindchange="toggleDefault" disabled="{{busy}}" aria-label="设为默认地址" /></view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view class="footer"><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">{{busy ? '正在保存…' : delivery && selecting && eligibility && eligibility.code === 'ELIGIBLE' ? '保存并使用' : '保存地址'}}</button></view>
  </block>
</view>
