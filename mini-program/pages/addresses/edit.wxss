.edit-page{min-height:100vh;background:#f7f7f2;padding:24rpx 24rpx 160rpx;box-sizing:border-box;color:#243329}.field{background:#fff;padding:22rpx 26rpx;border-bottom:1rpx solid #dce6dd;font-size:26rpx}.field text{display:block;font-weight:600;margin-bottom:8rpx}.field input{height:60rpx}.switch{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.switch text{margin:0}.error{color:#b42318;margin-top:20rpx;font-size:23rpx}.footer{position:fixed;bottom:0;left:0;right:0;padding:16rpx 24rpx env(safe-area-inset-bottom);background:#fff}.footer button,.state button{background:#24583d;color:#fff}.state{text-align:center;padding:130rpx 20rpx}
