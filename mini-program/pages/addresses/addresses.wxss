.address-page{min-height:100vh;background:#f7f7f2;padding:24rpx 24rpx 160rpx;box-sizing:border-box;color:#243329}.state{text-align:center;padding:140rpx 20rpx;color:#607466}.address-card{background:#fff;border-radius:14rpx;padding:28rpx;margin-bottom:18rpx;font-size:26rpx;line-height:1.6}.person{font-weight:700;margin-bottom:10rpx}.tag{color:#24583d;font-size:21rpx}.actions{display:flex;justify-content:flex-end;border-top:1rpx solid #dce6dd;margin-top:16rpx}.actions button{margin:10rpx 0 0 14rpx;background:#fff;color:#24583d;font-size:23rpx}.footer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:16rpx 24rpx env(safe-area-inset-bottom)}.footer button,.state button{background:#24583d;color:#fff}
