.address-page{min-height:100vh;background:var(--mall-canvas);padding:24rpx 24rpx 160rpx;box-sizing:border-box;color:var(--mall-text)}.state{text-align:center;padding:140rpx 20rpx;color:var(--mall-muted)}.address-card{background:#fff;border-radius:14rpx;padding:28rpx;margin-bottom:18rpx;font-size:26rpx;line-height:1.6}.person{font-weight:700;margin-bottom:10rpx}.tag{color:var(--mall-brand);font-size:21rpx}.actions{display:flex;justify-content:flex-end;border-top:1rpx solid var(--mall-border);margin-top:16rpx}.actions button{margin:10rpx 0 0 14rpx;background:#fff;color:var(--mall-brand);font-size:23rpx}.footer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom))}.footer button,.state button{background:var(--mall-brand);color:#fff}
.address-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.address-context { color: var(--mall-muted); font-size: 25rpx; line-height: 1.6; margin: 0 0 24rpx; }
.address-card { border: 1rpx solid transparent; }
.address-card.selected { border-color: var(--mall-brand); }
.address-choice { padding: 4rpx 0 12rpx; }
.person { display: flex; gap: 20rpx; align-items: center; font-size: 29rpx; }
.phone { color: var(--mall-muted); font-size: 26rpx; font-weight: 400; }
.selected-mark { width: 24rpx; height: 12rpx; margin-left: auto; border-bottom: 3rpx solid var(--mall-brand); border-left: 3rpx solid var(--mall-brand); transform: rotate(-45deg); }
.address-copy { line-height: 1.65; overflow-wrap: anywhere; }
.actions { align-items: center; justify-content: space-between; }
.action-links { display: flex; margin-left: auto; }
.actions button { min-height: 72rpx; line-height: 72rpx; padding: 0 14rpx; margin: 8rpx 0 0; }
.actions .default-action { padding-left: 0; color: var(--mall-muted); }
.actions .delete-action { color: var(--mall-muted); }
.tag { font-weight: 600; font-size: 24rpx; }
.state-title { font-weight: 700; color: var(--mall-text); font-size: 32rpx; margin-bottom: 20rpx; }
.footer button { font-size: 28rpx; min-height: 88rpx; }
.person{flex-wrap:wrap;gap:12rpx}.phone{font-size:13px}.default-label{margin-left:auto;font-size:12px;color:var(--mall-muted);font-weight:400}
.address-copy{font-size:30rpx;font-weight:600;margin:14rpx 0 6rpx}
.region-copy{font-size:12px;line-height:1.7;color:var(--mall-muted);overflow-wrap:anywhere}
.address-eligibility{font-size:12px;padding:8rpx 12rpx;display:inline-block;margin-top:14rpx;border-radius:6rpx}
.eligible{color:#24765b;background:#eef6f2}.ineligible{color:#a3202b;background:#fff1f0}
.selection-error{font-size:13px;color:#a3202b;line-height:1.7;margin-bottom:24rpx}
.actions button{min-height:44px;font-size:13px;line-height:1.5;padding:12rpx 14rpx}
.actions .use-address{border:1rpx solid var(--mall-border);border-radius:8rpx}
