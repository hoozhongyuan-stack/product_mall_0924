<page-meta page-style="{{stockEditor || withdrawalConfirm ? 'overflow: hidden;' : ''}}"/>
<view class="store-page center-page">
<view wx:if="{{store}}" class="warehouse-header {{section === 'home' ? 'warehouse-banner' : 'warehouse-compact'}}">
 <image class="warehouse-symbol" src="{{storeLogoUrl || '/assets/ui/parcel.svg'}}" mode="aspectFit" data-url="{{storeLogoUrl}}" binderror="onStoreLogoError" aria-label="前置仓Logo"/>
 <view class="warehouse-heading"><view class="warehouse-name">{{store.name}}</view><view class="warehouse-hours">{{store.acceptingOrders ? '正常接单' : '暂停接单'}}<text wx:if="{{store.openingHours}}"> · {{store.openingHours}}</text></view></view>
 <picker disabled="{{busy || withdrawalUncertain}}" range="{{stores}}" range-key="name" bindchange="selectStore"><view class="warehouse-switch">切换</view></picker>
</view>
<view wx:if="{{store && section !== 'home'}}" class="section-navigation">
 <button class="back-workbench" data-section="home" bindtap="section" disabled="{{busy || withdrawalUncertain}}">返回工作台</button>
 <scroll-view scroll-x class="section-tabs"><view class="tab-track">
  <button wx:if="{{canProducts}}" class="section-tab {{section === 'products' ? 'selected' : ''}}" data-section="products" bindtap="section">商品库存</button>
  <button wx:if="{{canOrders}}" class="section-tab {{section === 'orders' ? 'selected' : ''}}" data-section="orders" bindtap="section">订单</button>
  <button wx:if="{{canOrders}}" class="section-tab {{section === 'aftersales' ? 'selected' : ''}}" data-section="aftersales" bindtap="section">售后</button>
  <button class="section-tab {{section === 'account' ? 'selected' : ''}}" data-section="account" bindtap="section">账户</button>
 </view></scroll-view>
</view>
<view wx:if="{{state === 'loading'}}" class="state">正在加载当前前置仓…</view>
<view wx:elif="{{state === 'auth'}}" class="state">{{error}}<button bindtap="login">去登录</button></view>
<view wx:elif="{{state === 'empty'}}" class="state">暂无获授权前置仓，请联系平台管理员。</view>
<view wx:if="{{error && state !== 'auth'}}" class="error state" role="alert">{{error}}<button class="secondary" bindtap="refresh">重新加载核对</button></view>
<block wx:if="{{state === 'ready'}}">
<block wx:if="{{section === 'home'}}">
 <view wx:if="{{canOrders && overview}}" class="dashboard-orders">
  <view class="todo-grid"><button wx:for="{{overview.todos}}" wx:key="key" class="todo-item" data-section="orders" data-fulfillment="{{item.fulfillment}}" bindtap="section"><text class="todo-count">{{item.count === null ? '—' : item.count}}</text><text>{{item.label}}</text></button></view>
  <view class="order-summary"><button class="summary-item" data-section="orders" bindtap="section"><text>总订单</text><text class="summary-count">{{overview.totalOrders === null ? '—' : overview.totalOrders}}<text class="count-unit"> 单</text></text></button><button class="summary-item" data-section="aftersales" data-active="{{true}}" bindtap="section"><text>进行中售后</text><text class="summary-count">{{overview.activeAfterSales === null ? '—' : overview.activeAfterSales}}<text class="count-unit"> 单</text></text></button></view>
 </view>
 <view class="dashboard-account">
  <view class="module-title">前置仓账户<button class="text-action" data-section="account" bindtap="section">{{canAccounts ? '查看账户 ›' : '需授权 ›'}}</button></view>
  <block wx:if="{{!canAccounts}}"><view class="caption">可提现金额（元）</view><view class="finance-balance masked-amount">••••</view><view class="finance-permission-note">获得账户权限后，可查看余额、收入明细并申请提现。</view></block>
  <block wx:elif="{{account}}"><view class="caption">可提现金额（元）</view><view class="finance-balance-row"><text class="finance-balance">{{account.available}}</text><button class="finance-primary-small" data-section="account" data-account-panel="withdraw" bindtap="section">提现</button></view><view class="finance-metrics"><view><text>{{account.pending}}</text><text>待结算</text></view><view><text>{{account.frozen}}</text><text>提现冻结</text></view><view><text>{{account.paid}}</text><text>已线下发放</text></view></view><view wx:if="{{account.reason}}" class="caption">{{account.reason}}</view></block>
  <view wx:elif="{{accountError}}" class="error">账户暂时无法读取：{{accountError}}<button class="text-action" bindtap="refresh">重新读取</button></view>
  <view wx:else class="muted">账户暂不可读取，请重新加载核对。</view>
 </view>
 <view class="list-heading">资金管理</view>
 <view class="finance-shortcuts"><button wx:for="{{overview.financeShortcuts}}" wx:key="key" class="finance-shortcut" data-section="account" data-account-panel="{{item.accountPanel}}" bindtap="section"><image src="{{item.icon}}" mode="aspectFit"/><view><text>{{item.label}}</text><text class="caption">{{!canAccounts ? '需授权' : item.description}}</text></view><text class="shortcut-arrow" aria-hidden="true">›</text></button></view>
 <button wx:if="{{canProcurement}}" class="card procurement-entry" bindtap="openProcurement"><image src="/assets/ui/parcel.svg" mode="aspectFit"/><view><view class="title">前置仓进货</view><view class="muted">采购、付款凭证与收货</view></view><text>›</text></button>
 <view wx:if="{{overview && overview.businessShortcuts.length}}" class="shortcut-list"><button wx:for="{{overview.businessShortcuts}}" wx:key="key" class="shortcut" data-section="{{item.section}}" data-fulfillment="{{item.fulfillment}}" data-account-panel="{{item.accountPanel}}" bindtap="section"><image src="{{item.icon}}" mode="aspectFit"/><text>{{item.label}}</text><text class="shortcut-arrow" aria-hidden="true">›</text></button></view>
 <view wx:else class="state">当前账号没有商品与订单操作权限。请联系平台管理员授权需要的功能。</view>
 <view class="dashboard-note">平台统一维护商品、价格与装修。前置仓仅维护本店销售状态与库存，处理本店订单。</view>
</block>
<block wx:if="{{section === 'products'}}">
 <view class="product-toolbar"><view class="product-search"><input placeholder="搜索商品名称" value="{{keyword}}" bindinput="keyword" bindconfirm="refresh" confirm-type="search" disabled="{{busy}}"/><button bindtap="refresh" disabled="{{busy}}">查询</button></view>
 <scroll-view scroll-x class="product-filters"><view class="tab-track"><button wx:for="{{productFilters}}" wx:key="value" class="section-tab {{productFilter === item.value ? 'selected' : ''}}" data-filter="{{item.value}}" bindtap="filterProducts" disabled="{{busy}}">{{item.label}}</button></view></scroll-view></view>
 <view class="product-results">共 {{total}} 件商品</view>
 <view class="product-list"><view wx:for="{{products}}" wx:key="id" class="product-item">
  <image class="product-thumb {{item.imageUrl ? '' : 'product-placeholder'}}" src="{{item.imageUrl || '/assets/ui/parcel.svg'}}" mode="aspectFit"/>
  <view class="product-body"><view class="product-name">{{item.name}}</view>
   <view class="product-meta"><text class="product-status {{item.effectiveOnSale ? 'sale-active' : 'sale-inactive'}}">{{!item.platformOnSale ? '平台已下架' : item.onSale ? '销售中' : '本仓已下架'}}</text><text>{{item.specCount > 1 ? item.specCount + '个规格' : item.specCount === 1 ? '单规格' : '暂无规格'}}</text></view>
   <view class="product-stock-summary {{item.shortage ? 'stock-shortage' : ''}}">{{item.stockSummary}}<text wx:if="{{item.shared}}" class="shared-label"> · 共享库存</text></view>
   <view class="product-row-actions"><button class="inventory-action" data-id="{{item.id}}" bindtap="openStock" disabled="{{busy || !item.specCount}}">{{item.specCount > 1 ? '规格与库存' : '修改库存'}}</button><button class="sale-action" data-id="{{item.id}}" bindtap="toggleProduct" disabled="{{busy || (!item.onSale && !item.canPutOnSale)}}"><view class="sale-track {{item.onSale ? 'track-on' : ''}}"><view class="sale-dot"/></view><text>{{item.onSale ? '下架' : '上架'}}</text></button></view>
  </view>
 </view></view>
 <view wx:if="{{!products.length}}" class="state">没有符合条件的商品，试试其他名称或筛选条件。</view>
</block><block wx:if="{{section === 'orders'}}"><scroll-view scroll-x class="account-navigation"><view class="tab-track"><button wx:for="{{orderFilters}}" wx:key="value" class="section-tab {{orderFilter === item.value ? 'selected' : ''}}" data-section="orders" data-fulfillment="{{item.value}}" bindtap="section">{{item.label}}</button></view></scroll-view><view wx:for="{{orders}}" wx:key="orderId" class="card" data-id="{{item.orderId}}" bindtap="openOrder"><view class="title order-reference">{{item.orderNo || item.orderId}}</view><view class="row"><text>{{item.deliveryLabel}} · {{item.statusLabel}}</text><text>{{item.amount}}</text></view><view class="muted">{{orderFilter === 'WAITING_PICKUP' ? '进入订单详情，输入自提码核验' : '查看备货、交付与订单明细'}} ›</view></view><view wx:if="{{!orders.length}}" class="state">{{orderEmpty}}</view></block><block wx:if="{{section === 'aftersales'}}"><view class="list-heading">{{activeAftersales ? '进行中售后' : '全部售后'}}</view><view wx:for="{{aftersales}}" wx:key="caseId" class="card" data-id="{{item.caseId || item.id}}" bindtap="openAftersale"><view class="title">{{item.caseNo || item.caseId || item.id}}</view><view>{{item.statusLabel}} · {{item.reason}}</view><view class="muted">平台处理退款；查看所属订单 ›</view></view><view wx:if="{{!aftersales.length}}" class="state">{{activeAftersales ? '暂无进行中的售后申请。' : '本店暂无售后申请。'}}</view></block><block wx:if="{{section === 'account'}}">
 <view wx:if="{{!canAccounts}}" class="card finance-locked"><image class="finance-lock-icon" src="/assets/ui/payment.svg" mode="aspectFit"/><view class="title">账户功能需要授权</view><view class="muted">当前账号尚未获得该前置仓的账户权限。</view><view class="finance-note">请联系平台管理员：后台 → 前置仓管理 → 人员授权 → 勾选“账户”并保存。</view><view class="muted">授权后可查看余额、收入明细并申请提现。</view><button class="secondary" data-section="home" bindtap="section">返回工作台</button></view>
 <block wx:elif="{{account}}">
  <scroll-view wx:if="{{accountPanel !== 'incomeDetail' && accountPanel !== 'withdrawDetail'}}" scroll-x class="account-navigation"><view class="tab-track"><button class="section-tab {{accountPanel === 'summary' ? 'selected' : ''}}" data-panel="summary" bindtap="accountPanel">账户概览</button><button class="section-tab {{accountPanel === 'income' ? 'selected' : ''}}" data-panel="income" bindtap="accountPanel">收入明细</button><button class="section-tab {{accountPanel === 'withdraw' ? 'selected' : ''}}" data-panel="withdraw" bindtap="accountPanel">申请提现</button><button class="section-tab {{accountPanel === 'history' ? 'selected' : ''}}" data-panel="history" bindtap="accountPanel">提现记录</button></view></scroll-view>
  <button wx:else class="finance-back" bindtap="backFinance">‹ 返回{{accountPanel === 'incomeDetail' ? '收入明细' : '提现记录'}}</button>
  <block wx:if="{{accountPanel === 'summary'}}">
   <view class="card"><view class="module-title">账户余额</view><view class="caption">可提现金额（元）</view><view class="finance-balance-row"><text class="finance-balance">{{account.available}}</text><button class="finance-primary-small" data-panel="withdraw" bindtap="accountPanel">提现</button></view><view class="finance-metrics"><view><text>{{account.pending}}</text><text>待结算</text></view><view><text>{{account.frozen}}</text><text>提现冻结</text></view><view><text>{{account.paid}}</text><text>已线下发放</text></view></view><view wx:if="{{account.reason}}" class="finance-note">{{account.reason}}</view></view>
   <view class="card"><view class="module-title">账户服务</view><button class="finance-service" data-panel="income" bindtap="accountPanel"><text>收入明细</text><text class="caption">查看每笔结算 ›</text></button><button class="finance-service" data-panel="history" bindtap="accountPanel"><text>提现记录</text><text class="caption">查看审核与发放 ›</text></button></view>
   <view class="card"><view class="module-title">结算说明</view><view class="muted">订单完成且过平台配置的售后期后，可结算金额转入可提现余额。售后处理中暂缓结算。</view><view class="finance-note">可结算金额包含进货成本与前置仓利润，并扣除订单配置的运费。</view></view>
  </block>
  <block wx:if="{{accountPanel === 'income'}}">
   <scroll-view scroll-x class="finance-filters"><view class="tab-track"><button wx:for="{{incomeFilters}}" wx:key="value" class="section-tab {{incomeFilter === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="filterIncome">{{item.label}}</button></view></scroll-view>
   <view class="finance-list-caption">最近 100 条记录 · 按订单查看前置仓结算金额</view>
   <view class="finance-list"><button wx:for="{{incomeRows}}" wx:key="id" class="finance-list-item" data-id="{{item.id}}" bindtap="openIncome"><view class="finance-list-row"><text class="finance-list-amount">{{item.storeAmount}}</text><text class="finance-status finance-status-{{item.status}}">{{item.statusLabel}}</text></view><view class="finance-order-reference">订单 {{item.orderNo || item.orderId}}</view><view class="finance-list-row caption"><text wx:if="{{item.settledAtLabel}}">已结算：{{item.settledAtLabel}}</text><text wx:elif="{{item.availableAtLabel}}">预计结算：{{item.availableAtLabel}}</text><text wx:else>结算进度</text><text>查看明细 ›</text></view></button></view>
   <view wx:if="{{!incomeRows.length}}" class="state"><view class="title">{{incomeFilter ? '暂无符合条件的收入' : '暂无收入明细'}}</view><view class="muted">{{incomeFilter ? '试试其他结算状态。' : '产生已付款订单后，可在这里查看结算进度。'}}</view></view>
  </block>
  <block wx:if="{{accountPanel === 'incomeDetail' && financeDetail}}">
   <view class="card"><view class="finance-list-row"><view class="module-title">前置仓可结算金额</view><text class="finance-status finance-status-{{financeDetail.status}}">{{financeDetail.statusLabel}}</text></view><view class="finance-balance">{{financeDetail.storeAmount}}</view><view wx:if="{{financeDetail.reason}}" class="finance-note">{{financeDetail.reason}}</view><view wx:if="{{financeDetail.availableAtLabel}}" class="caption">预计可结算：{{financeDetail.availableAtLabel}}</view><view wx:if="{{financeDetail.settledAtLabel}}" class="caption">结算时间：{{financeDetail.settledAtLabel}}</view></view>
   <view class="card"><view class="module-title">金额核对</view><view class="finance-kv"><text>订单实付金额</text><text>{{financeDetail.paidAmount}}</text></view><view class="finance-kv"><text>进货成本</text><text>{{financeDetail.costAmount}}</text></view><view class="finance-kv"><text>订单利润</text><text>{{financeDetail.profitAmount}}</text></view><view class="finance-kv"><text>平台利润扣减</text><text>{{financeDetail.platformAmount}}</text></view><view class="finance-kv"><text>前置仓利润</text><text>{{financeDetail.storeProfitAmount}}</text></view><view class="finance-kv"><text>订单配置运费扣减</text><text>{{financeDetail.freightAmount}}</text></view><view class="finance-kv finance-total"><text>前置仓可结算</text><text>{{financeDetail.storeAmount}}</text></view><view class="finance-note">进货成本 + 前置仓利润 − 订单配置运费。平台分成按下单时各商品规格的规则计算。</view></view>
   <view class="card"><view class="module-title">关联订单</view><view class="finance-kv"><text>订单号</text><text>{{financeDetail.orderNo || financeDetail.orderId}}</text></view><view class="finance-kv"><text>所属前置仓</text><text>{{store.name}}</text></view><button wx:if="{{canOrders}}" class="secondary" data-id="{{financeDetail.orderId}}" bindtap="openOrder">查看订单详情</button></view>
  </block>
  <block wx:if="{{accountPanel === 'withdraw'}}">
   <view wx:if="{{!account.withdrawalReady}}" class="card"><view class="title">提现暂不可用</view><view class="muted">{{account.reason || '请联系平台管理员核对账户配置。'}}</view></view>
   <block wx:else>
    <view class="card finance-form"><view class="module-title">提现金额</view><view class="caption">可提现 {{account.available}}</view><label for="withdrawal-amount">金额（元）</label><view class="finance-money-input"><text>¥</text><input id="withdrawal-amount" type="digit" value="{{withdrawalForm.amount}}" data-key="amount" bindinput="withdrawalInput" maxlength="30" disabled="{{busy || withdrawalUncertain}}" placeholder="0.00"/><button class="text-action" bindtap="allWithdrawal" disabled="{{busy || withdrawalUncertain}}">全部提现</button></view>
     <label for="withdrawal-payeeName">收款人姓名</label><input id="withdrawal-payeeName" class="stock-input" type="text" value="{{withdrawalForm.payeeName}}" data-key="payeeName" bindinput="withdrawalInput" maxlength="80" disabled="{{busy || withdrawalUncertain}}" placeholder="填写收款人姓名"/>
     <label for="withdrawal-bankName">开户行</label><input id="withdrawal-bankName" class="stock-input" type="text" value="{{withdrawalForm.bankName}}" data-key="bankName" bindinput="withdrawalInput" maxlength="120" disabled="{{busy || withdrawalUncertain}}" placeholder="填写银行及支行"/>
     <label for="withdrawal-bankAccount">银行账号</label><input id="withdrawal-bankAccount" class="stock-input" type="number" value="{{withdrawalForm.bankAccount}}" data-key="bankAccount" bindinput="withdrawalInput" maxlength="34" disabled="{{busy || withdrawalUncertain}}" placeholder="填写银行账号"/>
    </view><view class="card"><view class="module-title">提现流程</view><view class="muted">提交申请 → 平台审核 → 平台线下发放</view><view class="finance-note">提交后申请金额将冻结。审核通过仍需等待线下发放，实际到账以银行为准。驳回后金额退回可提现余额。</view></view>
    <button wx:if="{{withdrawalUncertain}}" bindtap="sendWithdrawal" loading="{{busy}}" disabled="{{busy}}">重试原申请</button><button wx:else bindtap="prepareWithdrawal" loading="{{busy}}" disabled="{{busy || !account.balance || account.balance.availableFen <= 0}}">核对并申请提现</button>
   </block>
  </block>
  <block wx:if="{{accountPanel === 'history'}}">
   <view class="finance-list-caption">最近 100 条提现申请与发放进度</view><view class="finance-list"><button wx:for="{{account.withdrawals}}" wx:key="id" class="finance-list-item" data-id="{{item.id}}" bindtap="openWithdrawal"><view class="finance-list-row"><text class="finance-list-amount">{{item.amount}}</text><text class="finance-status finance-status-{{item.status}}">{{item.statusLabel}}</text></view><view class="finance-order-reference">{{item.bankName}} · {{item.bankAccount}}</view><view class="finance-list-row caption"><text>{{item.createdAtLabel}}</text><text>查看进度 ›</text></view></button></view><view wx:if="{{!account.withdrawals.length}}" class="state"><view class="title">暂无提现申请</view><view class="muted">申请后可在这里查看审核与发放进度。</view></view>
  </block>
  <block wx:if="{{accountPanel === 'withdrawDetail' && financeDetail}}">
   <view class="card"><view class="finance-list-row"><view class="module-title">提现申请</view><text class="finance-status finance-status-{{financeDetail.status}}">{{financeDetail.statusLabel}}</text></view><view class="finance-balance">{{financeDetail.amount}}</view><view class="muted">{{financeDetail.statusDescription}}</view></view>
   <view class="card"><view class="module-title">处理进度</view><view class="finance-step" wx:for="{{financeDetail.steps}}" wx:key="label"><view class="finance-step-dot {{item.complete ? 'complete' : ''}}"/><view><view class="finance-step-label">{{item.label}}</view><view class="caption">{{item.description}}</view></view></view><view wx:if="{{financeDetail.reason}}" class="finance-note">{{financeDetail.reason}}</view><view wx:if="{{financeDetail.paidAtLabel}}" class="caption">发放时间：{{financeDetail.paidAtLabel}}</view><view wx:if="{{financeDetail.paymentReference}}" class="finance-note">转账参考号：{{financeDetail.paymentReference}}</view></view>
   <view class="card"><view class="module-title">收款信息</view><view class="finance-kv"><text>收款人</text><text>{{financeDetail.payeeName}}</text></view><view class="finance-kv"><text>开户银行</text><text>{{financeDetail.bankName}}</text></view><view class="finance-kv"><text>银行账号</text><text>{{financeDetail.bankAccount}}</text></view><view class="finance-kv"><text>申请时间</text><text>{{financeDetail.createdAtLabel}}</text></view><view class="finance-kv"><text>申请编号</text><text>{{financeDetail.id}}</text></view></view>
   <button wx:if="{{financeDetail.status === 'REJECTED' && account.withdrawalReady}}" data-panel="withdraw" bindtap="accountPanel">重新申请提现</button>
  </block>
 </block>
</block>
<button wx:if="{{section !== 'home' && section !== 'account' && (section === 'products' ? products.length : section === 'orders' ? orders.length : aftersales.length) < total}}" class="secondary" bindtap="more">加载更多</button></block><view wx:if="{{stockEditor}}" class="stock-overlay" catchtouchmove="swallow">
 <view class="stock-backdrop" bindtap="closeStock"/>
 <view class="stock-sheet" role="dialog" aria-modal="true" aria-label="规格与库存">
  <view class="stock-sheet-header"><view><view class="stock-sheet-title">规格与库存</view><view class="stock-product-name">{{stockEditor.name}}</view></view><button class="stock-close" bindtap="closeStock" disabled="{{busy}}" aria-label="关闭库存弹窗"><image src="/assets/ui/close.svg"/></button></view>
  <scroll-view scroll-y class="stock-sheet-scroll" style="height: {{stockEditor.scrollHeight}}rpx;" enhanced show-scrollbar="{{false}}">
   <view class="stock-columns"><text>商品规格</text><text>可售库存</text></view>
   <view wx:for="{{stockEditor.pools}}" wx:key="poolId" wx:for-item="pool" class="stock-pool-row">
    <view class="stock-pool-main"><view class="stock-pool-label">{{pool.label}}</view><view class="stock-quantity"><input type="number" value="{{pool.draft}}" data-product="{{stockEditor.id}}" data-pool="{{pool.poolId}}" bindinput="stockInput" disabled="{{busy || stockConflict}}" adjust-position="{{true}}" cursor-spacing="100" aria-label="{{pool.label + '可售库存'}}"/><text>{{pool.baseUnit}}</text></view></view>
    <view class="stock-reserved">订单已占用 {{pool.reservedBaseUnits}} {{pool.baseUnit}}</view>
    <view wx:if="{{pool.shared}}" class="stock-linked"><view wx:for="{{pool.variants}}" wx:for-item="variant" wx:key="id"><text>{{variant.label}}</text><text>{{variant.availableLabel}}</text></view></view>
   </view>
   <view wx:if="{{stockEditor.pools.length > 1}}" class="stock-batch"><button class="stock-text-action" bindtap="toggleBatch" disabled="{{busy || stockConflict}}">批量填库存</button><view wx:if="{{batchOpen}}"><view class="stock-explanation">将所有独立库存填写为相同数量；保存后生效。</view><view class="stock-batch-form"><input type="number" value="{{batchValue}}" bindinput="batchInput" placeholder="输入数量" disabled="{{busy || stockConflict}}" aria-label="批量库存数量"/><button class="inventory-action" bindtap="applyBatch" disabled="{{busy || stockConflict}}">应用全部</button></view></view></view>
   <button class="stock-help-toggle" bindtap="toggleHelp">库存填写说明</button><view wx:if="{{stockHelp}}" class="stock-explanation">填写当前可售数量，订单已占用数量保留。共享库存只填写基础单位数量，关联规格自动换算。不同单位的库存分别填写，不合计。</view>
   <view wx:if="{{stockError}}" class="stock-error" role="alert">{{stockError}}<button wx:if="{{stockConflict}}" class="stock-text-action" bindtap="reloadStock" disabled="{{busy}}">重新加载核对</button></view>
  </scroll-view>
  <view class="stock-sheet-footer"><button class="stock-cancel" bindtap="closeStock" disabled="{{busy}}">取消</button><button class="stock-save" bindtap="saveStock" loading="{{busy}}" disabled="{{busy || stockConflict}}">保存库存</button></view>
 </view>
</view><view wx:if="{{withdrawalConfirm}}" class="finance-overlay" catchtouchmove="swallow"><view class="finance-backdrop"/><view class="finance-confirm" role="dialog" aria-modal="true" aria-label="确认提现申请"><view class="title">确认提现申请</view><view class="finance-balance">{{withdrawalConfirm.amount}}</view><view class="muted">{{withdrawalConfirm.payeeName}} · {{withdrawalConfirm.bankName}}</view><view class="caption">{{withdrawalConfirm.bankAccount}}</view><view class="finance-note">提交后金额冻结，平台审核通过后线下发放。请核对收款信息。</view><view class="finance-confirm-actions"><button class="secondary" bindtap="cancelWithdrawal" disabled="{{busy}}">返回修改</button><button bindtap="confirmWithdrawal" loading="{{busy}}" disabled="{{busy}}">确认申请</button></view></view></view></view>
