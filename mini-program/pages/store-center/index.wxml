<view class="store-page"><view wx:if="{{store}}" class="card"><picker disabled="{{busy || withdrawalUncertain}}" range="{{stores}}" range-key="name" bindchange="selectStore"><view class="title">{{store.name}} ⇄</view></picker><view class="caption">当前操作前置仓；不会改变顾客选店和购物车。</view><view class="tabs"><button data-section="home" bindtap="section">中心</button><button wx:if="{{canProducts}}" data-section="products" bindtap="section">商品库存</button><button wx:if="{{canOrders}}" data-section="orders" bindtap="section">订单</button><button wx:if="{{canOrders}}" data-section="aftersales" bindtap="section">售后</button><button wx:if="{{canAccounts}}" data-section="account" bindtap="section">账户</button></view></view><view wx:if="{{state === 'loading'}}" class="state">正在加载…</view><view wx:elif="{{state === 'auth'}}" class="state">{{error}}<button bindtap="login">去登录</button></view><view wx:elif="{{state === 'empty'}}" class="state">暂无获授权前置仓，请联系平台管理员。</view><view wx:if="{{error}}" class="error" role="alert">{{error}}<button bindtap="refresh">重新加载核对</button></view><block wx:if="{{state === 'ready'}}"><view wx:if="{{section === 'home'}}" class="card"><view class="title">前置仓工作台</view><view class="muted">{{store.acceptingOrders ? '当前正常接单' : '当前暂停新订单，既有订单继续履约'}}</view><view>{{store.address}}</view><view class="muted">{{store.openingHours}}</view><view class="notice">商品价格与页面装修由平台统一管理。前置仓下架仅影响本店销售。</view></view><block wx:if="{{section === 'products'}}"><view class="search"><input placeholder="搜索商品" bindinput="keyword" bindconfirm="refresh"/><button bindtap="refresh">查询</button></view><view wx:for="{{products}}" wx:key="id" class="card"><view class="title">{{item.name}}</view><view class="muted">本店{{item.onSale ? '上架' : '下架'}} · 平台 {{item.platformStatusLabel}}</view><view wx:for="{{item.pools}}" wx:for-item="pool" wx:key="poolId"><view class="row"><text>可售库存（{{pool.baseUnit}}）</text><text>已占用 {{pool.reservedBaseUnits}}</text></view><input class="stock-input" type="number" value="{{drafts[item.id][pool.poolId] === undefined ? pool.draft : drafts[item.id][pool.poolId]}}" data-product="{{item.id}}" data-pool="{{pool.poolId}}" bindinput="stockInput" disabled="{{busy}}"/><view class="caption">共享基础库存池，组合规格自动换算；填写可售量不会释放订单占用。</view></view><view class="actions"><button data-id="{{item.id}}" bindtap="saveProduct" disabled="{{busy}}">保存库存</button><button class="secondary" data-id="{{item.id}}" data-toggle="{{true}}" bindtap="saveProduct" disabled="{{busy}}">{{item.onSale ? '本店下架' : '本店上架'}}</button></view></view><view wx:if="{{!products.length}}" class="state">暂无商品。</view></block><block wx:if="{{section === 'orders'}}"><view wx:for="{{orders}}" wx:key="orderId" class="card" data-id="{{item.orderId}}" bindtap="openOrder"><view class="title">{{item.orderNo || item.orderId}}</view><view class="row"><text>{{item.deliveryLabel}} · {{item.statusLabel}}</text><text>{{item.amount}}</text></view><view class="muted">查看备货、交付与订单明细 ›</view></view><view wx:if="{{!orders.length}}" class="state">本店暂无订单。</view></block><block wx:if="{{section === 'aftersales'}}"><view wx:for="{{aftersales}}" wx:key="caseId" class="card" data-id="{{item.caseId || item.id}}" bindtap="openAftersale"><view class="title">{{item.caseNo || item.caseId || item.id}}</view><view>{{item.statusLabel}} · {{item.reason}}</view><view class="muted">平台处理退款；查看所属订单 ›</view></view><view wx:if="{{!aftersales.length}}" class="state">本店暂无售后申请。</view></block><block wx:if="{{section === 'account' && account}}">
<view class="card"><view class="title">前置仓账户</view><view wx:if="{{account.reason}}" class="notice">{{account.reason}}</view>
<view class="row"><text>可提现</text><text class="account-amount">{{account.available}}</text></view><view class="row"><text>待结算</text><text>{{account.pending}}</text></view><view class="row"><text>提现冻结</text><text>{{account.frozen}}</text></view><view class="row"><text>已线下发放</text><text>{{account.paid}}</text></view>
<view class="caption">订单完成且过售后期后结算。前置仓金额包含进货成本与前置仓利润，并扣减运费；售后处理中暂缓结算。</view></view>
<view wx:if="{{account.withdrawalReady}}" class="card"><view class="title">申请提现</view><view class="muted">提交后金额冻结；平台审核后线下发放，实际到账以银行为准。</view>
<label for="withdrawal-amount">提现金额（元）</label><input id="withdrawal-amount" class="stock-input" type="digit" value="{{withdrawalForm.amount}}" data-key="amount" bindinput="withdrawalInput" maxlength="30" disabled="{{busy || withdrawalUncertain}}" placeholder="请输入金额，最多两位小数"/>
<label for="withdrawal-payeeName">收款人姓名</label><input id="withdrawal-payeeName" class="stock-input" type="text" value="{{withdrawalForm.payeeName}}" data-key="payeeName" bindinput="withdrawalInput" maxlength="80" disabled="{{busy || withdrawalUncertain}}" placeholder="填写收款人姓名"/>
<label for="withdrawal-bankName">开户行</label><input id="withdrawal-bankName" class="stock-input" type="text" value="{{withdrawalForm.bankName}}" data-key="bankName" bindinput="withdrawalInput" maxlength="120" disabled="{{busy || withdrawalUncertain}}" placeholder="填写银行及支行"/>
<label for="withdrawal-bankAccount">银行账号</label><input id="withdrawal-bankAccount" class="stock-input" type="number" value="{{withdrawalForm.bankAccount}}" data-key="bankAccount" bindinput="withdrawalInput" maxlength="34" disabled="{{busy || withdrawalUncertain}}" placeholder="填写银行账号"/>
<button wx:if="{{withdrawalUncertain}}" bindtap="sendWithdrawal" loading="{{busy}}" disabled="{{busy}}">重试原申请</button><button wx:else bindtap="requestWithdrawal" loading="{{busy}}" disabled="{{busy || !account.balance || account.balance.availableFen <= 0}}">提交提现申请</button></view>
<view class="card"><view class="title">收入明细</view><view class="caption">最近 100 条记录</view><view wx:for="{{account.income}}" wx:key="id" class="finance-record"><view class="row"><text class="finance-reference">{{item.orderNo || item.orderId}}</text><text>{{item.statusLabel}}</text></view>
<view class="row"><text>订单实付</text><text>{{item.paidAmount}}</text></view>
<view class="row"><text>进货成本</text><text>{{item.costAmount}}</text></view>
<view class="row"><text>平台分润</text><text>{{item.platformAmount}}</text></view>
<view class="row"><text>运费扣减</text><text>{{item.freightAmount}}</text></view>
<view class="row"><text>前置仓结算</text><text>{{item.storeAmount}}</text></view>
<view wx:if="{{item.reason}}" class="muted">{{item.reason}}</view><view wx:if="{{item.availableAt}}" class="caption">预计可结算：{{item.availableAt}}</view></view><view wx:if="{{!account.income.length}}" class="muted">暂无收入记录，已付款前置仓订单会进入收入明细。</view></view>
<view class="card"><view class="title">提现记录</view><view class="caption">最近 100 条记录</view><view wx:for="{{account.withdrawals}}" wx:key="id" class="finance-record"><view class="row"><text class="account-amount">{{item.amount}}</text><text>{{item.statusLabel}}</text></view><view class="muted">{{item.payeeName}} · {{item.bankName}} · {{item.bankAccount}}</view><view class="caption">申请时间：{{item.createdAt}}</view><view wx:if="{{item.reason}}" class="muted">{{item.reason}}</view><view wx:if="{{item.paidAt}}" class="caption">发放时间：{{item.paidAt}}</view><view wx:if="{{item.paymentReference}}" class="caption">转账参考号：{{item.paymentReference}}</view></view><view wx:if="{{!account.withdrawals.length}}" class="muted">暂无提现申请。</view></view></block><button wx:if="{{section !== 'home' && section !== 'account' && (section === 'products' ? products.length : section === 'orders' ? orders.length : aftersales.length) < total}}" class="secondary" bindtap="more">加载更多</button></block></view>
