<view class="store-page"><view wx:if="{{state === 'loading'}}" class="state">正在核对售后…</view><view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{uncertain}}" bindtap="send" disabled="{{busy}}">重试确认同一记录</button><button wx:else bindtap="load">重新加载</button></view><view wx:if="{{case}}" class="card"><view class="title">{{case.caseNo || case.caseId}}</view><view class="muted">{{case.status}} · {{case.reason}}</view><view class="notice">门店提交处理建议或退货收货事实。退款审核、资金退回和库存回补由平台处理。</view><textarea class="stock-input" data-key="note" bindinput="input" value="{{note}}" placeholder="填写建议 / 验收记录（5–500字）" maxlength="500"/><button data-kind="ADVICE" bindtap="record" disabled="{{busy || uncertain}}">提交处理建议</button><block wx:if="{{case.canRecordReceipt}}"><input class="stock-input" type="number" data-key="receivedQuantity" bindinput="input" value="{{receivedQuantity}}" placeholder="实际收到退货数量"/><input class="stock-input" type="number" data-key="salableQuantity" bindinput="input" value="{{salableQuantity}}" placeholder="其中可再次销售数量"/><button class="secondary" data-kind="RECEIPT" bindtap="record" disabled="{{busy || uncertain}}">登记收货事实，交平台核实</button></block><view wx:for="{{case.storeNotes}}" wx:key="id" class="card"><view>{{item.kind === 'ADVICE' ? '处理建议' : '退货收货'}} · {{item.occurredAt}}</view><view>{{item.note}}</view><view wx:if="{{item.kind === 'RECEIPT'}}" class="muted">实收 {{item.receivedQuantity}}，可售 {{item.salableQuantity}} · 待平台核实</view></view></view></view>
