@import "../../styles/store.wxss";
.center-page{padding:0 24rpx 40rpx;background:#f4f5f5;color:#20252a;box-sizing:border-box}
.warehouse-header{display:flex;align-items:center;gap:20rpx;padding:30rpx 24rpx;margin:0 -24rpx;min-width:0}
.warehouse-banner{background:#a3202b;color:#fff;padding-top:40rpx;padding-bottom:40rpx}
.warehouse-compact{background:#fff;border-bottom:1rpx solid #e7e9eb}
.warehouse-symbol{width:76rpx;height:76rpx;padding:14rpx;background:#fff2f0;border-radius:16rpx;box-sizing:border-box;flex:none}
.warehouse-heading{flex:1;min-width:0}
.warehouse-name{font-weight:700;font-size:34rpx;line-height:1.4;overflow-wrap:anywhere}
.warehouse-hours{font-size:24rpx;line-height:1.6;margin-top:8rpx;color:#66717a}
.warehouse-banner .warehouse-hours{color:#fff0ee}
.warehouse-switch{font-size:26rpx;color:#a3202b;background:#fff;border:1rpx solid #e7e9eb;border-radius:8rpx;padding:12rpx 20rpx;white-space:nowrap}
.section-navigation{display:flex;align-items:center;gap:12rpx;margin:0 -24rpx;background:#fff;border-bottom:1rpx solid #e7e9eb;padding:8rpx 20rpx}
.back-workbench{flex:none;background:transparent;color:#66717a;padding:10rpx 4rpx;font-size:24rpx;line-height:1.6;margin:0}
.section-tabs{flex:1;width:0;white-space:nowrap}
.tab-track{display:inline-flex;gap:8rpx;align-items:center}
.section-tab{margin:0;background:transparent;color:#66717a;font-size:26rpx;padding:18rpx 16rpx;line-height:1.5;border-radius:0;white-space:nowrap}
.section-tab.selected{color:#a3202b;font-weight:700;border-bottom:4rpx solid #a3202b}
.dashboard-orders,.dashboard-account,.shortcut-list{background:#fff;border-radius:16rpx;margin:24rpx 0;overflow:hidden}
.todo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:24rpx 8rpx}
.todo-item{display:flex;flex-direction:column;align-items:center;gap:10rpx;background:transparent;color:#66717a;font-size:24rpx;padding:8rpx 0;line-height:1.5;margin:0;border-radius:0;min-width:0}
.todo-count{font-size:40rpx;font-weight:700;color:#20252a;font-variant-numeric:tabular-nums}
.order-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1rpx solid #e7e9eb;padding:20rpx}
.summary-item{display:flex;flex-direction:column;gap:8rpx;text-align:center;margin:0;background:transparent;color:#66717a;font-size:24rpx;line-height:1.5;padding:8rpx;border-radius:0}
.summary-item+.summary-item{border-left:1rpx solid #e7e9eb}
.summary-count{font-size:32rpx;font-weight:700;color:#20252a;font-variant-numeric:tabular-nums}
.count-unit{font-size:22rpx;font-weight:400;color:#66717a}
.dashboard-account{padding:24rpx}
.module-title{font-size:29rpx;font-weight:700;display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.text-action{margin:0;padding:6rpx 0;line-height:1.6;background:transparent;color:#a3202b;font-size:24rpx;font-weight:400}
.balance-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx 20rpx;padding:24rpx 0}
.balance-grid>view{display:flex;flex-direction:column;gap:8rpx;color:#66717a;font-size:24rpx;min-width:0}
.balance-value{font-size:30rpx;font-weight:700;color:#20252a;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.shortcut{display:flex;align-items:center;gap:20rpx;width:100%;box-sizing:border-box;margin:0;border-radius:0;background:#fff;color:#20252a;padding:24rpx;font-size:28rpx;line-height:1.5;text-align:left;border-bottom:1rpx solid #e7e9eb}
.shortcut:last-child{border-bottom:0}
.shortcut image{width:40rpx;height:40rpx;flex:none}
.shortcut-arrow{margin-left:auto;color:#66717a;font-size:32rpx}
.dashboard-note{font-size:24rpx;line-height:1.7;color:#66717a;margin:28rpx 4rpx}
.account-navigation{margin-top:16rpx;background:#fff;white-space:nowrap;border-radius:12rpx}
.account-amount{font-weight:700;color:#a3202b}
.finance-record{padding:24rpx 0;border-bottom:1rpx solid #e7e9eb}
.finance-record:last-child{border-bottom:0}
.finance-reference{max-width:65%;overflow-wrap:anywhere}
.finance-record .row{gap:24rpx}
.finance-record .caption,.finance-record .muted,.order-reference{overflow-wrap:anywhere}
.product-sale-state{display:inline-block;padding:8rpx 12rpx;font-size:24rpx;margin:16rpx 0 10rpx;border-radius:8rpx}
.sale-active{color:#24765b;background:#eef6f2}
.sale-inactive{color:#66717a;background:#f4f5f5}
.card .title{font-size:30rpx;line-height:1.5;overflow-wrap:anywhere}
.card{border-radius:16rpx}
.center-page .caption,.center-page .muted{color:#66717a}
.center-page .row{gap:16rpx}
button[disabled]{opacity:.55}

.list-heading{font-size:28rpx;font-weight:700;margin:28rpx 4rpx 8rpx}
.center-page button{min-height:44px}
.warehouse-switch{min-height:44px;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
/* Product management: scan products first, edit stock in a protected sheet. */
.product-toolbar{position:sticky;top:0;z-index:2;background:#f4f5f5;padding-top:20rpx}
.product-search{display:flex;align-items:center;gap:12rpx;background:#fff;border:1rpx solid #e7e9eb;border-radius:12rpx;padding:0 12rpx 0 20rpx}
.product-search input{flex:1;min-width:0;height:88rpx;font-size:14px}
.product-search button{margin:0;padding:0 12rpx;background:transparent;color:#a3202b;font-size:13px}
.product-filters{white-space:nowrap;margin-top:8rpx}
.product-filters .tab-track{gap:16rpx}
.product-filters .section-tab{padding:18rpx 10rpx;font-size:13px}
.product-results{font-size:12px;color:#66717a;padding:16rpx 4rpx}
.product-list{background:#fff;border-radius:16rpx;overflow:hidden}
.product-item{display:flex;gap:20rpx;padding:24rpx;border-bottom:1rpx solid #e7e9eb}
.product-item:last-child{border-bottom:0}
.product-thumb{width:108rpx;height:108rpx;flex:none;background:#f4f5f5;border-radius:10rpx}
.product-placeholder{padding:24rpx;box-sizing:border-box}
.product-body{flex:1;min-width:0}
.product-name{font-size:14px;font-weight:600;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.product-meta{display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;margin-top:8rpx;font-size:12px;color:#66717a}
.product-status{padding:2rpx 8rpx;border-radius:4rpx}
.product-stock-summary{font-size:12px;color:#66717a;line-height:1.5;margin-top:8rpx;overflow-wrap:anywhere}
.stock-shortage{color:#a3202b}.shared-label{color:#66717a}
.product-row-actions{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:10rpx}
.inventory-action{margin:0;padding:0 14rpx;background:#fff;color:#a3202b;border:1rpx solid #dfafb4;font-size:12px;line-height:2}
.sale-action{display:flex;gap:10rpx;align-items:center;padding:0;background:transparent;color:#66717a;font-size:12px;margin:0;white-space:nowrap}
.sale-track{width:60rpx;height:32rpx;background:#7b838b;border-radius:18rpx;padding:4rpx;box-sizing:border-box;display:flex;align-items:center}
.sale-dot{width:24rpx;height:24rpx;border-radius:50%;background:#fff}
.track-on{background:#a3202b;justify-content:flex-end}
.stock-overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end}
.stock-backdrop{position:absolute;inset:0;background:rgba(32,37,42,.42)}
.stock-sheet{position:relative;width:100%;max-height:88vh;height:auto;background:#fff;border-radius:24rpx 24rpx 0 0;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box}
.stock-sheet-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;padding:28rpx 32rpx 24rpx;border-bottom:1rpx solid #e7e9eb;flex:none}
.stock-sheet-header>view{flex:1;min-width:0}
.stock-sheet-title{font-size:16px;font-weight:600}
.stock-product-name{font-size:12px;color:#66717a;margin-top:12rpx;line-height:1.5;overflow-wrap:anywhere}
.stock-close{display:flex;align-items:center;justify-content:center;flex:none;background:transparent;margin:0;padding:0;width:88rpx}
.stock-close image{width:40rpx;height:40rpx}
.stock-sheet-scroll{flex:0 1 auto;min-height:0;width:100%}
.stock-columns{display:flex;justify-content:space-between;color:#66717a;font-size:12px;padding:24rpx 32rpx 0}
.stock-pool-row{margin:0 32rpx;padding:28rpx 0;border-bottom:1rpx solid #e7e9eb}
.stock-pool-main{display:flex;gap:20rpx;align-items:center}
.stock-pool-label{flex:1;min-width:0;font-size:13px;font-weight:600;line-height:1.6;overflow-wrap:anywhere}
.stock-quantity{display:flex;align-items:center;gap:8rpx;flex:none;width:210rpx;font-size:12px;color:#66717a}
.stock-quantity input{height:44px;width:154rpx;border:1rpx solid #b8bec5;border-radius:10rpx;text-align:right;padding:0 16rpx;box-sizing:border-box;color:#20252a;font-size:14px}
.stock-quantity text{flex:1;min-width:0;overflow-wrap:anywhere}
.stock-reserved{font-size:12px;color:#66717a;margin-top:12rpx}
.stock-linked{font-size:12px;background:#f4f5f5;padding:16rpx;border-radius:8rpx;margin-top:16rpx;color:#66717a}
.stock-linked>view{display:flex;justify-content:space-between;gap:20rpx;line-height:1.6;padding:6rpx 0}
.stock-linked text:first-child{flex:1;min-width:0;overflow-wrap:anywhere}
.stock-linked text:last-child{white-space:nowrap}
.stock-batch{padding:8rpx 32rpx}
.stock-text-action,.stock-help-toggle{font-size:12px;background:transparent;color:#a3202b;margin:0;padding:12rpx 0;text-align:left;line-height:1.6}
.stock-batch-form{display:flex;gap:16rpx;align-items:center;margin:12rpx 0}
.stock-batch-form input{flex:1;min-width:0;border:1rpx solid #b8bec5;border-radius:10rpx;padding:20rpx;font-size:13px}
.stock-help-toggle{margin:0 32rpx;color:#66717a}
.stock-explanation{font-size:12px;line-height:1.7;color:#66717a;padding-bottom:20rpx}
.stock-help-toggle+.stock-explanation{margin:0 32rpx}
.stock-error{color:#a3202b;font-size:13px;line-height:1.7;margin:16rpx 32rpx 24rpx}
.stock-sheet-footer{display:flex;gap:20rpx;padding:24rpx 32rpx;border-top:1rpx solid #e7e9eb;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));flex:none;background:#fff}
.stock-sheet-footer button{flex:1;margin:0;min-width:0;font-size:14px;line-height:1.6;padding:20rpx}
.stock-cancel{background:#f4f5f5;color:#20252a}

.warehouse-symbol{object-fit:contain;overflow:hidden;background:#fff}
/* Account balances stay discoverable while financial data remains permission protected. */
.finance-balance{font-size:52rpx;font-weight:700;line-height:1.4;color:#20252a;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;display:block;margin:12rpx 0 20rpx}
.finance-balance-row{display:flex;gap:16rpx;justify-content:space-between;align-items:center}
.finance-balance-row .finance-balance{flex:1;min-width:0}
.finance-primary-small{flex:none;margin:0;padding:12rpx 28rpx;font-size:26rpx;line-height:1.6}
.masked-amount{letter-spacing:10rpx;color:#66717a}
.finance-permission-note{color:#66717a;font-size:24rpx;line-height:1.7}
.finance-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;border-top:1rpx solid #e7e9eb;padding-top:24rpx}
.finance-metrics>view{display:flex;flex-direction:column;gap:10rpx;min-width:0;text-align:center;font-size:22rpx;color:#66717a}
.finance-metrics>view>text:first-child{font-size:26rpx;color:#20252a;font-weight:600;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
.finance-shortcuts{background:#fff;border-radius:16rpx;margin:16rpx 0 24rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden}
.finance-shortcut{display:flex;align-items:center;gap:12rpx;margin:0;padding:24rpx 20rpx;border-radius:0;border-bottom:1rpx solid #e7e9eb;color:#20252a;background:#fff;font-size:26rpx;line-height:1.5;text-align:left;min-width:0}
.finance-shortcut:nth-child(odd){border-right:1rpx solid #e7e9eb}.finance-shortcut:nth-last-child(-n+2){border-bottom:0}
.finance-shortcut image{width:36rpx;height:36rpx;flex:none}.finance-shortcut>view{display:flex;flex-direction:column;gap:8rpx;min-width:0;flex:1}.finance-shortcut .caption{font-size:21rpx}.finance-shortcut .shortcut-arrow{margin-left:0}
.finance-note{padding:20rpx;background:#fff7ed;color:#72512d;border-radius:10rpx;margin-top:20rpx;font-size:24rpx;line-height:1.7;overflow-wrap:anywhere}
.finance-locked{text-align:center;padding:40rpx 28rpx}.finance-locked .finance-note{text-align:left}.finance-lock-icon{width:68rpx;height:68rpx;margin-bottom:20rpx}
.finance-service{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:0;padding:24rpx 0;border-radius:0;color:#20252a;background:#fff;border-bottom:1rpx solid #e7e9eb;font-size:26rpx;line-height:1.6;text-align:left}.finance-service:last-child{border-bottom:0}
.finance-filters{margin-top:16rpx;white-space:nowrap}.finance-filters .section-tab{font-size:24rpx;padding:16rpx 20rpx}
.finance-list-caption{font-size:23rpx;color:#66717a;line-height:1.6;padding:20rpx 4rpx}
.finance-list{background:#fff;border-radius:16rpx;overflow:hidden}.finance-list-item{display:block;margin:0;width:100%;box-sizing:border-box;padding:28rpx 24rpx;background:#fff;color:#20252a;border-radius:0;border-bottom:1rpx solid #e7e9eb;text-align:left;font-size:26rpx;line-height:1.6}.finance-list-item:last-child{border-bottom:0}
.finance-list-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.finance-list-row>.module-title{min-width:0;flex:1}.finance-list-amount{font-size:34rpx;font-weight:700;color:#a3202b;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.finance-status{font-size:22rpx;padding:4rpx 10rpx;background:#fff2f0;color:#a3202b;border-radius:6rpx;flex:none;max-width:50%;box-sizing:border-box;line-height:1.5;white-space:normal}.finance-status-SETTLED,.finance-status-PAID{background:#eef6f2;color:#24765b}.finance-status-HELD,.finance-status-REJECTED{background:#f4f5f5;color:#66717a}
.finance-order-reference{font-size:24rpx;color:#66717a;margin:14rpx 0 12rpx;overflow-wrap:anywhere}.finance-back{background:transparent;color:#a3202b;text-align:left;padding:12rpx 0;font-size:26rpx;margin:16rpx 0 0;line-height:1.5}
.finance-kv{display:flex;justify-content:space-between;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid #e7e9eb;font-size:26rpx;line-height:1.6}.finance-kv>text:first-child{color:#66717a;flex:1;min-width:0}.finance-kv>text:last-child{max-width:62%;text-align:right;font-weight:500;overflow-wrap:anywhere}.finance-kv:last-child{border-bottom:0}.finance-total{color:#a3202b;font-weight:700}.finance-total>text:first-child{color:#20252a}
.finance-form label{display:block;font-size:26rpx;margin-top:28rpx;line-height:1.6}.finance-form .stock-input{height:88rpx;box-sizing:border-box;padding:0 20rpx;font-size:28rpx}
.finance-money-input{display:flex;align-items:center;gap:16rpx;margin-top:12rpx;padding:8rpx 0;border-bottom:1rpx solid #c8cdd2}.finance-money-input>text{font-size:42rpx}.finance-money-input input{flex:1;min-width:0;font-size:46rpx;height:90rpx}.finance-money-input .text-action{flex:none;font-size:24rpx;padding:12rpx 0}
.finance-step{display:flex;align-items:flex-start;gap:20rpx;margin-top:28rpx;min-width:0}.finance-step>view:last-child{min-width:0;flex:1}.finance-step .caption{line-height:1.7;margin-top:8rpx;overflow-wrap:anywhere}.finance-step-dot{width:18rpx;height:18rpx;border-radius:50%;background:#c8cdd2;margin-top:10rpx;flex:none}.finance-step-dot.complete{background:#24765b}.finance-step-label{font-size:26rpx;font-weight:600}
.finance-overlay{position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.finance-backdrop{position:absolute;inset:0;background:rgba(32,37,42,.42)}.finance-confirm{position:relative;width:100%;max-height:85vh;overflow-y:auto;background:#fff;border-radius:20rpx;padding:32rpx;box-sizing:border-box}.finance-confirm-actions{display:flex;gap:16rpx;margin-top:24rpx}.finance-confirm-actions button{flex:1;min-width:0;font-size:26rpx;margin:0;line-height:1.6;padding:20rpx 12rpx}
