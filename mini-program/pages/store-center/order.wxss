@import "../../styles/store.wxss";
.store-page{padding:24rpx;box-sizing:border-box;font-size:28rpx}.card{margin:0 0 24rpx;padding:28rpx;border-radius:20rpx}.heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.heading .title{min-width:0;font-size:32rpx}.status-tag{flex-shrink:0;background:#fff2f0;color:#a3202b;border-radius:8rpx;padding:8rpx 12rpx;font-size:24rpx}.order-number{overflow-wrap:anywhere;font-size:24rpx}.payment{font-size:26rpx;color:#24765b}.scan-button{min-height:96rpx;display:flex;align-items:center;justify-content:center;width:100%;font-weight:600;font-size:30rpx}.manual-button{width:100%;color:#66717a;border-color:#e7e9eb}.stock-input{width:100%;box-sizing:border-box;min-height:88rpx;font-size:28rpx}.verified{padding:24rpx;background:#edf7f2;color:#24765b;border-radius:12rpx;font-size:26rpx}.product-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid #e7e9eb}.product-row:last-child{border-bottom:0;padding-bottom:0}.product-info{min-width:0;flex:1}.product-name{font-weight:600;line-height:1.5;overflow-wrap:anywhere}.product-spec{margin:8rpx 0 0}.quantity{flex-shrink:0;font-weight:600}.handover{display:flex;align-items:flex-start;gap:12rpx;line-height:1.6;margin:24rpx 0;font-size:26rpx}.error{padding:16rpx 8rpx}.notice{font-size:26rpx;line-height:1.6}button[disabled]{background:#e7e9eb;color:#66717a}

.with-pickup-footer{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}.pickup-footer{position:fixed;left:0;right:0;bottom:0;z-index:10;background:#fff;border-top:1rpx solid #e7e9eb;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));box-sizing:border-box}.pickup-footer button{width:100%;min-height:88rpx;margin:0;display:flex;align-items:center;justify-content:center;font-size:28rpx}

.store-page{font-size:max(28rpx,14px)}.muted,.order-number,.status-tag,.product-spec{font-size:max(24rpx,12px)}.pickup-footer button{min-height:44px}

@import "../../styles/commerce.wxss";

.redemption-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:20rpx 0;color:var(--mall-muted)}
