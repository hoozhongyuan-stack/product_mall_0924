<view wx:if="{{order.dining}}" class="section"><view class="section-title">餐饮联盟配送</view><view>{{order.dining.name}} · {{order.dining.tableNumber}} 桌</view><view>{{order.dining.address}}</view></view>
<view class="store-page {{canComplete && order.deliveryMode === 'PICKUP' ? 'with-pickup-footer' : ''}}">
 <view wx:if="{{state === 'loading'}}" class="state">正在核对订单…</view>
 <view wx:if="{{error}}" class="error" role="alert">{{error}}<button wx:if="{{uncertain}}" bindtap="send" disabled="{{busy}}">{{busy ? '正在确认结果…' : '重试确认同一操作'}}</button><button wx:elif="{{!order}}" class="secondary" bindtap="load">重新加载</button></view>
 <block wx:if="{{order}}">
  <view class="card order-summary"><view class="heading"><view class="title">{{order.storeName}} · {{deliveryLabel}}</view><text class="status-tag">{{deliveryStatus}}</text></view><view class="muted order-number">订单号 {{order.orderNo || order.orderId}}</view><view class="payment">{{statusLabel}}</view><view wx:if="{{order.address}}" class="muted">{{order.address.recipientName}} {{order.address.phone}} {{order.address.detail}}</view></view>
  <view wx:if="{{order.deliveryMode === 'PICKUP'}}" class="card pickup-panel">
   <view class="title">自提核销</view><view class="muted">扫描顾客订单中的二维码，核对商品后再交付。</view>
   <block wx:if="{{canComplete && !uncertain}}">
    <button class="scan-button" bindtap="scanPickup" disabled="{{busy || verifying || scanning}}">{{scanning ? '正在扫码…' : '扫一扫自提二维码'}}</button>
    <button class="manual-button secondary" bindtap="showManual" disabled="{{busy || verifying}}">无法扫码？输入凭证</button>
    <view wx:if="{{manual}}" class="manual-entry"><input class="stock-input" placeholder="输入顾客出示的自提凭证" data-key="pickupCode" bindinput="input" maxlength="200" value="{{pickupCode}}" disabled="{{busy}}"/><button class="secondary" bindtap="verifyPickup" disabled="{{busy || verifying}}">{{verifying ? '正在核对…' : '核对凭证'}}</button></view>
    <view wx:if="{{verified}}" class="verified" role="status">凭证有效 · 已匹配当前订单</view>
   </block>
   <view wx:elif="{{delivery.status === 'COMPLETED'}}" class="verified">已完成自提，凭证已失效。<view wx:if="{{completedAtLabel}}">核销时间 {{completedAtLabel}}</view></view>
   <view wx:elif="{{!uncertain}}" class="notice">{{canPrepare ? '请先备货，完成后即可扫码核销。' : '当前订单暂不可核销，请先确认付款及售后状态。'}}</view>
  </view>
  <view class="card"><view class="title">核对商品</view><view wx:if="{{verified}}" class="muted">以下为本次可交付数量，已排除退款商品。</view><view wx:for="{{items}}" wx:key="orderLineId" class="product-row"><view class="product-info"><view class="product-name">{{item.name || item.productName}}</view><view class="muted product-spec">{{item.specLabel || item.skuName || '默认规格'}}<text wx:if="{{item.saleUnit}}"> · {{item.saleUnit}}</text></view></view><text class="quantity">× {{item.quantity}}</text></view></view>
  <view class="card">
   <view class="title">{{order.deliveryMode === 'PICKUP' ? '确认交付' : '交付操作'}}</view>
   <checkbox-group wx:if="{{canComplete && order.deliveryMode === 'PICKUP'}}" bindchange="confirmGoods"><label class="handover"><checkbox value="checked" checked="{{goodsConfirmed}}" disabled="{{!verified || busy || uncertain}}" color="#A3202B"/><text>已核对商品规格、数量，并交给顾客</text></label></checkbox-group>
   <input wx:if="{{canPrepare || canDispatch || canComplete || canShip}}" class="stock-input" placeholder="操作备注（可选）" data-key="note" bindinput="input" maxlength="500" value="{{note}}" disabled="{{busy || uncertain}}"/>
   <block wx:if="{{canShip}}"><input class="stock-input" placeholder="快递公司编码" data-key="carrierCode" bindinput="input" value="{{carrierCode}}"/><input class="stock-input" placeholder="快递运单号" data-key="trackingNo" bindinput="input" value="{{trackingNo}}"/></block>
   <button wx:if="{{canPrepare}}" data-action="PREPARE" bindtap="act" disabled="{{busy || uncertain}}">确认备货完成</button><button wx:if="{{canDispatch}}" data-action="DISPATCH" bindtap="act" disabled="{{busy || uncertain}}">开始配送</button><button wx:if="{{canComplete && order.deliveryMode !== 'PICKUP'}}" data-action="COMPLETE" bindtap="act" disabled="{{busy || uncertain}}">{{busy ? '正在提交…' : '确认已送达'}}</button><button wx:if="{{canShip}}" data-action="SHIP" bindtap="act" disabled="{{busy || uncertain}}">提交快递发货</button>
  </view>
  <view wx:if="{{canComplete && order.deliveryMode === 'PICKUP'}}" class="pickup-footer"><button data-action="COMPLETE" bindtap="act" disabled="{{busy || uncertain || !verified || !goodsConfirmed}}">{{busy ? '正在提交…' : '确认核销并完成自提'}}</button></view>
 </block>
</view>
