<view class="store-page"><view wx:if="{{state === 'loading'}}" class="state">正在核对订单…</view><view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{uncertain}}" bindtap="send" disabled="{{busy}}">重试确认同一操作</button><button wx:else bindtap="load">重新加载</button></view><block wx:if="{{order}}"><view class="card"><view class="title">{{order.storeName}} · {{deliveryLabel}}</view><view class="muted">{{order.orderNo || order.orderId}}</view><view>{{statusLabel}} · {{deliveryStatus}}</view><view wx:if="{{order.address}}" class="muted">{{order.address.recipientName}} {{order.address.phone}} {{order.address.detail}}</view><view wx:for="{{items}}" wx:key="orderLineId" class="row"><text>{{item.name || item.productName}}</text><text>× {{item.quantity}}</text></view></view><view class="card"><view class="title">交付操作</view><view class="muted">付款确认后可履约；提交不会重复扣库存。自提需核对顾客凭证。</view><input class="stock-input" placeholder="操作备注（可选）" data-key="note" bindinput="input" maxlength="500" value="{{note}}"/><input wx:if="{{canComplete && order.deliveryMode === 'PICKUP'}}" class="stock-input" placeholder="填写顾客出示的实体自提凭证" data-key="pickupCode" bindinput="input" value="{{pickupCode}}"/><block wx:if="{{canShip}}"><input class="stock-input" placeholder="快递公司编码" data-key="carrierCode" bindinput="input" value="{{carrierCode}}"/><input class="stock-input" placeholder="快递运单号" data-key="trackingNo" bindinput="input" value="{{trackingNo}}"/></block><button wx:if="{{canPrepare}}" data-action="PREPARE" bindtap="act" disabled="{{busy || uncertain}}">确认备货完成</button><button wx:if="{{canDispatch}}" data-action="DISPATCH" bindtap="act" disabled="{{busy || uncertain}}">开始配送</button><button wx:if="{{canComplete}}" data-action="COMPLETE" bindtap="act" disabled="{{busy || uncertain}}">{{order.deliveryMode === 'PICKUP' ? '核对凭证并完成自提' : '确认已送达'}}</button><button wx:if="{{canShip}}" data-action="SHIP" bindtap="act" disabled="{{busy || uncertain}}">提交快递发货</button></view></block></view>
