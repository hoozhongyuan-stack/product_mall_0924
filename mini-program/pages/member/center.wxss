@import "./member.wxss";
.member-tabs { display:flex; gap:8rpx; margin-bottom:24rpx; background:#fff; border-radius:12rpx; padding:8rpx; }
.member-tabs button { flex:1; margin:0; min-width:0; min-height:80rpx; padding:16rpx 6rpx; font-size:25rpx; background:#fff; color:var(--mall-muted); }
.member-tabs button.active { background:var(--mall-brand-soft); color:var(--mall-brand); font-weight:700; }
