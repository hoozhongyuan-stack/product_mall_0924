.member-page{min-height:100vh;box-sizing:border-box;padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));background:var(--mall-canvas);color:var(--mall-text);font-size:28rpx;line-height:1.65;overflow-wrap:anywhere}.page-title{font-size:36rpx;line-height:1.35;font-weight:700;margin-bottom:24rpx}.section{background:#fff;border-radius:12rpx;padding:24rpx;margin-bottom:24rpx}.section-title,.entry-title{font-weight:700;font-size:30rpx}.section-title{margin-bottom:16rpx}.grade-name{color:var(--mall-brand);font-size:36rpx;font-weight:700;margin-bottom:16rpx}.row{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:10rpx 0}.row>text{min-width:0}.row>text:last-child{text-align:right;flex-shrink:1}.amount{font-weight:700;color:var(--mall-brand);font-variant-numeric:tabular-nums}.muted,.intro{color:var(--mall-muted);font-size:26rpx}.intro{margin-bottom:24rpx}.rule-copy{margin-top:20rpx}.notice{padding:16rpx;margin-top:16rpx;background:#fff5e8;color:#76491e;border-radius:8rpx}.state{padding:48rpx 12rpx;text-align:center}.state button{margin-top:24rpx}button{margin:24rpx 0 0;min-height:88rpx;padding:16rpx 24rpx;font-size:28rpx;line-height:1.6;white-space:normal;color:#fff;background:var(--mall-brand);border-radius:12rpx}button::after{border:none}button.secondary{background:var(--mall-brand-soft);color:var(--mall-brand)}button[disabled]{opacity:.6}.ledger-entry{padding:20rpx 0 28rpx;border-bottom:1rpx solid var(--mall-border)}.ledger-entry:first-child{padding-top:0}.error{color:var(--mall-danger);margin-top:20rpx}.end{text-align:center;margin-top:24rpx}
.member-page { font-size: 27rpx; line-height: 1.6; }
.section { border-radius: 12rpx; padding: 28rpx; }
.member-page button[disabled] { background: var(--mall-border); color: var(--mall-muted); opacity: 1; }
.member-page button.secondary { background: #fff; color: var(--mall-brand); border: 1rpx solid #D4D8DB; }
.ledger-entry { background: #fff; padding: 24rpx; margin-bottom: 16rpx; border-radius: 10rpx; border-bottom: 0; }
.ledger-entry:first-child { padding-top: 24rpx; }
.ledger-entry .entry-title { font-size: 28rpx; }
.ledger-entry .amount { font-size: 30rpx; }
.ledger-entry .secondary { min-height: 72rpx; font-size: 24rpx; padding: 12rpx 18rpx; }
