.member-page{min-height:100vh;box-sizing:border-box;padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));background:#f7f7f2;color:#243329;font-size:28rpx;line-height:1.65;overflow-wrap:anywhere}.page-title{font-size:36rpx;line-height:1.35;font-weight:700;margin-bottom:24rpx}.section{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:24rpx}.section-title,.entry-title{font-weight:700;font-size:30rpx}.section-title{margin-bottom:16rpx}.grade-name{color:#24583d;font-size:36rpx;font-weight:700;margin-bottom:16rpx}.row{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:10rpx 0}.row>text{min-width:0}.row>text:last-child{text-align:right;flex-shrink:1}.amount{font-weight:700;color:#24583d;font-variant-numeric:tabular-nums}.muted,.intro{color:#607466;font-size:26rpx}.intro{margin-bottom:24rpx}.rule-copy{margin-top:20rpx}.notice{padding:16rpx;margin-top:16rpx;background:#fff5e8;color:#76491e;border-radius:8rpx}.state{padding:48rpx 12rpx;text-align:center}.state button{margin-top:24rpx}button{margin:24rpx 0 0;min-height:88rpx;padding:16rpx 24rpx;font-size:28rpx;line-height:1.6;white-space:normal;color:#fff;background:#24583d;border-radius:12rpx}button::after{border:none}button.secondary{background:#edf3ed;color:#24583d}button[disabled]{opacity:.6}.ledger-entry{padding:20rpx 0 28rpx;border-bottom:1rpx solid #dce6dd}.ledger-entry:first-child{padding-top:0}.error{color:#b42318;margin-top:20rpx}.end{text-align:center;margin-top:24rpx}
