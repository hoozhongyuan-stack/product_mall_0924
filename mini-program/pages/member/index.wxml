<view class="member-page profile-page commerce-page">
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在加载个人信息…</view>
  <view wx:if="{{state === 'auth'}}" class="guest-prompt"><view class="guest-title">欢迎来到我的页面</view><view class="muted">登录后查看订单、积分和专属权益。</view><button bindtap="login">登录 / 注册</button></view>
  <view wx:if="{{state === 'error'}}" class="state" role="alert"><view>{{error}}</view><button bindtap="refresh">重新加载</button></view>
  <view wx:if="{{member}}" class="profile-hero"><view class="profile-avatar"><image wx:if="{{member.avatarDisplayUrl}}" src="{{member.avatarDisplayUrl}}" mode="aspectFill" binderror="avatarError" /><image wx:else src="/assets/nav/member-selected.svg" mode="aspectFit" /></view><view class="profile-identity"><view class="grade-name">{{member.nickname || '小程序会员'}}</view><view class="muted">{{member.memberNo}}</view><view wx:if="{{!member.enabled}}" class="error">账户已停用，请联系店铺。</view></view><button class="profile-link" bindtap="editProfile">编辑资料</button></view>
  <view wx:if="{{member && editingProfile}}" class="section profile-editor"><view class="section-title">个人资料</view><button open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{profileBusy}}">{{profileBusy ? '正在保存…' : '上传 / 更换头像'}}</button><form bindsubmit="saveProfile"><label>昵称</label><input name="nickname" type="nickname" value="{{nicknameDraft}}" maxlength="40" bindinput="inputNickname" bindblur="inputNickname" disabled="{{profileBusy}}" placeholder="请输入昵称" /><view class="profile-actions"><button form-type="submit" disabled="{{profileBusy}}">保存昵称</button><button class="secondary" bindtap="cancelProfile" disabled="{{profileBusy}}">取消</button></view></form></view>
  <view wx:if="{{profileError}}" class="error" role="alert">{{profileError}}<button class="secondary" bindtap="refresh" disabled="{{profileBusy}}">重新加载资料</button></view>
    <view class="section order-entry-section"><view class="profile-section-head"><view class="section-title">我的订单</view><button class="text-link" bindtap="openOrders">全部订单</button></view>
      <view class="order-shortcuts">
        <button data-status="PENDING_PAYMENT" bindtap="openOrders" aria-label="待付款订单"><view class="shortcut-symbol"><image src="/assets/ui/payment.svg" /><text wx:if="{{member && member.orderCountsLabels.pendingPayment !== 0}}" class="count-badge">{{member.orderCountsLabels.pendingPayment}}</text></view><text>待付款</text></button>
        <button data-fulfillment="WAITING_SHIPMENT" bindtap="openOrders" aria-label="待发货订单"><view class="shortcut-symbol"><image src="/assets/ui/shipment.svg" /><text wx:if="{{member && member.orderCountsLabels.waitingShipment !== 0}}" class="count-badge">{{member.orderCountsLabels.waitingShipment}}</text></view><text>待发货</text></button>
        <button data-fulfillment="IN_TRANSIT" bindtap="openOrders" aria-label="待收货订单"><view class="shortcut-symbol"><image src="/assets/ui/parcel.svg" /><text wx:if="{{member && member.orderCountsLabels.inTransit !== 0}}" class="count-badge">{{member.orderCountsLabels.inTransit}}</text></view><text>待收货</text></button>
        <button data-fulfillment="WAITING_REDEMPTION" bindtap="openOrders" aria-label="待核销订单"><view class="shortcut-symbol"><image src="/assets/ui/voucher.svg" /><text wx:if="{{member && member.orderCountsLabels.waitingRedemption !== 0}}" class="count-badge">{{member.orderCountsLabels.waitingRedemption}}</text></view><text>待核销</text></button>
      </view>
    </view>
    <view class="section quick-entries"><button bindtap="openCoupons"><image src="/assets/ui/voucher.svg" /><text>优惠券</text></button><button bindtap="openMemberCenter"><image src="/assets/ui/points.svg" /><text>会员中心</text></button><button bindtap="openExchange"><image src="/assets/ui/exchange.svg" /><text>积分商城</text></button><button bindtap="openAddresses"><image src="/assets/ui/address.svg" /><text>收货地址</text></button></view>
    <button class="section service-entry" data-fulfillment="AFTER_SALE" bindtap="openOrders"><text>售后服务</text><text class="muted">查看申请进度<text wx:if="{{member && member.orderCountsLabels.afterSale !== 0}}"> · {{member.orderCountsLabels.afterSale}}</text></text><view class="chevron" aria-hidden="true"></view></button>
  <button wx:if="{{hasDiningCenter}}" class="section service-entry" bindtap="openDiningCenter">联盟中心 ›</button>
  <button wx:if="{{hasStoreCenter}}" class="section service-entry" bindtap="openStoreCenter">前置仓中心 ›</button>
  <button wx:if="{{member}}" class="secondary logout-entry" bindtap="logout" disabled="{{profileBusy}}">退出登录</button>
  <button class="secondary campaign-entry" bindtap="openCampaigns">领取店铺优惠券</button>
</view>
<storefront-shell show-record="{{true}}" show-navigation="{{true}}" show-service="{{true}}" />
