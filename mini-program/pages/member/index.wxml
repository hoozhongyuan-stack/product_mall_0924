<view class="member-page profile-page">
  <view class="page-title">我的</view>
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在加载会员权益…</view>
  <view wx:if="{{state === 'auth'}}" class="guest-prompt"><view class="guest-title">欢迎来到我的页面</view><view class="muted">登录后查看订单、积分和专属权益。</view><button bindtap="login">登录 / 注册</button></view>
  <view wx:if="{{state === 'error'}}" class="state" role="alert"><view>{{error}}</view><button bindtap="refresh">重新加载</button></view>
  <view wx:if="{{member}}" class="profile-hero"><view class="profile-avatar"><image src="/assets/nav/member-selected.svg" mode="aspectFit" /></view><view class="profile-identity"><view class="grade-name">{{member.grade.name}}</view><view class="muted">累计有效消费 {{member.spendLabel}}</view><view wx:if="{{!member.enabled}}" class="error">账户已停用，请联系店铺。</view></view><button class="profile-link" bindtap="openConsumption">消费与等级</button></view>
    <view class="section order-entry-section"><view class="profile-section-head"><view class="section-title">我的订单</view><button class="text-link" bindtap="openOrders">全部订单</button></view>
      <view class="order-shortcuts">
        <button data-status="PENDING_PAYMENT" bindtap="openOrders" aria-label="待付款订单"><view class="shortcut-symbol"><image src="/assets/ui/payment.svg" /><text wx:if="{{member && member.orderCountsLabels.pendingPayment !== 0}}" class="count-badge">{{member.orderCountsLabels.pendingPayment}}</text></view><text>待付款</text></button>
        <button data-fulfillment="WAITING_SHIPMENT" bindtap="openOrders" aria-label="待发货订单"><view class="shortcut-symbol"><image src="/assets/ui/shipment.svg" /><text wx:if="{{member && member.orderCountsLabels.waitingShipment !== 0}}" class="count-badge">{{member.orderCountsLabels.waitingShipment}}</text></view><text>待发货</text></button>
        <button data-fulfillment="IN_TRANSIT" bindtap="openOrders" aria-label="待收货订单"><view class="shortcut-symbol"><image src="/assets/ui/parcel.svg" /><text wx:if="{{member && member.orderCountsLabels.inTransit !== 0}}" class="count-badge">{{member.orderCountsLabels.inTransit}}</text></view><text>待收货</text></button>
        <button data-fulfillment="WAITING_REDEMPTION" bindtap="openOrders" aria-label="待核销订单"><view class="shortcut-symbol"><image src="/assets/ui/voucher.svg" /><text wx:if="{{member && member.orderCountsLabels.waitingRedemption !== 0}}" class="count-badge">{{member.orderCountsLabels.waitingRedemption}}</text></view><text>待核销</text></button>
      </view>
    </view>
    <view class="section quick-entries"><button bindtap="openCoupons"><image src="/assets/ui/voucher.svg" /><text>优惠券</text></button><button bindtap="openPoints"><image src="/assets/ui/points.svg" /><text>积分</text></button><button bindtap="openExchange"><image src="/assets/ui/exchange.svg" /><text>积分商城</text></button><button bindtap="openAddresses"><image src="/assets/ui/address.svg" /><text>收货地址</text></button></view>
    <button class="section service-entry" data-fulfillment="AFTER_SALE" bindtap="openOrders"><text>售后服务</text><text class="muted">查看申请进度<text wx:if="{{member && member.orderCountsLabels.afterSale !== 0}}"> · {{member.orderCountsLabels.afterSale}}</text></text><view class="chevron" aria-hidden="true"></view></button>
  <block wx:if="{{member}}">
    <view class="section benefits-section"><view class="section-title">会员权益</view><view class="grade-name">{{member.grade.name}}</view><view class="muted" wx:if="{{!member.enabled}}">会员账户已停用，请联系店铺处理。</view><view class="row"><text>累计有效消费</text><text class="amount">{{member.spendLabel}}</text></view><view wx:if="{{member.gradeEffectiveAt}}" class="muted">等级生效 {{member.gradeDateLabel}}</view><button class="secondary" bindtap="openConsumption">查看消费与等级变化</button></view>
    <view class="section"><view class="section-title">积分账户</view><view class="row"><text>当前可用</text><text class="amount">{{member.points.availablePoints}} 积分</text></view><view class="row"><text>账面余额</text><text>{{member.points.settledPoints}} 积分</text></view><view class="row"><text>订单冻结</text><text>{{member.points.frozenPoints}} 积分</text></view><view class="muted">冻结积分暂不可用，订单取消或关闭后释放。</view><view wx:if="{{member.points.debtPoints}}" class="notice">待补积分 {{member.points.debtPoints}}。退款扣回已使用的奖励积分可能形成负余额，后续到账积分先补足余额。</view><view wx:if="{{member.points.expiredPendingPoints}}" class="notice">已到期待扣账 {{member.points.expiredPendingPoints}} 积分，不计入当前可用。</view><view wx:if="{{member.points.expiringPoints}}" class="muted">最近到期 {{member.points.expiringPoints}} 积分，{{member.points.nextExpiryLabel}}</view><button bindtap="openPoints">查看积分明细</button></view>
    <view class="section"><view class="section-title">等级与积分规则</view><view wx:for="{{member.grades}}" wx:key="id" class="row"><text>{{item.name}}</text><text>有效消费满 {{item.minimumLabel}}</text></view><view class="rule-copy">{{member.rulesCopy}}</view><view class="muted">{{member.expiryCopy}}</view><view class="muted rule-copy">{{member.snapshotCopy}}</view><view class="muted">当前规则版本 {{member.rules.revision}}</view><view class="muted">{{member.gradeRuleCopy}}</view></view>
  </block>
  <button class="secondary campaign-entry" bindtap="openCampaigns">领取店铺优惠券</button>
</view>
<storefront-shell show-navigation="{{true}}" show-service="{{true}}" />
