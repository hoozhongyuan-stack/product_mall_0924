<view class="member-page membership-page"><view class="page-title">会员中心</view>
<view class="member-tabs"><button wx:for="{{panels}}" wx:key="key" class="{{panel === item.key ? 'active' : ''}}" data-panel="{{item.key}}" bindtap="selectPanel">{{item.label}}</button></view>
<view wx:if="{{state === 'loading'}}" class="state" role="status">正在加载会员信息…</view>
<view wx:if="{{state === 'auth'}}" class="state">请登录后查看会员权益。<button bindtap="login">登录 / 注册</button></view>
<view wx:if="{{state === 'error'}}" class="state" role="alert">{{error}}<button bindtap="refresh">重新加载</button></view>
  <block wx:if="{{member}}">
    <view wx:if="{{panel === 'rights'}}" class="section benefits-section"><view class="section-title">会员权益</view><view class="grade-name">{{member.grade.name}}</view><view class="muted" wx:if="{{!member.enabled}}">会员账户已停用，请联系店铺处理。</view><view class="row"><text>累计有效消费</text><text class="amount">{{member.spendLabel}}</text></view><view wx:if="{{member.gradeEffectiveAt}}" class="muted">等级生效 {{member.gradeDateLabel}}</view><button class="secondary" bindtap="openConsumption">查看消费与等级变化</button></view>
    <view wx:if="{{panel === 'points'}}" class="section"><view class="section-title">积分账户</view><view class="row"><text>当前可用</text><text class="amount">{{member.points.availablePoints}} 积分</text></view><view class="row"><text>账面余额</text><text>{{member.points.settledPoints}} 积分</text></view><view class="row"><text>订单冻结</text><text>{{member.points.frozenPoints}} 积分</text></view><view class="muted">冻结积分暂不可用，订单取消或关闭后释放。</view><view wx:if="{{member.points.debtPoints}}" class="notice">待补积分 {{member.points.debtPoints}}。退款扣回已使用的奖励积分可能形成负余额，后续到账积分先补足余额。</view><view wx:if="{{member.points.expiredPendingPoints}}" class="notice">已到期待扣账 {{member.points.expiredPendingPoints}} 积分，不计入当前可用。</view><view wx:if="{{member.points.expiringPoints}}" class="muted">最近到期 {{member.points.expiringPoints}} 积分，{{member.points.nextExpiryLabel}}</view><button bindtap="openPoints">查看积分明细</button></view>
    <view wx:if="{{panel === 'rules'}}" class="section"><view class="section-title">等级与积分规则</view><view wx:for="{{member.grades}}" wx:key="id" class="row"><text>{{item.name}}</text><text>有效消费满 {{item.minimumLabel}}</text></view><view class="rule-copy">{{member.rulesCopy}}</view><view class="muted">{{member.expiryCopy}}</view><view class="muted rule-copy">{{member.snapshotCopy}}</view><view class="muted">当前规则版本 {{member.rules.revision}}</view><view class="muted">{{member.gradeRuleCopy}}</view></view>
  </block>
</view>
