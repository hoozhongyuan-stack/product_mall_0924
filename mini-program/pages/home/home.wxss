.home-page { min-height: 100vh; color: var(--mall-text); }
.home-header { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; justify-content: space-between; padding: 28rpx 32rpx 32rpx; }
.brand { font-size: 35rpx; font-weight: 700; letter-spacing: .02em; }
.home-actions { display: flex; flex-wrap: wrap; gap: 18rpx; align-items: center; }
.catalog-entry { flex: none; margin: 0; padding: 0 4rpx; background: transparent; font-size: 25rpx; }
.catalog-entry::after, .state-action::after, .text-action::after, .search-button::after, .notice-open::after { border: 0; }
.home-state { padding: 140rpx 44rpx; text-align: center; color: var(--mall-muted); font-size: 27rpx; }
.state-title { color: var(--mall-text); font-size: 34rpx; font-weight: 700; }
.state-copy { margin-top: 18rpx; line-height: 1.55; }
.state-action { display: inline-block; margin: 36rpx 0 0; padding: 0 32rpx; height: 74rpx; line-height: 74rpx; border-radius: 12rpx; color: #fff; background: var(--mall-brand); font-size: 27rpx; }
.text-action { display: block; margin: 16rpx auto 0; color: var(--mall-brand); background: transparent; font-size: 25rpx; }
.home-search { display: flex; gap: 12rpx; padding: 26rpx 28rpx; }
.search-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 22rpx; border-radius: 12rpx; background: #fff; font-size: 27rpx; }
.search-button { flex: none; margin: 0; padding: 0 26rpx; height: 76rpx; line-height: 76rpx; border-radius: 12rpx; background: var(--mall-brand); color: #fff; font-size: 27rpx; }
.component-wrap { margin: 0 28rpx 28rpx; }
.hero-swiper { height: 330rpx; border-radius: 18rpx; overflow: hidden; background: var(--mall-canvas); }
.slide, .slide-image { width: 100%; height: 100%; }
.media-fallback { display: flex; align-items: center; justify-content: center; min-height: 230rpx; color: var(--mall-muted); background: var(--mall-canvas); font-size: 26rpx; }
.hotzone { position: relative; min-height: 230rpx; overflow: hidden; border-radius: 12rpx; background: var(--mall-canvas); }
.hotzone-image { width: 100%; display: block; }
.hot-area { position: absolute; }
.notice-wrap { display: flex; align-items: center; gap: 18rpx; margin: 0 28rpx 26rpx; padding: 20rpx 22rpx; border-radius: 12rpx; background: #fff; }
.notice-label { flex: none; color: var(--mall-brand); font-size: 23rpx; font-weight: 700; }
.notice-text { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.4; }
.notice-open { flex: none; margin: 0; padding: 0 8rpx; color: var(--mall-brand); background: transparent; font-size: 38rpx; }
.home-divider { height: 2rpx; margin: 32rpx 28rpx; background: var(--mall-border); }
.divider-DASHED { height: 0; border-top: 2rpx dashed var(--mall-border); background: transparent; }
.divider-SPACE { height: 34rpx; background: transparent; }
.filing { padding: 26rpx 28rpx; text-align: center; color: var(--mall-muted); font-size: 22rpx; }
.bottom-space { height: 52rpx; }
.home-header { min-height: 72rpx; padding: 24rpx 28rpx; }
.home-header .catalog-entry { min-height: 72rpx; display: flex; align-items: center; }
.home-search { padding: 24rpx 28rpx; }
.search-input { border: 1rpx solid var(--mall-border); }
.hero-swiper { border-radius: 12rpx; }
.notice-label, .notice-open { color: var(--mall-brand); }

.content-heading { padding: 24rpx; }
.heading-text { font-weight: 700; line-height: 1.45; overflow-wrap: break-word; }
.heading-subtitle { margin-top: 12rpx; color: var(--mall-muted); line-height: 1.5; font-size: 25rpx !important; }
.image-ad { overflow: hidden; }
.ad-image { display: block; width: 100%; }
.ad-frame { position: relative; }
.ratio-square { padding-top: 100%; }
.ratio-wide { padding-top: 56.25%; }
.ratio-square .ad-image, .ratio-wide .ad-image { position: absolute; top: 0; left: 0; height: 100%; }
.content-navigation { display: flex; flex-wrap: wrap; align-items: stretch; background: #fff; }
.navigation-entry { box-sizing: border-box; padding: 20rpx 12rpx; min-height: 88rpx; text-align: center; }
.columns-2 .navigation-entry { width: 50%; }
.columns-3 .navigation-entry { width: 33.3333%; }
.columns-4 .navigation-entry { width: 25%; }
.navigation-image, .navigation-fallback { width: 88rpx; height: 88rpx; margin: 0 auto 12rpx; border-radius: 12rpx; }
.navigation-fallback { display: flex; align-items: center; justify-content: center; color: var(--mall-muted); background: var(--mall-canvas); font-size: 20rpx; }
.navigation-title { font-size: 25rpx; line-height: 1.45; overflow-wrap: break-word; }
.component-empty { padding: 40rpx 24rpx; color: var(--mall-muted); font-size: 25rpx; text-align: center; }
.product-viewport { width: 100%; }
.content-products { display: flex; flex-wrap: wrap; gap: 20rpx; }
.content-product { box-sizing: border-box; overflow: hidden; border-radius: 12rpx; background: #fff; }
.layout-GRID .content-product { width: calc((100% - 20rpx) / 2); }
.product-image { display: block; width: 100%; height: 280rpx; background: var(--mall-canvas); }
.product-fallback { display: flex; align-items: center; justify-content: center; font-size: 23rpx; color: var(--mall-muted); }
.product-info { padding: 20rpx; min-width: 0; }
.product-name { font-size: 27rpx; line-height: 1.5; overflow-wrap: break-word; }
.product-price { color: var(--mall-brand); font-size: 32rpx; font-weight: 700; margin-top: 12rpx; }
.product-price-suffix { margin-left: 4rpx; font-size: 22rpx; font-weight: 400; }
.product-unavailable { margin-top: 8rpx; color: var(--mall-muted); font-size: 22rpx; }
.layout-LIST .content-product { display: flex; width: 100%; }
.layout-LIST .product-image { flex: none; width: 200rpx; height: 200rpx; }
.layout-LIST .product-info { flex: 1; }
.layout-SCROLL { flex-wrap: nowrap; }
.layout-SCROLL .content-product { width: 280rpx; flex: none; }

.mosaic-layout { display: flex; flex-wrap: wrap; align-items: stretch; }
.mosaic-slot { min-width: 0; }
.mosaic-frame { position: relative; padding-top: 100%; overflow: hidden; background: var(--mall-canvas); }
.mosaic-image, .mosaic-fallback { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.mosaic-fallback { display: flex; align-items: center; justify-content: center; color: var(--mall-muted); font-size: 23rpx; text-align: center; }
.mosaic-title { position: absolute; left: 0; right: 0; bottom: 0; padding: 12rpx; background: rgba(0,0,0,.55); color: #fff; font-size: 25rpx; line-height: 1.5; overflow-wrap: break-word; }
.mosaic-FEATURED { flex-wrap: nowrap; }
.mosaic-primary, .mosaic-stack { flex: 1; min-width: 0; }
.mosaic-primary .mosaic-frame { height: 100%; padding-top: 0; }
.mosaic-stack { display: flex; flex-direction: column; }
.mosaic-stack .mosaic-slot { width: 100%; }
.content-spacer { box-sizing: border-box; }

.coupon-layout { display: flex; flex-direction: column; gap: 20rpx; }
.coupon-card { padding: 24rpx; border: 2rpx solid var(--mall-border); border-radius: 12rpx; background: #fff; box-sizing: border-box; min-width: 0; }
.coupon-layout-SCROLL { flex-direction: row; }
.coupon-layout-SCROLL .coupon-card { width: 560rpx; flex: none; }
.coupon-amount { font-size: 38rpx; font-weight: 700; color: var(--mall-brand); }
.coupon-kind { font-size: 23rpx; font-weight: 400; margin-left: 16rpx; }
.coupon-title { margin-top: 12rpx; font-size: 29rpx; font-weight: 700; overflow-wrap: break-word; }
.coupon-copy { color: var(--mall-muted); font-size: 23rpx; line-height: 1.6; margin-top: 8rpx; overflow-wrap: break-word; }
.coupon-action { margin: 20rpx 0 0; min-height: 72rpx; padding: 0 28rpx; background: var(--mall-brand); color: #fff; font-size: 26rpx; border-radius: 12rpx; }
.coupon-recovery { padding: 24rpx; background: var(--mall-brand-soft); font-size: 25rpx; }
.coupon-message { color: var(--mall-success); font-size: 25rpx; }
.coupon-error { color: var(--mall-danger); font-size: 25rpx; }

.store-home-header{display:block;box-sizing:border-box;padding-bottom:24rpx}.store-brand-row{display:flex;align-items:center;gap:16rpx;box-sizing:border-box;min-height:92rpx}.store-logo{width:66rpx;height:66rpx;background:#fff2;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;flex:none}.store-brand-body{min-width:0;flex:1}.store-name-line{display:flex;align-items:center;gap:12rpx}.store-name-line .brand{font-size:29rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.store-switch{color:inherit;background:transparent;padding:0 8rpx;flex:none;font-size:23rpx;line-height:48rpx;margin:0}.store-switch::after{border:1rpx solid currentColor}.store-hours{font-size:23rpx;opacity:.85;margin-top:6rpx}.store-location-help{font-size:23rpx;margin-top:18rpx;}
