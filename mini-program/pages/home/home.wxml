<import src="../../components/published-content.wxml" />
<view class="home-page" style="background-color: {{theme.pageBackgroundColor}};">
  <view class="home-header" style="background-color: {{theme.headerBackgroundColor}}; color: {{theme.brandTextColor}};">
    <view class="brand">商城首页</view>
    <view class="home-actions"><button class="catalog-entry" style="color: {{theme.brandTextColor}};" bindtap="browseCatalog">商品分类 ›</button><button class="catalog-entry" style="color: {{theme.brandTextColor}};" bindtap="openCart">购物车</button><button class="catalog-entry" style="color: {{theme.brandTextColor}};" bindtap="openOrders">我的订单</button><button class="catalog-entry" style="color: {{theme.brandTextColor}};" bindtap="openMember">会员中心</button></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-state" role="status">正在加载首页…</view>
  <view wx:elif="{{state === 'unpublished'}}" class="home-state">
    <view class="state-title">首页内容准备中</view>
    <view class="state-copy">商品分类仍可浏览，欢迎先去看看。</view>
    <button class="state-action" bindtap="browseCatalog">浏览商品分类</button>
  </view>
  <view wx:elif="{{state === 'error'}}" class="home-state" role="alert">
    <view class="state-title">首页加载失败</view>
    <view class="state-copy">{{error}}</view>
    <button class="state-action" bindtap="loadHome">重新加载</button>
    <button class="text-action" bindtap="browseCatalog">浏览商品分类</button>
  </view>
  <block wx:else>
    <template is="published-content" data="{{components: components, keyword: keyword, failedAssets: failedAssets}}" />
  </block>
</view>
