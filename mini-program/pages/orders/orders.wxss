.orders-page{min-height:100vh;background:var(--mall-canvas);color:var(--mall-text);padding:24rpx 24rpx 48rpx;box-sizing:border-box;font-size:28rpx;line-height:1.6}.title,.page-title{font-size:36rpx;font-weight:700;line-height:1.35;overflow-wrap:anywhere}.page-title{margin-bottom:24rpx}.status-panel{padding:28rpx 0 32rpx}.status-label{font-size:30rpx;font-weight:700;color:var(--mall-brand)}.status-copy{margin-top:16rpx;color:var(--mall-muted)}.section{padding:24rpx;background:#fff;margin-bottom:20rpx;border-radius:12rpx;overflow-wrap:anywhere}.section-title{font-size:30rpx;font-weight:700;margin-bottom:20rpx}.row{display:flex;justify-content:space-between;gap:24rpx;padding:10rpx 0;align-items:flex-start}.row>text:last-child{min-width:0;text-align:right;overflow-wrap:anywhere}.row>text:first-child{flex:none}.muted{font-size:24rpx;color:var(--mall-muted)}.body-copy{display:block;margin-top:12rpx}.strong{font-weight:700}.price{font-size:30rpx;font-weight:700;color:var(--mall-brand)}.item,.report{padding:18rpx 0;border-top:1rpx solid var(--mall-border)}.total{border-top:1rpx solid var(--mall-border);margin-top:12rpx;padding-top:20rpx;font-weight:700}.instructions{display:block;white-space:pre-wrap;overflow-wrap:anywhere;margin:12rpx 0}.section textarea{margin:18rpx 0;width:100%;box-sizing:border-box;padding:18rpx;min-height:190rpx;border:1rpx solid var(--mall-border);border-radius:8rpx;font-size:28rpx;line-height:1.5}.orders-page button{background:var(--mall-brand);color:#fff;font-size:27rpx;min-height:80rpx;line-height:1.5;padding:20rpx 24rpx;margin-top:20rpx;white-space:normal}.orders-page button[disabled]{background:var(--mall-border);color:var(--mall-muted)}.orders-page .secondary{background:#fff;color:var(--mall-brand);border:1rpx solid var(--mall-border)}.orders-page .danger{background:#fff;color:var(--mall-danger);border:1rpx solid #d8b6b1}.state{text-align:center;padding:100rpx 16rpx;color:var(--mall-muted)}.state button{margin-top:24rpx}.actions{display:flex;flex-wrap:wrap;gap:16rpx}.actions button{flex:1;min-width:240rpx;margin:0}.notice,.action-error{padding:20rpx;margin:20rpx 0;border-radius:8rpx;overflow-wrap:anywhere}.notice{background:var(--mall-brand-soft);color:var(--mall-brand)}.action-error{background:#fff3ef;color:var(--mall-danger)}.filters{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:24rpx}.filters button{min-height:72rpx;padding:16rpx 20rpx;margin:0;background:#fff;color:var(--mall-brand);flex:1;min-width:125rpx;font-size:24rpx}.filters .active{background:var(--mall-brand);color:#fff}.end{text-align:center;padding:24rpx}.order-summary button{width:100%}@media(max-width:320px){.orders-page{padding:20rpx 16rpx}.section{padding:20rpx}.row{gap:16rpx}}
.orders-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.status-panel { margin: -24rpx -24rpx 24rpx; padding: 36rpx 28rpx; background: var(--mall-brand-soft); }
.status-panel .title { color: var(--mall-brand); }
.status-panel.is-paid { background: #EEF6F2; }
.status-panel.is-paid .title { color: var(--mall-success); }
.section { border-radius: 12rpx; padding: 28rpx; }
.section-title { font-size: 29rpx; }
.status-copy { font-size: 26rpx; line-height: 1.7; }
.orders-page .notice { color: var(--mall-text); background: var(--mall-canvas); border: 1rpx solid var(--mall-border); }
.orders-page .secondary { border-color: #D4D8DB; }
.orders-page button[disabled] { color: var(--mall-muted); background: var(--mall-border); border-color: var(--mall-border); }
.orders-page .row { font-size: 26rpx; }
.orders-page .row>text:first-child { flex-shrink: 1; }
