.orders-page{min-height:100vh;background:#f7f7f2;color:#243329;padding:24rpx 24rpx 48rpx;box-sizing:border-box;font-size:28rpx;line-height:1.6}.title,.page-title{font-size:36rpx;font-weight:700;line-height:1.35;overflow-wrap:anywhere}.page-title{margin-bottom:24rpx}.status-panel{padding:28rpx 0 32rpx}.status-label{font-size:30rpx;font-weight:700;color:#24583d}.status-copy{margin-top:16rpx;color:#607466}.section{padding:24rpx;background:#fff;margin-bottom:20rpx;border-radius:16rpx;overflow-wrap:anywhere}.section-title{font-size:30rpx;font-weight:700;margin-bottom:20rpx}.row{display:flex;justify-content:space-between;gap:24rpx;padding:10rpx 0;align-items:flex-start}.row>text:last-child{min-width:0;text-align:right;overflow-wrap:anywhere}.row>text:first-child{flex:none}.muted{font-size:24rpx;color:#607466}.body-copy{display:block;margin-top:12rpx}.strong{font-weight:700}.price{font-size:30rpx;font-weight:700;color:#a03927}.item,.report{padding:18rpx 0;border-top:1rpx solid #dce6dd}.total{border-top:1rpx solid #dce6dd;margin-top:12rpx;padding-top:20rpx;font-weight:700}.instructions{display:block;white-space:pre-wrap;overflow-wrap:anywhere;margin:12rpx 0}.section textarea{margin:18rpx 0;width:100%;box-sizing:border-box;padding:18rpx;min-height:190rpx;border:1rpx solid #aabdab;border-radius:8rpx;font-size:28rpx;line-height:1.5}.orders-page button{background:#24583d;color:#fff;font-size:27rpx;min-height:80rpx;line-height:1.5;padding:20rpx 24rpx;margin-top:20rpx;white-space:normal}.orders-page button[disabled]{background:#dce6dd;color:#526857}.orders-page .secondary{background:#fff;color:#24583d;border:1rpx solid #b7cbb9}.orders-page .danger{background:#fff;color:#b42318;border:1rpx solid #d8b6b1}.state{text-align:center;padding:100rpx 16rpx;color:#607466}.state button{margin-top:24rpx}.actions{display:flex;flex-wrap:wrap;gap:16rpx}.actions button{flex:1;min-width:240rpx;margin:0}.notice,.action-error{padding:20rpx;margin:20rpx 0;border-radius:8rpx;overflow-wrap:anywhere}.notice{background:#edf3eb;color:#24583d}.action-error{background:#fff3ef;color:#b42318}.filters{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:24rpx}.filters button{min-height:72rpx;padding:16rpx 20rpx;margin:0;background:#fff;color:#24583d;flex:1;min-width:125rpx;font-size:24rpx}.filters .active{background:#24583d;color:#fff}.end{text-align:center;padding:24rpx}.order-summary button{width:100%}@media(max-width:320px){.orders-page{padding:20rpx 16rpx}.section{padding:20rpx}.row{gap:16rpx}}
