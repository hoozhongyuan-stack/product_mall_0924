<import src="../../components/commerce-amounts.wxml" />
<view class="orders-page commerce-page">
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在核对订单状态…</view>
  <view wx:elif="{{state !== 'ready'}}" class="state" role="alert"><view>{{error}}</view><button wx:if="{{state === 'auth'}}" bindtap="login">登录后查看</button><button wx:else bindtap="refresh">重新加载</button><button class="secondary" bindtap="openOrders">我的订单</button></view>
  <block wx:else>
    <view class="status-panel {{isPaid ? 'is-paid' : ''}}"><view class="title">{{isResult ? resultTitle : statusLabel}}</view><view wx:if="{{isResult}}" class="status-label">{{statusLabel}}</view><view class="status-copy">{{statusCopy}}</view><view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="deadline">付款截止 {{expiresLabel}}</view><button wx:if="{{isResult}}" class="secondary" bindtap="refresh">查看最新订单状态</button></view>
    <view class="section"><view class="section-title">履约信息</view><view>履约方：{{fulfillmentOwnerLabel}}</view><view wx:if="{{storeDelivery.failureReason}}" class="error">配送异常：{{storeDelivery.failureReason}}</view></view>
    <view wx:if="{{order.dining}}" class="section"><view class="section-title">送至餐桌</view><view>{{order.dining.name}} · {{order.dining.tableNumber}} 桌</view><view>{{order.dining.address}}</view></view>
    <view wx:if="{{isPickup}}" class="section pickup-card">
      <view class="pickup-card-heading"><view class="section-title">{{pickupReady ? '到店出示自提二维码' : pickupStatusLabel}}</view><text class="pickup-badge">{{pickupStatusLabel}}</text></view>
      <block wx:if="{{pickupCode}}">
        <view class="muted">请向前置仓工作人员出示，由工作人员核验后交付商品。</view>
        <image wx:if="{{pickupQrPath && !pickupQrFailed}}" class="pickup-qr" src="{{pickupQrPath}}" mode="aspectFit" binderror="onPickupImageError" aria-label="到店自提二维码" />
        <view wx:elif="{{pickupQrLoading}}" class="pickup-qr-state" role="status">正在准备自提二维码…</view>
        <view wx:else class="pickup-qr-state" role="alert">二维码暂不可显示，请向工作人员出示下方完整备用凭证。</view>
        <view class="pickup-code-label">备用自提凭证</view><text selectable class="pickup-code">{{pickupCode}}</text>
        <button class="secondary pickup-copy" bindtap="copyPickup">复制完整凭证</button>
        <view class="muted pickup-help">无法扫码时，可由工作人员输入此凭证查验。</view>
      </block>
      <view wx:elif="{{pickupStatusLabel === '已完成自提'}}" class="pickup-result"><view class="strong">商品已交付，自提凭证已失效</view><view wx:if="{{pickupCompletedLabel}}" class="muted">提货时间：{{pickupCompletedLabel}}</view></view>
      <view wx:else class="pickup-result muted">{{pickupReady ? '当前暂无可用凭证，请刷新核对订单及售后状态。' : '当前不可出示自提凭证，请以订单最新状态为准。'}}</view>
    </view>
    <view wx:if="{{isPickup && order.storeId}}" class="section pickup-store"><view class="section-title">{{order.storeName}}</view><view class="muted">{{order.store.address}}</view><view wx:if="{{order.store.openingHours}}" class="muted">营业时间 {{order.store.openingHours}}</view><view class="pickup-store-actions"><button class="secondary" bindtap="navigatePickup">导航到仓</button><button class="secondary" bindtap="contactPickup">联系前置仓</button></view></view>
    <view wx:if="{{progressSteps.length}}" class="order-progress" aria-label="订单进度"><view wx:for="{{progressSteps}}" wx:key="label" class="progress-step {{item.reached ? 'reached' : ''}} {{item.current ? 'current' : ''}}"><view class="progress-dot"></view><text>{{item.label}}</text></view></view>

    <view wx:if="{{order.storeId && !isPickup}}" class="section"><view class="section-title">{{order.storeName}} · {{deliveryLabel}}</view><view class="muted">{{order.store.address}}</view><view wx:if="{{storeDelivery}}">{{statusLabel}}</view></view>
    <view wx:if="{{order.address}}" class="section"><view class="section-title">收货信息</view><view>{{order.address.recipientName}}　{{order.address.phone}}</view><view class="body-copy">{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</view></view>
    <view class="section"><view class="section-title">商品与履约</view><view wx:for="{{items}}" wx:key="orderLineId" class="item"><view class="strong">{{item.name}}</view><view class="muted">{{item.specLabel}} · {{item.saleUnit}} × {{item.quantity}}</view><view class="row"><text>{{item.fulfillmentLabel}}</text><text class="progress-status">{{item.fulfillmentStatus}}</text></view><view wx:if="{{item.fulfillmentKind === 'SHIP' && item.fulfillment.remainingPhysicalQuantity !== undefined}}" class="muted">已交付 {{item.fulfillment.deliveredQuantity || 0}} {{item.saleUnit || '件'}} · 剩余待交付 {{item.fulfillment.remainingPhysicalQuantity}} {{item.saleUnit || '件'}}<view wx:if="{{item.fulfillment.frozenQuantity}}">售后冻结 {{item.fulfillment.frozenQuantity}} {{item.saleUnit || '件'}}，其他可交付数量按履约进度继续处理。</view></view><view class="price">{{item.price}} × {{item.quantity}}</view>
      <view wx:if="{{item.redemption}}" class="redemption"><view class="row"><text>购买数量</text><text>{{item.quantity}}</text></view><view class="row"><text>已核销</text><text>{{item.redemption.redeemedQuantity}}</text></view><view class="row"><text>已作废</text><text>{{item.redemption.voidedQuantity}}</text></view><view class="row"><text>剩余可核销</text><text class="progress-status">{{item.redemption.availableQuantity}}</text></view><view wx:if="{{item.redemption.heldQuantity}}" class="row"><text>售后占用</text><text>{{item.redemption.heldQuantity}}</text></view><view class="row"><text>有效期至</text><text>{{item.redemption.validUntilLabel}}</text></view>
        <view class="muted">核销范围：{{item.redemption.scopeLabel}}</view><view wx:if="{{!item.redemption.canUse}}" class="muted">当前权益不可继续核销，请以有效期、剩余次数及售后状态为准。</view><view wx:if="{{item.redemption.canUse}}" class="voucher-block"><view class="strong">权益核销凭证</view><image wx:if="{{voucherQrPaths[item.orderLineId] && !failedVoucherImages[item.orderLineId]}}" class="voucher-qr" src="{{voucherQrPaths[item.orderLineId]}}" mode="aspectFit" data-line-id="{{item.orderLineId}}" binderror="onVoucherImageError" aria-label="核销凭证二维码" /><view wx:elif="{{voucherQrLoading[item.orderLineId]}}" class="muted" role="status">正在准备二维码…</view><view wx:else class="muted" role="alert">二维码暂不可显示，请向授权核销方出示下方凭证码。</view><view wx:if="{{item.redemption.voucherCode}}"><text selectable class="voucher-code">{{item.redemption.voucherCode}}</text><button class="secondary copy-code" data-code="{{item.redemption.voucherCode}}" bindtap="copyVoucher">复制凭证码</button></view><view wx:else class="muted">凭证生成中，请稍后刷新订单。</view></view>
        <view class="records-title">核销记录</view><view wx:if="{{!item.redemption.events.length}}" class="muted">暂无核销记录。</view><view wx:for="{{item.redemption.events}}" wx:for-item="record" wx:key="eventId" class="redeem-record"><view>{{record.actionLabel}} {{record.quantity}} 次</view><view class="muted">{{record.actorLabel}} · {{record.redeemedAtLabel}} · 当时剩余 {{record.remainingQuantity}}</view><view wx:if="{{record.reversedAt}}" class="muted">撤销时间：{{record.reversedAtLabel}}</view></view>
      </view>
    </view></view>
    <view wx:if="{{shipment}}" class="section"><view class="section-title">快递配送</view><view class="row"><text>快递公司</text><text>{{shipment.carrierName}}</text></view><view class="row"><text>运单号</text><text selectable>{{shipment.trackingNo}}</text></view><view class="row"><text>发货时间</text><text>{{shipment.shippedAtLabel}}</text></view><view wx:if="{{shipment.confirmedAt}}" class="row"><text>确认收货</text><text>{{shipment.confirmedAtLabel}}</text></view><view wx:else class="row"><text>预计自动确认</text><text>{{shipment.autoConfirmAtLabel}}</text></view><view wx:if="{{trackingMessage}}" class="muted" role="status">{{trackingMessage}}</view><view wx:for="{{trackingEvents}}" wx:for-item="event" wx:key="key" class="tracking-event"><view>{{event.description}}</view><view class="muted">{{event.time}}</view></view><button class="secondary" bindtap="loadTracking" loading="{{trackingState === 'loading'}}" disabled="{{trackingState === 'loading'}}">{{trackingState === 'loading' ? '正在查询轨迹…' : '重试查询物流轨迹'}}</button><button wx:if="{{canConfirmReceipt}}" bindtap="confirmReceipt" loading="{{confirmingReceipt}}" disabled="{{confirmingReceipt || reporting || cancelling || paying || querying}}">{{confirmingReceipt ? '正在确认…' : '确认已收货'}}</button></view>
    <view wx:if="{{isPoints}}" class="section"><view class="section-title">积分兑换结算</view><view class="row"><text>已扣兑换积分</text><text class="price">{{total}}</text></view><view class="muted">纯积分兑换；快递配送已包含在积分售价内，不收现金运费。消费累计和消费奖励积分均不计入。</view><view wx:if="{{orderBenefits}}" class="row"><text>累计退回兑换积分</text><text>{{orderBenefits.returnedPoints}} 积分</text></view></view>
    <view wx:else class="section"><view class="row total"><text>应付金额</text><text class="price">{{total}}</text></view><button class="disclosure" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}"><text>订单信息与金额明细</text><text>{{detailsOpen ? '收起' : '展开'}}</text></button><block wx:if="{{detailsOpen}}"><template is="commerce-amounts" data="{{source: order, goodsTotal: goodsTotal, shippingFee: shippingFee, couponDiscount: couponDiscount, pointsDiscount: pointsDiscount, total: total}}" /></block>    <view wx:if="{{detailsOpen}}" class="order-metadata"><view class="row"><text>订单号</text><text selectable>{{order.orderNo}}</text></view><view class="row"><text>创建时间</text><text>{{createdLabel}}</text></view><view class="row"><text>{{isPoints ? '结算方式' : '支付方式'}}</text><text>{{paymentLabel}}</text></view><view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="row"><text>付款截止时间</text><text>{{expiresLabel}}</text></view><view wx:if="{{isPaid}}" class="row"><text>{{isPoints ? '积分兑换时间' : order.payableFen === 0 ? '零现金结算时间' : '确认收款时间'}}</text><text>{{paidLabel}}</text></view><view wx:if="{{isClosed}}" class="row"><text>关闭原因</text><text>{{closeReasonLabel}}</text></view></view></view>
    <view wx:if="{{isPoints}}" class="section"><button class="disclosure" bindtap="toggleDetails"><text>订单信息</text><text>{{detailsOpen ? '收起' : '展开'}}</text></button>    <view wx:if="{{detailsOpen}}" class="order-metadata"><view class="row"><text>订单号</text><text selectable>{{order.orderNo}}</text></view><view class="row"><text>创建时间</text><text>{{createdLabel}}</text></view><view class="row"><text>{{isPoints ? '结算方式' : '支付方式'}}</text><text>{{paymentLabel}}</text></view><view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="row"><text>付款截止时间</text><text>{{expiresLabel}}</text></view><view wx:if="{{isPaid}}" class="row"><text>{{isPoints ? '积分兑换时间' : order.payableFen === 0 ? '零现金结算时间' : '确认收款时间'}}</text><text>{{paidLabel}}</text></view><view wx:if="{{isClosed}}" class="row"><text>关闭原因</text><text>{{closeReasonLabel}}</text></view></view></view>
    <view wx:if="{{showPaymentInstructions}}" class="section"><view class="section-title">本订单付款说明</view><text selectable class="instructions">{{order.paymentInstructions.instructions}}</text><view class="muted">按本订单保存的说明付款。付款后报告信息，仍需平台核实实际到账。</view></view>
    <view wx:if="{{showWechatPayment}}" class="section"><view class="section-title">微信支付</view><view class="muted">{{isClosed ? '订单已关闭，请勿继续付款。已发起支付仍可查询结果；关闭后到账需平台处理。' : isExpired ? '付款时限已到，请勿继续支付。已发起支付可查询结果。' : paymentUncertain ? '支付结果尚未确认，请先查询。不会自动重新唤起微信支付。' : canPayWechat ? '点击后唤起微信支付，金额以本订单为准。' : '当前不能发起支付，已发起支付可查询结果。'}}</view><button wx:if="{{canPayWechat && !paymentUncertain}}" bindtap="payWechat" loading="{{paying}}" disabled="{{paying || querying || cancelling}}">{{paying ? '正在获取预支付…' : '微信支付 ' + total}}</button><button class="secondary" bindtap="queryWechat" loading="{{querying}}" disabled="{{paying || querying || cancelling}}">{{querying ? '正在核实支付…' : '查询支付结果'}}</button></view>
    <view wx:if="{{reports.length}}" class="section"><view class="section-title">已提交付款报告</view><view wx:for="{{reports}}" wx:key="reportId" class="report"><view class="muted">{{item.timeLabel}}</view><text selectable class="instructions">{{item.note}}</text></view><view class="muted">这些报告由用户提交，不代表平台已收到款项。</view></view>
    <view wx:if="{{canReport || reportUncertain}}" class="section"><view class="section-title">我已付款，提交核实信息</view><label for="payment-note" class="body-copy">付款说明或流水参考（最多 500 字）</label><textarea id="payment-note" aria-label="付款说明或流水参考" value="{{note}}" maxlength="500" bindinput="onNote" disabled="{{reporting || reportUncertain}}" placeholder="填写付款时间、付款人或流水参考，方便平台核对。请勿填写密码。" /><view class="muted">仅报告已经完成的付款；报告不会自动确认收款，也不会延长付款时限。</view><button bindtap="reportPayment" loading="{{reporting}}" disabled="{{reporting || cancelling || paying || querying}}">{{reportUncertain ? '重试确认报告结果' : '提交付款报告'}}</button></view>
    <view wx:if="{{orderBenefits && !isPoints}}" class="section"><view class="section-title">订单累计权益结果</view><view class="muted">{{orderBenefits.scopeCopy}}</view><view class="muted">{{orderBenefits.statusLabel}}</view><block wx:if="{{orderBenefits.hasAmounts}}"><view class="row"><text>最终有效消费</text><text>{{orderBenefits.effectiveSpendLabel}}</text></view><view class="row"><text>当前有效消费积分</text><text>{{orderBenefits.earnedPoints}}</text></view><view class="row"><text>累计返还抵扣积分</text><text>{{orderBenefits.returnedPoints}}</text></view><view class="row"><text>累计扣回消费积分</text><text>{{orderBenefits.clawedBackPoints}}</text></view><view class="row"><text>优惠券恢复</text><text>{{orderBenefits.couponRestored ? '已按原有效期恢复' : '未恢复'}}</text></view></block></view>
    <view wx:if="{{actionError}}" class="action-error" role="alert">{{actionError}}</view><view wx:if="{{actionMessage}}" class="notice" role="status">{{actionMessage}}</view>
    <view wx:if="{{isPaid}}" class="section"><view class="section-title">售后服务</view><view class="muted">{{isPoints ? '未发货或未核销前可申请取消兑换；履约后沿商品售后规则申请。获准的数量对应积分由平台确认返还。' : '按订单项申请退款或查看已有申请，范围与金额由平台核对。'}}</view><button class="secondary" bindtap="openAftersales">{{canRequestExchangeCancel ? '申请取消兑换／查看售后' : '申请／查看售后'}}</button></view>
    <view class="actions"><button class="secondary" bindtap="refresh" disabled="{{reporting || cancelling || paying || querying || confirmingReceipt}}">刷新订单状态</button><button wx:if="{{canCancel}}" class="danger" bindtap="cancelOrder" loading="{{cancelling}}" disabled="{{reporting || cancelling || paying || querying || confirmingReceipt}}">取消订单</button><button class="secondary" bindtap="openOrders">我的订单</button></view>
  </block>
</view>
