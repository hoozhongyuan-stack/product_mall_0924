@import "orders.wxss";
.progress-status{font-weight:700;color:#24583d}.redemption{margin-top:18rpx;padding:18rpx;background:#f4f6f1;border-radius:10rpx}.redemption .row{padding:6rpx 0}.voucher-block{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #dce6dd}.voucher-code{display:block;max-width:100%;padding:16rpx 0;font-weight:700;letter-spacing:2rpx;overflow-wrap:anywhere;user-select:text}.voucher-qr{display:block;width:360rpx;height:360rpx;max-width:100%;margin:16rpx auto}.orders-page .copy-code{display:inline-block;min-height:70rpx;margin-top:4rpx;padding:12rpx 22rpx}.records-title{font-weight:700;margin-top:20rpx}.redeem-record{padding:12rpx 0;border-top:1rpx solid #dce6dd;overflow-wrap:anywhere}.redeem-record:first-of-type{margin-top:10rpx}
.tracking-event{padding:14rpx 0;border-top:1rpx solid #dce6dd;overflow-wrap:anywhere}.tracking-event:first-of-type{margin-top:14rpx}
