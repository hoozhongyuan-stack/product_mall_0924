@import "../../styles/purchase.wxss";
.checkout-page{min-height:100vh;background:var(--mall-canvas);color:var(--mall-text);padding:24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));box-sizing:border-box}.card{background:#fff;border-radius:12rpx;padding:26rpx;margin-bottom:18rpx}.address{border-left:4rpx solid var(--mall-brand);line-height:1.6}.heading{font-size:30rpx;font-weight:700;margin-bottom:16rpx}.strong{font-weight:700}.muted{color:var(--mall-muted);font-size:23rpx}.line{display:flex;gap:18rpx;padding:18rpx 0;border-top:1rpx solid var(--mall-border)}.line image{width:120rpx;height:120rpx;border-radius:8rpx;flex:none}.line-body{min-width:0;line-height:1.5}.price{color:var(--mall-brand);font-weight:700;font-size:30rpx}.row{display:flex;justify-content:space-between;padding:14rpx 0}.warning{color:var(--mall-danger);font-size:23rpx}.notice{margin:18rpx 0;padding:18rpx;background:var(--mall-canvas);color:var(--mall-muted);border-radius:10rpx;font-size:23rpx;line-height:1.5}.notice button{margin:10rpx 0 0;background:var(--mall-brand);color:#fff;font-size:24rpx}.footer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid var(--mall-border)}.footer button,.state button{background:var(--mall-brand);color:#fff;margin:0}.state{text-align:center;padding:160rpx 20rpx;color:var(--mall-muted)}.state button{margin:22rpx auto 0}
.media-fallback{width:120rpx;height:120rpx;flex:none;background:#ECEDEF;color:var(--mall-muted);border-radius:8rpx;display:flex;align-items:center;justify-content:center;font-size:20rpx}
.line-body{flex:1;overflow-wrap:anywhere}
.row{gap:20rpx;align-items:center;line-height:1.5}
.row>text:last-child,.row>.picker{min-width:0;text-align:right;overflow-wrap:anywhere}
.picker{color:var(--mall-brand);max-width:62%;font-size:25rpx}
.points-row{flex-wrap:wrap}
.points-control{display:flex;align-items:center;gap:10rpx;margin-left:auto}
.points-control input{width:112rpx;min-height:58rpx;box-sizing:border-box;border:1rpx solid #D4D8DB;border-radius:8rpx;padding:0 10rpx;text-align:right;font-size:25rpx}
.points-control button{margin:0;padding:0 18rpx;line-height:58rpx;font-size:23rpx;background:var(--mall-brand);color:#fff}
.field-error{color:var(--mall-danger);font-size:23rpx;padding:0 0 14rpx}
.payable-row{border-top:1rpx solid var(--mall-border);margin-top:8rpx;padding-top:22rpx}
.footer-total{min-width:0;margin-right:12rpx}
.footer button{flex:none;font-size:27rpx}
.footer button[disabled]{background:var(--mall-border);color:var(--mall-muted);opacity:1}
.warning-notice{background:var(--mall-brand-soft);color:var(--mall-brand)}
.state .secondary-button{background:#fff;color:var(--mall-brand);border:1rpx solid var(--mall-border)}
@media (max-width:320px){.checkout-page{padding-left:16rpx;padding-right:16rpx}.card{padding:20rpx}.footer{padding-left:16rpx;padding-right:16rpx}.footer button{font-size:24rpx}}
.payment-instructions{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--mall-border);line-height:1.6;overflow-wrap:anywhere}.payment-instructions>text{display:block;white-space:pre-wrap;margin:12rpx 0}

.payment-choice { display: flex; align-items: center; min-height: 88rpx; gap: 16rpx; color: var(--mall-text); }
.validity-line { margin: 8rpx 0; color: var(--mall-brand); font-size: 23rpx; overflow-wrap: anywhere; }

.footer button { min-height: 88rpx; padding: 0 30rpx; line-height: 88rpx; }
.address { background: #fff; padding-top: 28rpx; padding-bottom: 28rpx; }

.stock-detail { margin: 20rpx 0; padding: 16rpx; background: var(--mall-canvas); border-radius: 8rpx; font-size: 24rpx; }
.stock-detail .row { padding: 8rpx 0; }
.pilot-dialog { max-height: 80vh; overflow-y: auto; }
