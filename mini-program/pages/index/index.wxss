.catalog-page { min-height: 100vh; background: #f7f7f2; color: #1e3024; }
.catalog-header { padding: 36rpx 28rpx 20rpx; background: #fff; }
.catalog-title { font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.catalog-title-row { display: flex; align-items: center; justify-content: space-between; }
.cart-shortcut { margin: 0; padding: 0 12rpx; background: transparent; color: #24583d; font-size: 24rpx; }
.search-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.search-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 22rpx; border-radius: 12rpx; background: #f2f5f0; color: #1e3024; font-size: 27rpx; }
.search-submit, .search-clear { flex: none; margin: 0; padding: 0 20rpx; height: 72rpx; line-height: 72rpx; border-radius: 12rpx; font-size: 27rpx; }
.search-submit { background: #21553a; color: #fff; }
.search-clear { background: transparent; color: #4d6654; }
.search-submit::after, .search-clear::after, .root-item::after, .leaf-item::after, .product-row::after, .state-action::after { border: 0; }
.root-strip { white-space: nowrap; background: #fff; border-bottom: 1rpx solid #e1e8dd; }
.root-items { display: inline-flex; padding: 0 14rpx; }
.root-item { flex: none; margin: 0; padding: 0 22rpx; height: 86rpx; line-height: 86rpx; background: transparent; color: #637467; font-size: 28rpx; border-radius: 0; }
.root-item.selected { color: #1d5134; font-weight: 700; border-bottom: 5rpx solid #1d5134; }
.catalog-body { display: flex; min-height: calc(100vh - 255rpx); }
.leaf-rail { flex: none; width: 174rpx; height: calc(100vh - 255rpx); background: #edf1e9; }
.leaf-item { width: 100%; margin: 0; padding: 25rpx 12rpx; background: transparent; border-radius: 0; color: #4c6151; text-align: center; font-size: 25rpx; line-height: 1.45; white-space: normal; }
.leaf-item.selected { background: #fff; color: #1d5134; font-weight: 700; }
.leaf-empty { padding: 36rpx 14rpx; color: #67786b; font-size: 24rpx; text-align: center; }
.product-pane { flex: 1; min-width: 0; padding: 16rpx 18rpx 44rpx; }
.product-pane.full-width { padding: 18rpx 28rpx 50rpx; }
.result-heading { padding: 26rpx 30rpx 12rpx; font-size: 30rpx; font-weight: 700; }
.result-heading text { margin-left: 10rpx; color: #718075; font-size: 24rpx; font-weight: 400; }
.product-row { display: flex; width: 100%; margin: 0 0 16rpx; padding: 14rpx; background: #fff; border-radius: 14rpx; text-align: left; box-shadow: 0 5rpx 22rpx rgba(21, 49, 31, .055); }
.product-image { flex: none; width: 150rpx; height: 150rpx; border-radius: 9rpx; background: #edf0e9; }
.product-info { flex: 1; min-width: 0; padding: 2rpx 0 0 14rpx; }
.product-name { font-size: 27rpx; line-height: 1.35; font-weight: 650; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-kind { margin-top: 6rpx; color: #617166; font-size: 22rpx; }
.product-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 4rpx; margin-top: 13rpx; }
.product-price { color: #a03927; font-size: 32rpx; font-weight: 700; }
.product-open { color: #27533a; font-size: 20rpx; white-space: nowrap; }
.product-unavailable { margin-top: 4rpx; color: #68776c; font-size: 21rpx; }
.pagination-note { padding: 28rpx; color: #6b7a6d; font-size: 23rpx; text-align: center; }
.pagination-note.error { color: #9f362b; }
.page-state, .list-state { padding: 90rpx 36rpx; text-align: center; color: #5e7063; font-size: 27rpx; }
.state-title { color: #253b2b; font-size: 30rpx; font-weight: 700; }
.state-copy { margin-top: 14rpx; line-height: 1.55; }
.state-action { display: inline-block; margin: 28rpx 0 0; padding: 0 28rpx; height: 70rpx; line-height: 70rpx; background: #23543a; color: #fff; border-radius: 12rpx; font-size: 26rpx; }
