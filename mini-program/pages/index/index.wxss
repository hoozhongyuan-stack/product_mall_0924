.catalog-page { min-height: 100vh; background: var(--mall-canvas); color: var(--mall-text); }
.catalog-header { padding: 36rpx 28rpx 20rpx; background: #fff; }
.catalog-title { font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.catalog-title-row { display: flex; align-items: center; justify-content: space-between; }
.cart-shortcut { margin: 0; padding: 0 12rpx; background: transparent; color: var(--mall-brand); font-size: 24rpx; }
.search-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.search-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 22rpx; border-radius: 12rpx; background: var(--mall-canvas); color: var(--mall-text); font-size: 27rpx; }
.search-submit, .search-clear { flex: none; margin: 0; padding: 0 20rpx; height: 72rpx; line-height: 72rpx; border-radius: 12rpx; font-size: 27rpx; }
.search-submit { background: var(--mall-brand); color: #fff; }
.search-clear { background: transparent; color: var(--mall-muted); }
.search-submit::after, .search-clear::after, .root-item::after, .leaf-item::after, .product-row::after, .state-action::after { border: 0; }
.root-strip { white-space: nowrap; background: #fff; border-bottom: 1rpx solid var(--mall-border); }
.root-items { display: inline-flex; padding: 0 14rpx; }
.root-item { flex: none; margin: 0; padding: 0 22rpx; height: 86rpx; line-height: 86rpx; background: transparent; color: var(--mall-muted); font-size: 28rpx; border-radius: 0; }
.root-item.selected { color: var(--mall-brand); font-weight: 700; border-bottom: 5rpx solid var(--mall-brand); }
.catalog-body { display: flex; min-height: calc(100vh - 255rpx); }
.leaf-rail { flex: none; width: 174rpx; height: calc(100vh - 255rpx); background: var(--mall-canvas); }
.leaf-item { width: 100%; margin: 0; padding: 25rpx 12rpx; background: transparent; border-radius: 0; color: var(--mall-muted); text-align: center; font-size: 25rpx; line-height: 1.45; white-space: normal; }
.leaf-item.selected { background: #fff; color: var(--mall-brand); font-weight: 700; }
.leaf-empty { padding: 36rpx 14rpx; color: var(--mall-muted); font-size: 24rpx; text-align: center; }
.product-pane { flex: 1; min-width: 0; padding: 16rpx 18rpx 44rpx; }
.product-pane.full-width { padding: 18rpx 28rpx 50rpx; }
.result-heading { padding: 26rpx 30rpx 12rpx; font-size: 30rpx; font-weight: 700; }
.result-heading text { margin-left: 10rpx; color: var(--mall-muted); font-size: 24rpx; font-weight: 400; }
.product-row { display: flex; width: 100%; margin: 0 0 16rpx; padding: 14rpx; background: #fff; border-radius: 12rpx; text-align: left; box-shadow: 0 5rpx 22rpx rgba(21, 49, 31, .055); }
.product-image { flex: none; width: 150rpx; height: 150rpx; border-radius: 9rpx; background: var(--mall-canvas); }
.product-info { flex: 1; min-width: 0; padding: 2rpx 0 0 14rpx; }
.product-name { font-size: 27rpx; line-height: 1.35; font-weight: 650; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-kind { margin-top: 6rpx; color: var(--mall-muted); font-size: 22rpx; }
.product-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 4rpx; margin-top: 13rpx; }
.product-price { color: var(--mall-brand); font-size: 32rpx; font-weight: 700; }
.product-open { color: var(--mall-brand); font-size: 20rpx; white-space: nowrap; }
.product-unavailable { margin-top: 4rpx; color: var(--mall-muted); font-size: 21rpx; }
.pagination-note { padding: 28rpx; color: var(--mall-muted); font-size: 23rpx; text-align: center; }
.pagination-note.error { color: var(--mall-danger); }
.page-state, .list-state { padding: 90rpx 36rpx; text-align: center; color: var(--mall-muted); font-size: 27rpx; }
.state-title { color: var(--mall-text); font-size: 30rpx; font-weight: 700; }
.state-copy { margin-top: 14rpx; line-height: 1.55; }
.state-action { display: inline-block; margin: 28rpx 0 0; padding: 0 28rpx; height: 70rpx; line-height: 70rpx; background: var(--mall-brand); color: #fff; border-radius: 12rpx; font-size: 26rpx; }
.catalog-header { padding: 24rpx 28rpx; }
.catalog-title { font-size: 34rpx; }
.root-item.selected { border-bottom-width: 3rpx; }
.product-row { border-radius: 8rpx; box-shadow: none; border-bottom: 1rpx solid var(--mall-border); padding: 22rpx 12rpx; margin-bottom: 0; }
.product-pane { background: #fff; }
.product-foot { flex-wrap: wrap; gap: 10rpx; }
.image-fallback { display: flex; align-items: center; justify-content: center; color: var(--mall-muted); font-size: 22rpx; }
.leaf-item { min-height: 88rpx; }
.product-open { color: var(--mall-brand); border: 1rpx solid var(--mall-brand); border-radius: 6rpx; padding: 4rpx 8rpx; }
@media(max-width:320px) { .leaf-rail { width: 140rpx; } .product-pane { padding-left: 12rpx; padding-right: 12rpx; } .product-image { width: 120rpx; height: 130rpx; } .product-name { font-size: 25rpx; } }
