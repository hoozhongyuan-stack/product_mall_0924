<view class="center-page">
 <view wx:if="{{restaurant}}" class="restaurant-header"><view class="restaurant-heading"><view class="restaurant-name">{{restaurant.name}}</view><view class="caption">{{restaurant.address}}</view></view><picker wx:if="{{restaurants.length > 1}}" range="{{restaurants}}" range-key="name" disabled="{{busy || pending}}" bindchange="chooseRestaurant"><view class="switch-store">切换</view></picker></view>
 <view wx:if="{{restaurant}}" class="section-navigation"><button wx:for="{{sections}}" wx:key="value" class="section-tab {{section === item.value ? 'selected' : ''}}" data-section="{{item.value}}" disabled="{{busy || pending}}" bindtap="section">{{item.label}}</button></view>
 <view wx:if="{{error}}" class="feedback error" role="alert"><text>{{error}}</text><button class="text-action" disabled="{{busy}}" bindtap="load">重新加载</button></view>
 <view wx:if="{{state === 'auth'}}" class="state"><view class="state-title">请先登录</view><view class="muted">登录后可查看已授权的餐饮店。</view><button class="primary-action" bindtap="login">登录</button></view>
 <view wx:elif="{{state === 'empty'}}" class="state"><view class="state-title">尚未授权餐饮店</view><view class="muted">请联系平台为当前会员绑定餐饮店管理权限。</view></view>
 <view wx:elif="{{state === 'loading'}}" class="loading-state">正在加载{{section === 'products' ? '商品' : section === 'orders' ? '订单' : '佣金账户'}}…</view>
 <view wx:if="{{restaurant && !sections.length && state !== 'loading'}}" class="state"><view class="state-title">暂无可用管理权限</view><view class="muted">请联系平台配置商品、订单或佣金权限。</view></view>
 <block wx:if="{{section === 'products'}}">
  <view wx:if="{{products.length}}" class="list-caption">共 {{total}} 件商品 · 库存由履约前置仓提供</view>
  <view class="product-list" wx:if="{{products.length}}"><view class="product-item" wx:for="{{products}}" wx:key="id"><image wx:if="{{item.imageUrl}}" class="product-thumb" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/><view wx:else class="product-thumb placeholder">暂无图片</view><view class="product-body"><view class="product-name">{{item.name}}</view><view class="product-meta"><text class="product-price">{{item.priceLabel}}</text><text class="sale-state {{item.saleTone}}">{{item.saleLabel}}</text></view><view class="product-stock {{item.shortage ? 'shortage' : ''}}">{{item.stockLabel}}</view><view class="product-row-actions"><text class="caption">{{item.specCount}} 个规格</text><button class="sale-action" data-id="{{item.id}}" bindtap="toggle" disabled="{{busy || pending || (!item.onSale && !item.canPutOnSale)}}"><text>{{item.onSale ? '下架' : '上架'}}</text><view class="sale-track {{item.onSale ? 'track-on' : ''}}"><view class="sale-dot"/></view></button></view></view></view></view>
  <view wx:if="{{state === 'ready' && !products.length}}" class="state"><view class="state-title">暂无可管理商品</view><view class="muted">平台配置商品后将在这里展示。</view></view><view wx:if="{{products.length}}" class="page-note">上架控制本店商品展示；库存与履约由 {{restaurant.fulfillmentStore.name || '匹配前置仓'}} 负责，缺货不切换其他仓。</view>
 </block>
 <block wx:if="{{section === 'orders'}}">
  <block wx:if="{{!detailId}}"><view wx:if="{{orders.length}}" class="list-caption">共 {{total}} 笔订单</view><view class="order-list"><button class="order-item" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder"><view class="record-row"><text class="record-reference">{{item.orderNo}}</text><text class="order-status">{{item.statusLabel}}</text></view><view class="order-target">{{item.tableNumber}} 桌 · {{item.lines.length}} 项商品</view><view class="record-row"><text class="caption">{{item.date}}</text><text class="order-amount">{{item.amount}}</text></view></button></view><view wx:if="{{state === 'ready' && !orders.length}}" class="state"><view class="state-title">本店暂无订单</view><view class="muted">顾客扫码下单后，可在这里查看订单进度。</view></view></block>
  <view wx:if="{{detailId}}" class="order-detail"><button class="back-action" bindtap="closeDetail">返回订单列表</button><view wx:if="{{detailLoading}}" class="loading-state">正在读取订单详情…</view><view wx:if="{{detailError}}" class="feedback error"><text>{{detailError}}</text><button class="text-action" data-id="{{detailId}}" bindtap="openOrder">重试</button></view><block wx:if="{{detail}}"><view class="detail-section"><view class="record-row"><text class="section-title">{{detail.orderNo}}</text><text class="order-status">{{detail.statusLabel}}</text></view><view class="caption">下单时间 {{detail.date}}</view><view class="detail-target">{{detail.tableNumber}} 桌</view><view class="detail-address">{{detail.address}}</view><view class="caption">履约前置仓：{{detail.fulfillmentStore.name || '待核对'}}</view></view><view class="detail-section"><view class="section-title">订单商品</view><view class="order-line" wx:for="{{detail.lines}}" wx:key="id"><view class="line-body"><text>{{item.name}}</text><text class="caption">{{item.skuCode}} · {{item.quantity}} {{item.saleUnit}}</text></view><text>{{item.amount}}</text></view><view class="total-row"><text>订单实付</text><text class="order-amount">{{detail.amount}}</text></view></view><view wx:if="{{detail.commission}}" class="detail-section"><view class="record-row"><text>本单佣金</text><text class="order-amount">{{detail.commission.amount}}</text></view><view class="caption">{{detail.commission.statusLabel}}</view><view wx:if="{{detail.commission.reason}}" class="page-note">{{detail.commission.reason}}</view></view><view class="page-note">餐饮店可查看消费订单，由前置仓负责配送及订单履约。</view></block></view>
 </block>
 <button wx:if="{{!detailId && (section === 'products' || section === 'orders') && total > (section === 'products' ? products.length : orders.length)}}" class="load-more" bindtap="more" disabled="{{state === 'loading'}}">{{state === 'loading' ? '加载中…' : '加载更多'}}</button>
 <block wx:if="{{section === 'account'}}">
  <view class="finance-navigation" wx:if="{{account}}"><button class="finance-tab {{accountPanel === 'overview' ? 'selected' : ''}}" data-panel="overview" bindtap="financePanel" disabled="{{busy || pending}}">余额</button><button class="finance-tab {{accountPanel === 'income' ? 'selected' : ''}}" data-panel="income" bindtap="financePanel" disabled="{{busy || pending}}">佣金明细</button><button class="finance-tab {{accountPanel === 'withdrawals' ? 'selected' : ''}}" data-panel="withdrawals" bindtap="financePanel" disabled="{{busy || pending}}">提现记录</button></view>
  <view wx:if="{{pending}}" class="feedback pending-note"><text>上次申请结果待确认，已保留原金额与请求。</text><button class="text-action" bindtap="withdraw" disabled="{{busy}}" loading="{{busy}}">重试原申请</button></view>
  <block wx:if="{{account}}">
   <block wx:if="{{accountPanel === 'overview'}}"><view class="finance-overview"><view class="caption">可申请提现</view><view class="available-amount">{{account.available}}</view><view class="finance-metrics"><view><text>{{account.pending}}</text><text>待过售后期</text></view><view><text>{{account.held}}</text><text>冻结待处理</text></view><view><text>{{account.frozen}}</text><text>提现占用</text></view></view></view><view class="withdrawal-form"><view class="section-title">申请提现</view><view class="amount-field"><text>金额（元）</text><input type="digit" placeholder="请输入提现金额" value="{{amount}}" bindinput="amount" disabled="{{busy || pending || !account.canApply}}"/></view><button class="primary-action" bindtap="withdraw" disabled="{{busy || pending || !account.canApply}}" loading="{{busy}}">提交提现申请</button><view class="caption">提交后等待平台审核；审核通过不代表已打款。</view></view><view class="page-note">{{account.fundingLabel || '餐饮佣金由履约前置仓利润份额承担。'}} 订单完成入账，过售后期且前置仓结算完成后可提现。退款或仓结算冻结时佣金冻结待处理。</view><view wx:if="{{!account.payoutEnabled}}" class="page-note">当前未启用自动打款，请以平台审核与实际付款结果为准。</view></block>
   <block wx:if="{{accountPanel === 'income'}}"><view class="list-caption">最近 100 条佣金记录</view><view class="finance-list"><view class="finance-item" wx:for="{{account.incomes}}" wx:key="orderId"><view class="record-row"><text class="record-reference">{{item.orderNo}}</text><text class="order-amount">{{item.amount}}</text></view><view class="record-row caption"><text>{{item.tableNumber}} 桌</text><text>{{item.statusLabel}}</text></view><view wx:if="{{item.bookedAt}}" class="caption">入账时间 {{item.bookedDate}}</view><view wx:if="{{item.availableAt}}" class="caption">可提现时间 {{item.availableDate}}</view><view wx:if="{{item.reason}}" class="record-reason">{{item.reason}}</view></view></view><view wx:if="{{!account.incomes.length}}" class="state"><view class="state-title">暂无佣金记录</view><view class="muted">产生消费订单后，在这里查看佣金进度。</view></view></block>
   <block wx:if="{{accountPanel === 'withdrawals'}}"><view class="list-caption">最近 100 条提现申请</view><view class="finance-list"><view class="finance-item" wx:for="{{account.withdrawals}}" wx:key="id"><view class="record-row"><text class="order-amount">{{item.amount}}</text><text class="order-status">{{item.statusLabel}}</text></view><view class="caption">申请时间 {{item.date}}</view><view wx:if="{{item.reason}}" class="record-reason">审核说明：{{item.reason}}</view></view></view><view wx:if="{{!account.withdrawals.length}}" class="state"><view class="state-title">暂无提现申请</view><view class="muted">提交申请后，在这里查看审核进度。</view></view><view class="page-note">“审核通过，待打款”仅表示审核结果，不代表资金到账。</view></block>
  </block>
 </block>
</view>
