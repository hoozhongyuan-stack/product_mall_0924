<view class="page"><text class="title">联盟中心</text><picker wx:if="{{restaurants.length}}" range="{{restaurants}}" range-key="name" bindchange="chooseRestaurant"><view class="card">{{restaurant.name}} ›</view></picker><view class="tabs"><button data-section="products" bindtap="section">商品</button><button data-section="orders" bindtap="section">订单</button><button data-section="account" bindtap="section">佣金</button></view><view class="card" wx:if="{{state === 'loading'}}">正在加载…</view><view class="card error" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view><view class="card" wx:if="{{state === 'empty'}}">当前账号没有餐饮店管理权限。</view><button wx:if="{{state === 'auth'}}" bindtap="login">登录</button><block wx:if="{{section === 'products'}}"><view class="card" wx:for="{{products}}" wx:key="id"><text class="title">{{item.name}}</text><text>{{item.onSale ? '本店已上架' : '本店已下架'}}</text><button data-id="{{item.id}}" bindtap="toggle" disabled="{{busy}}">{{item.onSale ? '下架' : '上架'}}</button></view><view class="card" wx:if="{{state === 'ready' && !products.length}}">暂无可管理商品。</view></block><block wx:if="{{section === 'orders'}}"><button class="card" wx:for="{{orders}}" wx:key="id" data-id="{{item.orderId || item.id}}" bindtap="openOrder"><text>{{item.orderNo}}</text><text>¥{{item.amount}} · {{item.fulfillmentStatus || item.status}}</text><text>{{item.tableNumber}} 桌</text></button><view class="card" wx:if="{{state === 'ready' && !orders.length}}">本店暂无订单。</view><view class="card" wx:if="{{detail}}"><text class="title">{{detail.orderNo}}</text><text>{{detail.address}} · {{detail.tableNumber}} 桌</text><text wx:for="{{detail.lines}}" wx:key="id">{{item.name || item.productName}} × {{item.quantity}}</text><text>实付 ¥{{detail.amount}}</text><button bindtap="closeDetail">关闭详情</button></view></block><button wx:if="{{(section === 'products' || section === 'orders') && total > (section === 'products' ? products.length : orders.length)}}" bindtap="more" disabled="{{state === 'loading'}}">加载更多</button><block wx:if="{{section === 'account' && account}}"><view class="card"><text class="title">可提现 ¥{{account.available}}</text><text>待过售后期 ¥{{account.pending}}</text><text>冻结待处理 ¥{{account.held}}</text><text class="muted">餐饮佣金由履约前置仓利润份额承担。订单完成入账，过服务端记录的售后期且仓结算已完成后可提现；退款或仓结算冻结时佣金冻结待处理。</text><text class="muted" wx:if="{{account.fundingLabel}}">{{account.fundingLabel}}</text><input type="digit" placeholder="提现金额（元）" value="{{amount}}" bindinput="amount" disabled="{{busy || pending}}" /><button class="primary" bindtap="withdraw" disabled="{{busy}}" loading="{{busy}}">{{pending ? '重试原提现申请' : '申请提现'}}</button></view><view class="card" wx:for="{{account.incomes}}" wx:key="orderId"><text>{{item.orderNo}} · ¥{{item.amount}}</text><text>{{item.statusLabel}}</text><text class="muted">{{item.reason}}</text></view><view class="card" wx:for="{{account.withdrawals}}" wx:key="id"><text>提现 ¥{{item.amount}} · {{item.status}}</text><text class="muted">{{item.date}}</text></view></block></view>
