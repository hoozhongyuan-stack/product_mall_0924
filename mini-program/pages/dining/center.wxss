.center-page{padding:0 24rpx 48rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box;background:#f4f5f5;color:#20252a;font-size:28rpx;line-height:1.6}
.center-page button{margin:0;min-height:44px;font-size:26rpx;line-height:1.6;padding:16rpx 24rpx;box-sizing:border-box;border-radius:8rpx;background:transparent;color:#20252a}
.center-page button::after{border:0}.center-page button[disabled]{opacity:.5}.center-page button:focus{outline:2rpx solid #a3202b;outline-offset:2rpx}
.restaurant-header{display:flex;align-items:center;gap:20rpx;background:#fff;padding:28rpx 24rpx;margin:0 -24rpx;border-bottom:1rpx solid #e7e9eb}.restaurant-heading{flex:1;min-width:0}.restaurant-name{font-size:32rpx;font-weight:600;overflow-wrap:anywhere}.caption,.muted{font-size:24rpx;color:#66717a;overflow-wrap:anywhere}.restaurant-heading .caption{margin-top:8rpx}.switch-store{font-size:24rpx;color:#a3202b;padding:16rpx 20rpx;border:1rpx solid #e7e9eb;border-radius:8rpx;min-height:44px;box-sizing:border-box;display:flex;align-items:center}
.section-navigation{display:flex;gap:24rpx;margin:0 -24rpx;padding:0 24rpx;background:#fff;border-bottom:1rpx solid #e7e9eb}.center-page .section-tab{flex:1;border-radius:0;color:#66717a;padding:20rpx 4rpx}.center-page .selected{color:#a3202b;font-weight:600;border-bottom:4rpx solid #a3202b}
.loading-state{padding:32rpx 4rpx;color:#66717a;font-size:26rpx}.feedback{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;padding:20rpx 24rpx;background:#fff;margin-top:24rpx;border-radius:12rpx;font-size:26rpx}.feedback>text{flex:1;min-width:0;overflow-wrap:anywhere}.error{color:#b42318}.center-page .text-action,.center-page .back-action{color:#a3202b;padding:12rpx 0;background:transparent}.state{text-align:center;padding:72rpx 24rpx}.state-title{font-size:30rpx;font-weight:600;margin-bottom:12rpx}.state .primary-action{margin:24rpx auto 0;max-width:280rpx}.page-note{font-size:24rpx;color:#66717a;line-height:1.75;margin:24rpx 4rpx;overflow-wrap:anywhere}.list-caption{font-size:24rpx;color:#66717a;margin:24rpx 4rpx 16rpx}
.product-list,.order-list,.finance-list{background:#fff;border-radius:16rpx;overflow:hidden}.product-item{display:flex;gap:20rpx;padding:24rpx;border-bottom:1rpx solid #e7e9eb}.product-item:last-child{border-bottom:0}.product-thumb{width:112rpx;height:112rpx;flex:none;border-radius:10rpx;background:#f4f5f5}.placeholder{font-size:22rpx;color:#66717a;display:flex;align-items:center;justify-content:center}.product-body{flex:1;min-width:0}.product-name{font-size:28rpx;font-weight:600;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}.product-meta{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin-top:8rpx}.product-price{font-weight:600;color:#a3202b;font-variant-numeric:tabular-nums}.sale-state{font-size:22rpx;padding:2rpx 8rpx;border-radius:4rpx}.active{color:#24765b;background:#eef6f2}.inactive{color:#66717a;background:#f4f5f5}.product-stock{font-size:24rpx;color:#66717a;margin-top:8rpx;overflow-wrap:anywhere}.shortage{color:#a3202b}.product-row-actions{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:8rpx}.center-page .sale-action{display:flex;align-items:center;gap:12rpx;font-size:24rpx;padding:8rpx 0;color:#66717a}.sale-track{width:60rpx;height:32rpx;background:#7b838b;border-radius:18rpx;padding:4rpx;box-sizing:border-box;display:flex;align-items:center}.sale-dot{width:24rpx;height:24rpx;border-radius:50%;background:#fff}.track-on{background:#a3202b;justify-content:flex-end}
.center-page .order-item{width:100%;padding:24rpx;text-align:left;border-radius:0;border-bottom:1rpx solid #e7e9eb;background:#fff}.order-item:last-child{border-bottom:0}.record-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-width:0}.record-reference{flex:1;min-width:0;overflow-wrap:anywhere;font-size:26rpx}.order-status{font-size:24rpx;color:#a3202b;flex:none}.order-target{font-size:26rpx;margin:12rpx 0}.order-amount{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.order-detail{margin-top:16rpx}.detail-section,.finance-overview,.withdrawal-form{background:#fff;padding:28rpx 24rpx;border-radius:16rpx;margin:20rpx 0}.section-title{font-size:28rpx;font-weight:600;overflow-wrap:anywhere}.detail-target{font-size:36rpx;font-weight:600;margin:24rpx 0 8rpx}.detail-address{margin-bottom:12rpx;overflow-wrap:anywhere}.order-line{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #e7e9eb}.line-body{display:flex;flex-direction:column;flex:1;min-width:0;overflow-wrap:anywhere}.total-row{display:flex;justify-content:space-between;gap:16rpx;padding-top:24rpx}.center-page .load-more{width:100%;color:#a3202b;margin-top:20rpx}
.finance-navigation{display:flex;gap:8rpx;background:#fff;border-radius:12rpx;margin-top:20rpx}.center-page .finance-tab{flex:1;padding:16rpx 4rpx;border-radius:0;font-size:24rpx;color:#66717a}.available-amount{font-size:44rpx;font-weight:600;line-height:1.4;margin:12rpx 0 24rpx;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.finance-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;padding-top:20rpx;border-top:1rpx solid #e7e9eb}.finance-metrics>view{display:flex;flex-direction:column;gap:8rpx;text-align:center;min-width:0;color:#66717a;font-size:22rpx}.finance-metrics>view>text:first-child{font-size:26rpx;color:#20252a;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}.amount-field{display:flex;align-items:center;gap:24rpx;border-bottom:1rpx solid #e7e9eb;padding:20rpx 0;margin-bottom:24rpx}.amount-field>text{flex:none;font-size:26rpx}.amount-field input{flex:1;min-width:0;font-size:28rpx;height:44px;text-align:right;padding:0;border:0}.center-page .primary-action{background:#a3202b;color:#fff;width:100%;margin-bottom:16rpx}.finance-item{padding:24rpx;border-bottom:1rpx solid #e7e9eb}.finance-item:last-child{border-bottom:0}.finance-item .caption{margin-top:10rpx}.record-reason{font-size:24rpx;color:#66717a;margin-top:12rpx;overflow-wrap:anywhere}.pending-note{color:#a3202b;background:#fff2f0}

.center-page .finance-tab.selected{color:#a3202b}
