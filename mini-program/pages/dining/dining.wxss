.page{padding:24rpx 24rpx 64rpx;background:#f4f5f5;min-height:100vh;color:#20252a;font-size:28rpx}.card{display:flex;flex-direction:column;gap:16rpx;background:white;padding:28rpx;border:1rpx solid #e7e9eb;border-radius:16rpx;margin-bottom:20rpx;text-align:left}.title{font-size:34rpx;font-weight:600}.muted{color:#66717a;font-size:24rpx}.price{color:#a3202b;font-weight:600}.badge{color:#a3202b;background:#fff2f0;padding:8rpx 16rpx;align-self:flex-start;border-radius:8rpx}.primary{background:#a3202b;color:#fff;margin:24rpx 0}.error{color:#b42318}.sku{display:flex;justify-content:space-between;gap:12rpx;padding:16rpx 0;border-top:1rpx solid #e7e9eb}.sku>view:first-child{display:flex;flex-direction:column;gap:8rpx;flex:1}.quantity{display:flex;align-items:center;gap:12rpx}.quantity button{padding:0 16rpx}.tabs{display:flex;gap:12rpx;margin-bottom:20rpx}.tabs button{flex:1;font-size:28rpx}.footnote{display:block;text-align:center}input{padding:20rpx;border:1rpx solid #e7e9eb;border-radius:8rpx}radio-group{display:flex;gap:24rpx;flex-wrap:wrap}
