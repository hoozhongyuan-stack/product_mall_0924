<view class="page"><view class="card" wx:if="{{quote.dining}}"><text class="title">配送到 {{quote.dining.name}}</text><text>{{quote.dining.address}}</text><text class="badge">{{quote.dining.tableNumber}} 桌</text><text class="muted">地址与桌号由餐桌码自动带入，前置仓负责配送。</text></view><view class="card" wx:if="{{state === 'loading'}}">正在核对价格与库存…</view><view class="card error" wx:if="{{error}}">{{error}}</view><view class="card" wx:for="{{lines}}" wx:key="skuId"><text>{{item.name}} × {{item.quantity}}</text><text class="price">{{item.amount}}</text><text wx:if="{{item.status !== 'OK'}}" class="error">该商品暂不可购买</text></view><view class="card" wx:if="{{quote}}"><text>商品金额 {{goodsTotal}}</text><text>配送费 {{shippingFee}}</text><text class="title">实付 {{total}}</text><radio-group bindchange="choosePayment"><label wx:for="{{paymentChoices}}" wx:key="*this"><radio value="{{item}}" checked="{{paymentMethod === item}}" />{{item === 'WECHAT' ? '微信支付' : '线下支付'}}</label></radio-group></view><button wx:if="{{quote.confirmRequired}}" bindtap="confirmPrices">确认新价格并重新报价</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || (!pending && !canSubmit)}}">{{pending ? '重试确认原订单' : '提交订单'}}</button><button bindtap="refresh" disabled="{{busy || pending}}">重新获取报价</button><button bindtap="openOrders">查看我的订单</button></view>
