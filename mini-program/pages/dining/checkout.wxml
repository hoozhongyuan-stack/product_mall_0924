<import src="../../components/commerce-amounts.wxml" />
<view class="checkout-page commerce-page">
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在核对价格与库存…</view>
  <view wx:if="{{error}}" class="notice warning-notice" role="alert">{{error}}</view>
  <view wx:if="{{quote.dining}}" class="card address"><view class="heading">{{quote.dining.name}} · {{quote.dining.tableNumber}} 桌</view><view class="address-destination">{{quote.dining.address}}</view><view class="muted">送至餐桌 · 店铺与桌号固定</view></view>
  <view wx:if="{{lines.length}}" class="card"><view class="heading">商品清单</view><commerce-line wx:for="{{lines}}" wx:key="skuId" line="{{item}}"><view slot="status"><view wx:if="{{item.status !== 'OK'}}" class="warning">商品暂不可购买，请返回调整</view><view wx:if="{{item.priceChanged}}" class="warning">价格已更新，请确认</view></view></commerce-line></view>
  <view wx:if="{{quote}}" class="card"><view class="heading">支付方式</view><radio-group class="payment-options" bindchange="choosePayment"><label wx:for="{{paymentChoices}}" wx:key="*this" class="payment-choice"><radio value="{{item}}" checked="{{paymentMethod === item}}" color="#A3202B" disabled="{{busy || pending}}" />{{item === 'WECHAT' ? '微信支付' : '线下支付'}}</label></radio-group><view wx:if="{{!paymentChoices.length}}" class="muted">收款入口暂不可用</view><view wx:if="{{offlinePolicyError}}" class="warning" role="alert">{{offlinePolicyError}}</view><view wx:if="{{paymentMethod === 'OFFLINE' && offlinePolicy.configured}}" class="payment-instructions"><view class="strong">付款说明</view><text selectable>{{offlinePolicy.instructions}}</text><view class="muted">提交后待付款，到账由平台核实。</view></view></view>
  <view wx:if="{{quote}}" class="card"><template is="commerce-amounts" data="{{source: quote, goodsTotal: goodsTotal, shippingFee: shippingFee, couponDiscount: couponDiscount, pointsDiscount: pointsDiscount, total: total}}" /></view>
  <button wx:if="{{quote.confirmRequired}}" class="secondary-button" bindtap="confirmPrices" disabled="{{busy || pending}}">确认新价格并重新报价</button>
  <button wx:if="{{state !== 'loading'}}" class="secondary-button" bindtap="refresh" disabled="{{busy || pending}}">重新核对报价</button>
  <button class="secondary-button" bindtap="openOrders" disabled="{{busy}}">我的订单</button>
  <view class="footer"><view class="footer-total"><view class="muted">应付金额</view><view class="price">{{total || '待核算'}}</view></view><button bindtap="submit" loading="{{busy}}" disabled="{{busy || (!pending && !canSubmit)}}">{{pending ? '确认原订单' : '提交订单'}}</button></view>
</view>
