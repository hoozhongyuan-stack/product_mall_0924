<view class="page"><view class="card" wx:if="{{visit}}"><text class="title">{{visit.restaurant.name}}</text><text class="badge">{{visit.table.number}} 桌</text><text>{{visit.restaurant.address}}</text><text class="muted">由 {{visit.fulfillmentStore.name}} 提供库存和配送</text></view><view wx:if="{{state === 'loading'}}" class="card">正在加载餐饮店铺…</view><view wx:if="{{error}}" class="card error">{{error}}<button wx:if="{{state === 'auth'}}" bindtap="login">登录</button><button wx:else bindtap="scan">重新扫码</button></view><view class="card" wx:for="{{products}}" wx:key="id"><text class="title">{{item.name}}</text><view class="sku" wx:for="{{item.skus}}" wx:for-item="sku" wx:key="id"><view><text>{{sku.specLabel}}</text><text class="price">¥{{sku.price}}</text><text class="muted">可售 {{sku.availableQuantity}} 件</text></view><view class="quantity"><button size="mini" data-id="{{sku.id}}" data-delta="-1" bindtap="quantity" disabled="{{!quantities[sku.id]}}">−</button><text>{{quantities[sku.id] || 0}}</text><button size="mini" data-id="{{sku.id}}" data-delta="1" bindtap="quantity" disabled="{{(quantities[sku.id] || 0) >= sku.availableQuantity}}">＋</button></view></view></view><view class="card" wx:if="{{state === 'ready' && !products.length}}">本店暂无在售商品。</view><button wx:if="{{products.length < total}}" bindtap="more" disabled="{{state === 'loading'}}">加载更多商品</button><button class="primary" bindtap="checkout" disabled="{{!count || state !== 'ready'}}">结算（{{count}} 件）</button><text class="muted footnote">再次进入本店需要重新扫描餐桌码。</text></view>
