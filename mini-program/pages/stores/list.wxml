<view class="store-page"><view class="search"><input value="{{keyword}}" placeholder="搜索前置仓名称 / 城市" bindinput="input" bindconfirm="load"/><button bindtap="load">搜索</button></view><button class="secondary" bindtap="relocate">重新定位，按距离推荐</button><view class="muted">{{locationError || '可手动选择前置仓，切换后展示该店商品和库存。原前置仓购物车会保留。'}}</view><view wx:if="{{state === 'loading'}}" class="state">正在加载前置仓…</view><view wx:elif="{{state === 'error'}}" class="state">{{error}}<button bindtap="load">重试</button></view><view wx:elif="{{state === 'empty'}}" class="state">暂无匹配前置仓，请调整搜索。</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="store-row" data-id="{{item.id}}" bindtap="choose"><view><view class="title">{{item.name}} <text wx:if="{{selectedId === item.id}}" class="tag">当前前置仓</text></view><view class="muted">{{item.acceptingOrders ? '营业接单' : '暂停接单'}} · {{item.openingHours}}</view><view>{{item.address}}</view></view><text class="muted">{{item.distanceLabel}}</text></view><view class="actions"><button data-id="{{item.id}}" bindtap="choose">选择前置仓</button><button class="secondary" data-id="{{item.id}}" bindtap="phone">联系前置仓</button><button class="secondary" data-id="{{item.id}}" bindtap="map">导航</button></view></view></view>
