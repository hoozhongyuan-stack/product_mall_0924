<view class="procurement-page">
 <view class="warehouse-header"><view><view class="warehouse-name">{{store.name || '前置仓进货'}}</view><view class="muted">向平台采购</view></view><button class="text-button" bindtap="leave">返回中心</button></view>
 <view class="tabs"><button data-panel="list" bindtap="changePanel" class="{{panel === 'list' ? 'active' : ''}}" disabled="{{busy || uncertain}}">进货订单</button><button wx:if="{{canProcure}}" data-panel="products" bindtap="changePanel" class="{{panel !== 'list' ? 'active' : ''}}" disabled="{{busy || uncertain}}">发起进货</button></view>
 <view wx:if="{{state === 'auth'}}" class="state">{{error}}<button bindtap="login">登录</button></view>
 <view wx:elif="{{state === 'forbidden'}}" class="state">{{error}}</view>
 <view wx:elif="{{state === 'loading'}}" class="state" role="status">正在读取进货信息…</view>
 <view wx:elif="{{state === 'error'}}" class="state" role="alert">{{error}}<button bindtap="refresh">重新读取</button></view>
 <block wx:else>
 <view class="notice">进货款独立线下支付，不扣收入提现余额；付款凭证不代表平台已收款。</view>
 <view wx:if="{{uncertain}}" class="panel"><view class="title">原请求结果待确认</view><view class="muted">请重试原请求，系统使用原请求编号避免重复进货。</view><button bindtap="retryPending" disabled="{{busy}}">{{busy ? '正在核对…' : '重试原申请'}}</button></view>
 <view wx:if="{{error && state !== 'error'}}" class="error" role="alert">{{error}}</view>
 <block wx:if="{{panel !== 'confirm'}}">
 <view class="search"><input value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" maxlength="120" placeholder="{{panel === 'list' ? '搜索进货单号' : '搜索商品名称'}}" disabled="{{busy || uncertain}}"/><button bindtap="search" disabled="{{busy || uncertain}}">查询</button></view>
 <scroll-view wx:if="{{panel === 'list'}}" scroll-x class="filter-scroll"><view class="filter-track"><button wx:for="{{filters}}" wx:key="value" data-status="{{item.value}}" bindtap="filter" class="{{status === item.value ? 'active' : ''}}" disabled="{{busy || uncertain}}">{{item.label}}</button></view></scroll-view>
 <block wx:if="{{panel === 'list'}}"><button wx:for="{{orders}}" wx:key="id" class="order-row" data-id="{{item.id}}" bindtap="openOrder"><view class="row"><text class="title reference">{{item.orderNo}}</text><text class="tag">{{item.statusLabel}}</text></view><view class="muted">{{item.lines[0].productName}} · {{item.lineCount}} 个规格</view><view class="row"><text class="muted">{{item.createdLabel}}</text><text class="amount">{{item.payableLabel}}</text></view><view class="muted detail-hint">查看进货详情 ›</view></button><view wx:if="{{!orders.length}}" class="state">暂无符合条件的进货单。</view></block>
 <block wx:else><view class="muted intro">仅平台开放进货的实体规格可选择。本仓下架不影响补货，未配置价不能提交。</view><view wx:for="{{products}}" wx:key="id" class="product-row"><image src="/assets/ui/parcel.svg" mode="aspectFit"/><view class="product-info"><view class="title">{{item.name}}</view><view class="muted">{{item.skus.length}} 个规格</view></view><button class="secondary" data-id="{{item.id}}" bindtap="openSpecs" disabled="{{busy || uncertain}}">选规格</button></view><view wx:if="{{!products.length}}" class="state">暂无可进货商品，请联系平台配置。</view></block>
 <view wx:if="{{loadingMore}}" class="state">正在加载更多…</view><button wx:elif="{{page * 20 < total}}" class="secondary more" bindtap="onReachBottom">加载更多</button>
 </block>
 <block wx:else><view wx:if="{{!uncertain}}" class="panel"><view class="title">确认进货单</view><view wx:for="{{selected}}" wx:key="id" class="selected-row"><view class="title">{{item.productName}}</view><view class="row"><text class="muted">{{item.specLabel}} · 每{{item.saleUnit}}</text><text>× {{item.quantity}}</text></view><view class="muted">进货价 {{item.costLabel}} / {{item.saleUnit}}</view></view><view class="row"><text>商品款</text><text class="amount">{{goodsLabel}}</text></view><view class="row"><text>采购运费</text><text class="muted">平台审单确认</text></view><view class="notice">提交冻结规格进货价和销售单位。平台审单后确认最终应付金额，整单全额付款。</view><label class="field"><text>采购备注（选填）</text><textarea value="{{note}}" bindinput="inputNote" maxlength="300" disabled="{{busy || uncertain}}" placeholder="配送时间要求等"/></label><button bindtap="submit" disabled="{{busy || uncertain || conflict || !selected.length}}">{{busy ? '正在提交…' : '提交给平台审单'}}</button><button class="secondary" data-panel="products" bindtap="changePanel" disabled="{{busy || uncertain}}">{{conflict ? '重新读取规格并核对' : '返回修改'}}</button></view></block>
 <view wx:if="{{panel === 'products'}}" class="bottom-bar"><view><text class="muted">已选 {{selected.length}} 个规格</text><view class="amount">{{goodsLabel}}</view></view><button bindtap="confirm" disabled="{{!selected.length || busy || uncertain}}">核对进货单</button></view>
 </block>
</view>
<view wx:if="{{specEditor}}" class="overlay quantity-overlay" style="bottom:{{keyboardHeight}}px;" catchtouchmove="noop">
 <view class="dialog quantity-dialog" role="dialog" aria-modal="true" aria-label="选择进货规格">
  <view class="quantity-heading"><view class="row"><view class="title">{{specEditor.name}}</view><button class="text-button" bindtap="closeSpecs">关闭</button></view><view class="muted">按销售单位填写数量，0 表示不选。</view></view>
  <scroll-view scroll-y class="spec-scroll" scroll-into-view="{{specFocusId}}" scroll-with-animation="{{true}}">
   <view wx:for="{{specEditor.skus}}" wx:key="id" id="sku-{{item.id}}" class="spec-row {{!item.selectable ? 'spec-disabled' : ''}}">
    <view class="spec-summary"><view>{{item.specLabel}}</view><view class="muted">{{item.costLabel}} / {{item.saleUnit}}</view><view wx:if="{{!item.selectable}}" class="muted">暂不可采购，请联系平台配置进货价与销售单位。</view></view>
    <view class="quantity-stepper"><button data-id="{{item.id}}" data-step="-1" bindtap="stepQuantity" disabled="{{!item.selectable || item.draft <= 0}}" aria-label="减少{{item.specLabel}}数量">−</button><input type="number" value="{{item.draft}}" data-id="{{item.id}}" bindinput="quantity" bindfocus="quantityFocus" bindblur="quantityBlur" bindkeyboardheightchange="keyboardHeight" adjust-position="{{false}}" cursor-spacing="20" disabled="{{!item.selectable}}" aria-label="{{item.specLabel}}进货数量" maxlength="3" confirm-type="done"/><button data-id="{{item.id}}" data-step="1" bindtap="stepQuantity" disabled="{{!item.selectable || item.draft >= 999}}" aria-label="增加{{item.specLabel}}数量">＋</button></view>
   </view>
  </scroll-view>
  <view class="quantity-footer"><view wx:if="{{specError}}" class="error" role="alert">{{specError}}</view><button bindtap="saveSpecs">确定数量</button></view>
 </view>
</view>
