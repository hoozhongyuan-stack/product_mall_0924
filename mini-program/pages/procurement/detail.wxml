<view class="procurement-page">
 <view class="warehouse-header"><view><view class="warehouse-name">{{store.name || '前置仓进货'}}</view><view class="muted">进货单详情</view></view><button class="text-button" bindtap="leave">返回</button></view>
 <view wx:if="{{state === 'auth'}}" class="state">{{error}}<button bindtap="login">登录</button></view><view wx:elif="{{state === 'forbidden'}}" class="state">{{error}}</view><view wx:elif="{{state === 'loading'}}" class="state">正在读取进货单…</view><view wx:elif="{{state === 'error'}}" class="state" role="alert">{{error}}<button bindtap="refresh">重新读取</button></view>
 <block wx:elif="{{order}}">
 <view wx:if="{{uncertain}}" class="panel"><view class="title">操作结果待确认</view><view class="muted">使用原请求重试，不另建重复付款记录或收货入库。</view><button bindtap="retryPending" disabled="{{busy}}">{{busy ? '正在核对…' : '重试原操作'}}</button></view>
 <view wx:if="{{proofError && order.status !== 'PAYMENT'}}" class="panel"><view class="error">{{proofError}}</view><button bindtap="retryProofDownload" class="secondary">重新下载付款凭证</button></view>
 <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{conflict}}" bindtap="refresh" class="secondary" disabled="{{busy}}">重新读取并核对</button>
 <view class="panel"><view class="row"><view class="title reference">{{order.orderNo}}</view><text class="tag">{{order.statusLabel}}</text></view><view class="row"><text class="muted">商品款</text><text>{{order.goodsLabel}}</text></view><view class="row"><text class="muted">采购运费</text><text>{{order.status === 'REVIEW' ? '待平台审单确认' : order.freightLabel}}</text></view><view class="row"><text>本单应付</text><text class="amount">{{order.payableLabel}}</text></view><view class="muted">{{order.createdLabel}}</view></view>
 <view class="panel"><view class="title">规格与数量 · 本单快照</view><view wx:for="{{order.lines}}" wx:key="id" class="selected-row"><view class="title">{{item.productName}}</view><view class="row"><text class="muted">{{item.specLabel}}</text><text>{{item.quantity}} {{item.saleUnit}}</text></view><view class="row"><text class="muted">进货价 {{item.costLabel}} / {{item.saleUnit}}</text><text>{{item.amountLabel}}</text></view></view></view>
 <view wx:if="{{order.shipment}}" class="panel"><view class="title">平台发货信息</view><view class="row"><text class="muted">物流公司</text><text>{{order.shipment.carrier}}</text></view><view class="row"><text class="muted">运单号</text><text class="reference">{{order.shipment.tracking}}</text></view></view>
 <view wx:if="{{order.status === 'REVIEW'}}" class="notice">平台正在核对规格与采购运费，审单后再确认应付金额。</view>
 <view wx:if="{{order.status === 'QUOTE'}}" class="panel"><view class="title">确认平台报价</view><view class="notice">请核对采购运费和应付金额。进货款不扣收入提现余额。</view><button wx:if="{{canProcure}}" bindtap="confirmQuote" disabled="{{busy || uncertain || conflict}}">确认金额，去付款</button><view wx:else class="muted">当前仅有收货授权，确认报价需进货权限。</view></view>
 <view wx:if="{{order.status === 'PAYMENT'}}" class="panel"><view class="title">线下付款信息</view><view class="payment-copy">{{order.paymentInstructions}}</view><view class="notice">付款后上传凭证供平台核对，上传成功不代表已收款。</view><button wx:if="{{canProcure}}" bindtap="chooseProof" disabled="{{busy || uncertain || proofBusy || conflict}}">{{proofBusy ? '正在上传…' : proofAsset ? '更换付款凭证' : '选择付款凭证图片'}}</button><button wx:if="{{proofBusy}}" class="secondary" bindtap="cancelUpload">取消上传</button><view wx:if="{{proofAsset}}" class="muted">凭证已上传，待提交平台核款。</view><view wx:if="{{proofError}}" class="error" role="alert">{{proofError}}<button class="secondary" bindtap="uploadProof" disabled="{{proofBusy}}">重试上传</button><button wx:if="{{proofAsset}}" class="secondary" bindtap="retryProofPreview">重试下载预览</button></view><label class="field"><text>付款备注（选填）</text><textarea value="{{note}}" data-key="note" bindinput="input" maxlength="300" placeholder="付款人 / 转账时间" disabled="{{busy || uncertain || !canProcure}}"/></label><button wx:if="{{canProcure}}" bindtap="submitProof" disabled="{{busy || uncertain || proofBusy || !proofAsset || conflict}}">提交凭证，等待平台核款</button></view>
 <view wx:if="{{order.status === 'PROOF'}}" class="notice">付款凭证已提交，等待平台核对实际到账。</view><view wx:if="{{order.status === 'PAID'}}" class="notice">平台已确认全额实际到账，等待整单发货。</view>
 <view wx:if="{{order.status === 'SHIPPED'}}" class="panel"><view class="title">逐行验收商品</view><view class="muted intro">实际数量完整且验收合格后勾选。短缺、破损先登记异常。</view><view wx:if="{{order.unitReviewRequired}}" class="notice">销售单位已变化，须平台核对原冻结单位后才可入库；不会按新倍率换算旧单。</view><checkbox-group wx:for="{{order.lines}}" wx:key="id" data-id="{{item.id}}" bindchange="toggleLine"><label class="receipt-line"><checkbox value="{{item.id}}" checked="{{checked[item.id]}}" color="#A3202B" disabled="{{busy || uncertain || !canReceive || conflict}}"/><view><view>{{item.productName}}</view><view class="muted">{{item.specLabel}} · 应收 {{item.quantity}} {{item.saleUnit}}</view></view></label></checkbox-group><button wx:if="{{canReceive}}" bindtap="receive" disabled="{{busy || uncertain || conflict || order.unitReviewRequired}}">确认整单验收并入库</button><button wx:if="{{canReceive}}" class="secondary" bindtap="toggleException" disabled="{{busy || uncertain || conflict}}">登记短缺 / 破损</button><view wx:else class="muted">当前账号没有收货权限，请联系本仓收货人员。</view></view>
 <view wx:if="{{showException}}" class="panel"><view class="title">收货异常说明</view><textarea value="{{note}}" data-key="note" bindinput="input" maxlength="300" placeholder="短缺数量、破损情况等" disabled="{{busy || uncertain}}"/><button bindtap="reportException" disabled="{{busy || uncertain || conflict}}">提交异常，暂停验收</button></view>
 <view wx:if="{{order.status === 'EXCEPTION'}}" class="notice">异常处理中，尚未收货入库。平台记录补齐凭证后再完整验收，或整单退货退款；不能强制假收货。</view><view wx:if="{{order.status === 'CANCEL_REVIEW'}}" class="notice">取消 / 退款处理中。平台核清款项并保留线下退款凭证后才会关闭。</view><view wx:if="{{order.status === 'RECEIVED'}}" class="notice">本单已完成验收，库存只增加一次；销售订单占用保持原状。</view>
 <button wx:if="{{canProcure && order.status !== 'RECEIVED' && order.status !== 'CANCELLED' && order.status !== 'CANCEL_REVIEW'}}" class="secondary" bindtap="toggleCancel" disabled="{{busy || uncertain || conflict}}">申请取消 / 整单退货退款</button>
 <view wx:if="{{showCancel}}" class="panel"><view class="notice">已转账未提交凭证也需人工核清，不直接视为未付款。</view><label class="field"><text>取消原因</text><textarea value="{{reason}}" data-key="reason" bindinput="input" maxlength="300" disabled="{{busy || uncertain}}"/></label><button bindtap="cancelOrder" disabled="{{busy || uncertain || conflict}}">提交取消申请</button></view>
 <view wx:if="{{order.records.length}}" class="panel"><view class="title">单据处理记录</view><view wx:for="{{order.records}}" wx:key="id" class="selected-row"><view>{{item.kindLabel}}</view><view>{{item.note}}</view><view wx:if="{{item.reference}}" class="muted reference">凭证 / 物流：{{item.reference}}</view><view class="muted">{{item.actorName}} · {{item.createdLabel}}</view><button wx:if="{{item.proofPreviewUrl}}" class="secondary" data-path="{{item.proofPreviewUrl}}" bindtap="viewProof" disabled="{{proofBusy}}">查看私有付款凭证</button></view></view>
 </block>
</view>
<view wx:if="{{proofOpen && proofLocal}}" class="overlay"><view class="dialog" role="dialog" aria-modal="true" aria-label="私有付款凭证"><view class="title">付款凭证</view><image class="proof-image" src="{{proofLocal}}" mode="widthFix" binderror="proofImageError"/><button bindtap="closeProof">关闭预览</button></view></view>
