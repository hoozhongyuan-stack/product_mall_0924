.procurement-page{min-height:100vh;padding:0 24rpx calc(32rpx + env(safe-area-inset-bottom));background:var(--mall-canvas);color:var(--mall-text);font-size:27rpx;line-height:1.6;box-sizing:border-box;overflow-wrap:anywhere}button{background:var(--mall-brand);color:#fff;min-height:82rpx;border-radius:10rpx;padding:16rpx 24rpx;font-size:27rpx;line-height:1.6;margin-top:18rpx;white-space:normal}button::after{border:0}button[disabled]{background:var(--mall-border);color:var(--mall-muted)}button.secondary{background:#fff;border:1rpx solid #cdd2d5;color:var(--mall-brand)}button.text-button{padding:8rpx;background:transparent;color:var(--mall-brand);min-height:64rpx;margin:0;font-size:24rpx}.muted{color:var(--mall-muted);font-size:24rpx}.title{font-weight:650;font-size:29rpx}.warehouse-header{display:flex;justify-content:space-between;align-items:center;gap:16rpx;background:#fff;padding:26rpx 24rpx;margin:0 -24rpx}.warehouse-name{font-size:32rpx;font-weight:650}.tabs{display:flex;background:#fff;border-bottom:1rpx solid var(--mall-border);margin:0 -24rpx 24rpx}.tabs button{flex:1;margin:0;border-radius:0;background:white;color:var(--mall-muted);font-size:25rpx}.tabs .active{color:var(--mall-brand);border-bottom:3rpx solid var(--mall-brand)}.notice{background:#fff5e7;color:#76532c;padding:20rpx;border-radius:10rpx;margin:20rpx 0;font-size:24rpx}.panel{background:#fff;padding:28rpx;border-radius:12rpx;margin:24rpx 0}.row{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;padding:10rpx 0}.row>text:last-child{text-align:right}.row>text,.row>view{min-width:0}.amount{font-weight:650;color:var(--mall-brand);font-variant-numeric:tabular-nums}.tag{font-size:22rpx;padding:3rpx 8rpx;background:var(--mall-brand-soft);color:var(--mall-brand);border-radius:6rpx;flex:none}.reference{word-break:break-all}.state{padding:60rpx 20rpx;text-align:center;color:var(--mall-muted)}.error{color:var(--mall-danger);margin:20rpx 0;font-size:25rpx}.search{display:flex;gap:12rpx;margin:24rpx 0}.search input{flex:1;min-width:0;background:#fff;padding:20rpx;border-radius:10rpx}.search button{margin:0;flex:none}.filter-scroll{white-space:nowrap;margin-bottom:20rpx}.filter-track{display:inline-flex;gap:12rpx}.filter-track button{background:#fff;color:var(--mall-muted);font-size:23rpx;padding:12rpx 20rpx;min-height:68rpx;margin:0;white-space:nowrap}.filter-track .active{background:var(--mall-brand-soft);color:var(--mall-brand)}button.order-row{display:block;width:100%;color:var(--mall-text);background:#fff;text-align:left;padding:24rpx;border-radius:12rpx;margin-bottom:18rpx}.detail-hint{text-align:right;margin-top:8rpx}.product-row{display:flex;align-items:center;gap:18rpx;padding:24rpx;background:white;border-bottom:1rpx solid var(--mall-border)}.product-row image{width:76rpx;height:76rpx;flex:none;background:#fff2f0;border-radius:10rpx;padding:14rpx;box-sizing:border-box}.product-info{flex:1;min-width:0}.product-row button{margin:0;flex:none;font-size:24rpx;padding:12rpx 18rpx}.intro{margin:18rpx 0}.selected-row{padding:22rpx 0;border-bottom:1rpx solid var(--mall-border)}.field{display:block;margin:24rpx 0}.field>text{display:block;margin-bottom:12rpx}.field textarea,textarea{width:100%;box-sizing:border-box;background:var(--mall-canvas);border:1rpx solid var(--mall-border);border-radius:8rpx;padding:18rpx;min-height:130rpx;font-size:26rpx}.bottom-bar{position:sticky;bottom:0;background:#fff;display:flex;gap:20rpx;justify-content:space-between;align-items:center;padding:18rpx 0;margin-top:24rpx}.bottom-bar button{margin:0}.overlay{position:fixed;inset:0;background:rgba(32,37,42,.5);z-index:80;display:flex;align-items:center;justify-content:center;padding:24rpx;box-sizing:border-box}.dialog{width:100%;max-height:85vh;overflow:auto;background:#fff;padding:28rpx;border-radius:16rpx;box-sizing:border-box}.spec-scroll{max-height:55vh}.spec-row{display:flex;justify-content:space-between;gap:20rpx;align-items:center;padding:24rpx 0;border-bottom:1rpx solid var(--mall-border)}.spec-row>view{flex:1;min-width:0}.spec-row input{width:130rpx;flex:none;background:var(--mall-canvas);border:1rpx solid #cdd2d5;border-radius:8rpx;padding:14rpx;box-sizing:border-box}.receipt-line{display:flex;gap:16rpx;align-items:center;padding:24rpx 0;border-bottom:1rpx solid var(--mall-border)}.receipt-line checkbox{flex:none}.payment-copy{white-space:pre-wrap;margin:18rpx 0;font-size:26rpx}.proof-image{display:block;width:100%;height:auto;margin-top:20rpx}.more{width:100%}@media(max-width:320px){.procurement-page{font-size:25rpx}.tag{max-width:200rpx;white-space:normal}.title{font-size:27rpx}.product-row{padding:20rpx 12rpx}.row{gap:10rpx}}
