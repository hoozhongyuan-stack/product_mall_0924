.login-page{min-height:100vh;padding:100rpx 56rpx 70rpx;background:var(--mall-canvas);color:var(--mall-text);box-sizing:border-box;display:flex;flex-direction:column;align-items:center}.mark{width:116rpx;height:116rpx;line-height:116rpx;text-align:center;background:var(--mall-brand);color:#fff;border-radius:28rpx;font-size:64rpx}.heading{font-size:38rpx;font-weight:700;margin-top:42rpx}.lead{font-size:26rpx;color:var(--mall-muted);text-align:center;line-height:1.6;margin-top:22rpx}.login-actions{margin-top:auto;width:100%}.login-actions button{width:100%;margin:16rpx 0}.primary{background:var(--mall-brand);color:#fff}.secondary,.privacy{background:transparent;color:var(--mall-brand)}.agreement{display:flex;align-items:center;font-size:22rpx;color:var(--mall-muted);line-height:1.5}.privacy{font-size:22rpx;text-decoration:underline}.error{color:var(--mall-danger);margin-top:30rpx;text-align:center}
.login-page { background: #fff; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.mark { border-radius: 22rpx; }
.heading { text-align: center; font-size: 36rpx; line-height: 1.4; }
.login-actions { padding-top: 80rpx; }
.login-actions .primary { min-height: 92rpx; font-size: 29rpx; }
.login-actions .primary[disabled] { background: var(--mall-border); color: var(--mall-muted); }
.agreement { align-items: flex-start; gap: 8rpx; }
.privacy { min-height: 72rpx; }
