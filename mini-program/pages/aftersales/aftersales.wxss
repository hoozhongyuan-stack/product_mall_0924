@import "../orders/orders.wxss";
.field-label{display:block;font-weight:700;margin:28rpx 0 12rpx}.picker-value{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:20rpx;border:1rpx solid var(--mall-border);border-radius:8rpx;min-height:48rpx;overflow-wrap:anywhere}.picker-hint{flex:none;color:var(--mall-brand);font-size:24rpx}.quantity-input{min-height:80rpx;box-sizing:border-box;width:100%;padding:16rpx 20rpx;border:1rpx solid var(--mall-border);border-radius:8rpx;font-size:30rpx}.amount-summary{display:flex;justify-content:space-between;gap:20rpx;align-items:center;padding:24rpx 0;flex-wrap:wrap}.case-row{padding:24rpx 0;border-top:1rpx solid var(--mall-border);overflow-wrap:anywhere}.case-row .status-label{font-size:26rpx;flex:none}.bottom-actions{margin-top:24rpx}.picker-value:focus,.quantity-input:focus{border-color:var(--mall-brand)}
.field-label { margin-top: 28rpx; font-size: 27rpx; }
.picker-value, .quantity-input, .section textarea { border-color: #D4D8DB; background: #fff; }
.section textarea { min-height: 210rpx; }
.picker-value:focus, .quantity-input:focus { border-color: var(--mall-brand); }
.amount-summary { border-top: 1rpx solid var(--mall-border); margin-top: 20rpx; }
