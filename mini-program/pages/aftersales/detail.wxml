<view class="orders-page">
  <view wx:if="{{state === 'loading'}}" class="state" role="status">正在核对售后进度…</view>
  <view wx:elif="{{state !== 'ready'}}" class="state" role="alert">
    <view>{{error}}</view>
    <button wx:if="{{state === 'auth'}}" bindtap="login">登录后查看</button>
    <button wx:else bindtap="refresh">重新加载</button>
    <button class="secondary" bindtap="openOrders">我的订单</button>
  </view>
  <block wx:else>
    <view class="status-panel"><view class="title">{{saleCase.statusLabel}}</view><view class="status-copy">{{saleCase.statusCopy}}</view></view>
    <view class="section">
      <view class="section-title">原申请内容</view><view class="strong">{{saleCase.title}}</view>
      <view class="row"><text>订单号</text><text user-select>{{saleCase.orderNo}}</text></view>
      <view class="row"><text>售后类型</text><text>{{saleCase.kindLabel}}</text></view>
      <view class="row"><text>申请范围</text><text>{{saleCase.scopeLabel}}</text></view>
      <view class="row"><text>申请数量</text><text>{{saleCase.quantity}}</text></view>
      <block wx:if="{{saleCase.isPoints}}"><view class="row"><text>申请退回兑换积分</text><text class="price">{{saleCase.pointsAmountLabel}}</text></view><view class="row"><text>当前获准积分目标</text><text>{{saleCase.effectivePointsLabel}}</text></view><view class="row"><text>订单项累计已退积分</text><text>{{saleCase.returnedPointsLabel}}</text></view><view class="muted">获准目标不代表已返还，最终完成后可从积分明细查看返还及有效期。</view></block>
      <block wx:else>      <view class="row"><text>申请商品金额</text><text class="price">{{saleCase.amountLabel}}</text></view>
      <view class="row"><text>本笔商品退款金额</text><text>{{saleCase.goodsAmountLabel}}</text></view>
      <view class="row"><text>独立运费退款</text><text>{{saleCase.shippingAmountLabel}}</text></view>
      <view class="row"><text>现金退款合计</text><text class="price">{{saleCase.totalAmountLabel}}</text></view>
      <view wx:if="{{saleCase.zeroCash}}" class="muted">本次没有现金退回，数量与权益以平台确认结果为准。</view></block>
      <view wx:if="{{saleCase.refundLabel}}" class="row"><text>退款进度</text><text>{{saleCase.refundLabel}}</text></view>
      <view class="row"><text>申请时间</text><text>{{saleCase.createdLabel}}</text></view>
      <view class="field-label">原因与说明</view><text class="instructions" user-select>{{saleCase.reason}}</text>
    </view>
    <view wx:if="{{saleCase.returnShipment}}" class="section">
      <view class="section-title">已登记退货物流</view>
      <view class="row"><text>快递公司</text><text user-select>{{saleCase.returnShipment.carrierName}}</text></view>
      <view class="row"><text>运单号</text><text user-select>{{saleCase.returnShipment.trackingNo}}</text></view>
      <view class="row"><text>登记时间</text><text>{{saleCase.returnShipment.submittedLabel}}</text></view>
      <view class="muted">寄回不代表验收通过或退款完成，请留存寄件凭证。</view>
    </view>
    <view wx:if="{{saleCase.canSubmitReturnShipment}}" class="section">
      <view class="section-title">{{saleCase.returnShipment ? '更正退货物流' : '登记退货物流'}}</view>
      <view class="instructions">请先联系客服确认退货地址，再寄回商品。填写实际快递公司和运单号，平台收到后进行验收。</view>
      <label class="field-label" for="return-carrier">快递公司</label>
      <input id="return-carrier" class="quantity-input" aria-label="退货快递公司" value="{{carrierName}}" maxlength="80" placeholder="填写实际快递公司" bindinput="onCarrierName" disabled="{{submittingReturn || returnUncertain}}" />
      <label class="field-label" for="return-tracking">运单号</label>
      <input id="return-tracking" class="quantity-input" aria-label="退货运单号" value="{{trackingNo}}" maxlength="80" placeholder="填写实际退货运单号" bindinput="onTrackingNo" disabled="{{submittingReturn || returnUncertain}}" />
      <view wx:if="{{returnUncertain}}" class="notice" role="status">上次登记结果待核实，已保留原资料。请先刷新进度，确认后可按原资料重试。</view>
      <button bindtap="submitReturnShipment" loading="{{submittingReturn}}" disabled="{{submittingReturn || withdrawing || (returnUncertain && !returnChecked)}}">{{submittingReturn ? '正在登记…' : returnUncertain ? '按原资料重试' : saleCase.returnShipment ? '保存物流更正' : '提交退货物流'}}</button>
    </view>
    <view wx:if="{{saleCase.returnAcceptance}}" class="section">
      <view class="section-title">{{saleCase.returnAcceptance.modeLabel}}</view>
      <block wx:if="{{saleCase.returnAcceptance.mode === 'RECEIVED'}}">
        <view class="row"><text>收到数量</text><text>{{saleCase.returnAcceptance.receivedQuantity}}</text></view>
        <view class="row"><text>可售回库数量</text><text>{{saleCase.returnAcceptance.salableQuantity}}</text></view>
        <view class="row"><text>不可售处置数量</text><text>{{saleCase.returnAcceptance.damagedQuantity}}</text></view>
      </block>
      <view class="row"><text>批准退款数量</text><text>{{saleCase.returnAcceptance.refundQuantity}}</text></view>
      <view class="row"><text>批准商品退款金额</text><text class="price">{{saleCase.returnAcceptance.amountLabel}}</text></view>
      <view class="row"><text>处理时间</text><text>{{saleCase.returnAcceptance.acceptedLabel}}</text></view>
      <view class="field-label">平台处理说明</view><text class="instructions" user-select>{{saleCase.returnAcceptance.reason}}</text>
      <view wx:if="{{saleCase.returnAcceptance.partial}}" class="notice">本次按批准数量和金额处理，原申请内容保留供核对。</view>
      <view class="muted">{{saleCase.returnAcceptance.statusCopy}}</view>
    </view>
    <view class="section">
      <view class="section-title">处理记录</view><view wx:if="{{!saleCase.events.length}}" class="muted">暂无处理记录，请稍后刷新。</view>
      <view wx:for="{{saleCase.events}}" wx:key="key" class="case-row"><view class="row"><text class="strong">{{item.statusLabel}}</text><text class="muted">{{item.timeLabel}}</text></view><text class="instructions" user-select>{{item.reason}}</text></view>
    </view>
    <view wx:if="{{saleCase.isPoints && saleCase.orderBenefits}}" class="section"><view class="section-title">兑换订单累计结果</view><view class="row"><text>整单累计已退兑换积分</text><text>{{saleCase.orderBenefits.returnedPoints}} 积分</text></view></view>
    <view wx:if="{{saleCase.orderBenefits && !saleCase.isPoints}}" class="section"><view class="section-title">订单累计权益结果</view><view class="muted">{{saleCase.orderBenefits.scopeCopy}}</view><view class="muted">{{saleCase.orderBenefits.statusLabel}}</view><block wx:if="{{saleCase.orderBenefits.hasAmounts}}"><view class="row"><text>最终有效消费</text><text>{{saleCase.orderBenefits.effectiveSpendLabel}}</text></view><view class="row"><text>当前有效消费积分</text><text>{{saleCase.orderBenefits.earnedPoints}}</text></view><view class="row"><text>累计返还抵扣积分</text><text>{{saleCase.orderBenefits.returnedPoints}}</text></view><view class="row"><text>累计扣回消费积分</text><text>{{saleCase.orderBenefits.clawedBackPoints}}</text></view><view class="row"><text>优惠券恢复</text><text>{{saleCase.orderBenefits.couponRestored ? '已按原有效期恢复' : '未恢复'}}</text></view></block></view>
    <view wx:if="{{actionError}}" class="action-error" role="alert">{{actionError}}</view><view wx:if="{{actionMessage}}" class="notice" role="status">{{actionMessage}}</view>
    <button wx:if="{{saleCase.canWithdraw}}" class="danger" bindtap="withdraw" loading="{{withdrawing}}" disabled="{{withdrawing || submittingReturn}}">{{withdrawing ? '正在撤销…' : '撤销售后申请'}}</button>
    <view class="actions bottom-actions"><button class="secondary" bindtap="refresh" disabled="{{withdrawing || submittingReturn}}">刷新处理进度</button><button class="secondary" bindtap="openOrder">查看订单</button><button class="secondary" bindtap="openApplications">本订单售后</button></view>
  </block>
</view>
