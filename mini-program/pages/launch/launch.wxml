<view class="launch-page">
  <image wx:if="{{mediaUrl}}" class="launch-art" src="{{mediaUrl}}" mode="aspectFill" binderror="onGifError" aria-label="品牌启动图" />
  <image wx:else class="launch-art" src="../../assets/startup-brand.png" mode="aspectFill" aria-label="默认品牌图" />
  <button class="launch-skip" style="top: {{skipTop}}px;" bindtap="skip" aria-label="跳过启动页">跳过</button>
  <view class="launch-countdown" aria-live="polite">{{remainingSeconds}} 秒后进入小程序</view>
  <view class="launch-progress"><view class="launch-progress-fill" style="width: {{progressPercent}}%;"></view></view>
</view>
