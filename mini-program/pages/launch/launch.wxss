.launch-page { position: fixed; inset: 0; width: 100vw; height: 100vh; overflow: hidden; background: #101829; }
.launch-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.launch-skip { position: absolute; z-index: 2; right: 32rpx; margin: 0; padding: 0 28rpx; height: 72rpx; line-height: 72rpx; border-radius: 40rpx; background: rgba(0,0,0,.5); color: #fff; font-size: 26rpx; }
.launch-skip::after { border: 1rpx solid rgba(255,255,255,.5); border-radius: 40rpx; }
.launch-countdown { position: absolute; left: 50%; bottom: calc(48rpx + env(safe-area-inset-bottom)); transform: translateX(-50%); white-space: nowrap; padding: 12rpx 28rpx; border-radius: 40rpx; color: #fff; background: rgba(0,0,0,.5); font-size: 26rpx; }
.launch-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; background: rgba(255,255,255,.3); }
.launch-progress-fill { height: 100%; background: #fff; }
