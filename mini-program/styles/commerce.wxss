/* Shared presentation only. Each page retains its own authorization and operations. */
.commerce-page .warehouse-header,.commerce-page .restaurant-header{color:var(--mall-text)}.commerce-page .warehouse-header .warehouse-hours{color:var(--mall-muted)}.commerce-page .warehouse-header .warehouse-switch{color:var(--mall-brand);border-color:var(--mall-border)}
.commerce-page{box-sizing:border-box;background:var(--mall-canvas);color:var(--mall-text);font-size:28rpx;line-height:1.5;min-width:0}.commerce-page .card,.commerce-page .section,.commerce-page .detail-section{background:var(--mall-surface,#fff);border-radius:12rpx;padding:24rpx;margin-bottom:16rpx;border:0;box-sizing:border-box;overflow-wrap:anywhere}.commerce-page .heading,.commerce-page .section-title,.commerce-page .module-title{font-size:28rpx;font-weight:600;margin-bottom:12rpx;line-height:1.5}.commerce-page .muted,.commerce-page .caption{font-size:24rpx;color:var(--mall-muted);line-height:1.5}.commerce-page .price,.commerce-page .order-amount{color:var(--mall-brand);font-size:30rpx;font-weight:600}.commerce-page .row{padding:10rpx 0;gap:16rpx;min-width:0}.commerce-page .payment-options,.commerce-page .delivery-options{display:flex;gap:12rpx;flex-wrap:wrap}.commerce-page .payment-choice{display:flex;align-items:center;gap:8rpx;min-height:72rpx;padding:0 12rpx;font-size:26rpx}.commerce-page .payment-choice radio{transform:scale(.8);margin-right:0}.commerce-page .disclosure{display:flex;justify-content:space-between;align-items:center;width:100%;margin:0;background:transparent;color:var(--mall-muted);font-size:26rpx;line-height:1.5;text-align:left;padding:8rpx 0;min-height:64rpx}.commerce-page .deadline{margin-top:12rpx;color:var(--mall-brand);font-size:24rpx}.commerce-page .payment-instructions{margin-top:16rpx;padding-top:12rpx;font-size:24rpx}.commerce-page .payment-instructions>text{display:block;white-space:pre-wrap;overflow-wrap:anywhere;margin:8rpx 0}.commerce-page .footer button{min-width:224rpx}.commerce-page .restaurant-header,.commerce-page .warehouse-header,.commerce-page .profile-hero{background:#fff;border-radius:0;border-bottom:1rpx solid var(--mall-border)}.commerce-page .restaurant-name,.commerce-page .warehouse-name,.commerce-page .grade-name{font-size:32rpx;font-weight:600}.commerce-page .dashboard-note,.commerce-page .page-note{font-size:24rpx;line-height:1.5}.commerce-page .order-reference{font-size:26rpx;color:var(--mall-muted)}
