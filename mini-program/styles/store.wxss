.store-page{padding:28rpx;background:#f5f6f7;min-height:100vh;color:#25292d;font-size:28rpx}.card{background:#fff;border-radius:18rpx;padding:28rpx;margin:24rpx 0}.title{font-size:34rpx;font-weight:700}.muted{color:#737b84;font-size:25rpx;line-height:1.7;margin:12rpx 0}.store-row,.actions,.search{display:flex;gap:16rpx;align-items:center;justify-content:space-between}.store-row>view{flex:1}.search input{flex:1;background:#fff;padding:24rpx;border-radius:12rpx;min-width:0}button{background:#a3202b;color:white;font-size:27rpx;border-radius:12rpx;margin:16rpx 0;padding:0 24rpx}button::after{border:0}.secondary{color:#a3202b;background:#fff;border:1rpx solid #ddd}.state{padding:60rpx 8rpx;text-align:center}.tag{font-size:22rpx;color:#a3202b}.error{color:#a3202b;line-height:1.6}.stock-input{border:1rpx solid #c8cdd2;border-radius:10rpx;padding:20rpx;margin:12rpx 0}.tabs{display:flex;gap:12rpx;flex-wrap:wrap}.tabs button{flex:1}.row{display:flex;justify-content:space-between;padding:12rpx 0}.caption{font-size:24rpx;color:#737b84}.actions button{flex:1;font-size:24rpx}.notice{padding:24rpx;background:#fff1dd;border-radius:12rpx;margin:20rpx 0}
