FROM node:24.13.0-bookworm-slim@sha256:4660b1ca8b28d6d1906fd644abe34b2ed81d15434d26d845ef0aced307cf4b6f AS build
WORKDIR /build
COPY pc-admin/package.json pc-admin/pnpm-lock.yaml ./
RUN corepack prepare pnpm@11.15.1 --activate \
    && corepack pnpm install --frozen-lockfile
COPY pc-admin/ ./
RUN corepack pnpm build

FROM nginx:stable-alpine3.24-slim@sha256:32463212baf0e7d91aded2e9b843a4f2b9e017804b8c9d5bae7b51dcef64389c
ARG MALL_BUILD_REVISION
LABEL org.opencontainers.image.revision=${MALL_BUILD_REVISION}
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-proxy-default.conf /etc/nginx/mall-proxy-scheme.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 8080
