FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings

ARG E5_APT_MIRROR=deb.debian.org
RUN case "$E5_APT_MIRROR" in deb.debian.org|mirrors.aliyun.com) ;; *) exit 1 ;; esac \
    && sed -i "s|deb.debian.org|$E5_APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install --no-install-recommends -y git ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 mall \
    && useradd --uid 10001 --gid 10001 --create-home mall

WORKDIR /app
COPY backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock
COPY --chown=10001:10001 . /app
RUN chown 10001:10001 /app

USER 10001:10001
ARG MALL_BUILD_REVISION
RUN test "$(git -C /app rev-parse --verify 'HEAD^{commit}')" = "$MALL_BUILD_REVISION" \
    && test -z "$(git -C /app status --porcelain --untracked-files=all)"
LABEL org.opencontainers.image.revision=${MALL_BUILD_REVISION}
EXPOSE 8000
