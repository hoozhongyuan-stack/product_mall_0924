# Copy outside the checkout, chmod 600, then pass it as E5_ENV_FILE.
# Use a full, reviewed Git commit SHA and an immutable checkout of that commit.
E5_DEPLOY_PROFILE=production
MALL_COMPOSE_PROJECT=product-mall
MALL_RELEASE_REVISION=REPLACE_WITH_FULL_40_CHARACTER_COMMIT_SHA
# Keep 1 until the deployed Mini Program renderer has been verified for a higher schema.
PAGE_RUNTIME_SCHEMA_VERSION=1
MALL_ALLOWED_HOSTS=mall.example.com
MALL_CSRF_TRUSTED_ORIGINS=https://mall.example.com
MALL_HTTP_PORT=18080
POSTGRES_DB=product_mall
POSTGRES_USER=product_mall
E5_POSTGRES_PASSWORD_FILE=/private/product-mall/postgres_password
E5_DJANGO_SECRET_KEY_FILE=/private/product-mall/django_secret_key
E5_WECHAT_CREDENTIAL_KEY_FILE=/private/product-mall/wechat_credential_key
# Public AppID only; configure AppSecret through the protected admin settings UI.
WECHAT_MINI_APP_ID=
# Optional known public egress IP for the WeChat code-upload allowlist display.
WECHAT_CODE_UPLOAD_EGRESS_IP=
# Optional HTTPS origin for a deploy-specific immutable Mini Program package.
MALL_MINIPROGRAM_API_BASE_URL=
E5_BACKUP_HOST_DIR=/private/product-mall/backups
# Optional UAT ingress metadata, used only with E5_DEPLOY_PROFILE=uat above.
# The edge network must already be dedicated to Caddy and this mall instance.
MALL_EDGE_NETWORK=product-mall-uat-edge
MALL_EDGE_ALIAS=product-mall-uat-admin
