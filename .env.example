POSTGRES_PORT=15432
POSTGRES_DB=product_mall_dev
POSTGRES_USER=product_mall_dev
# 前置仓地点搜索优先使用后台加密配置；未托管时兼容下列环境参数。
# 实际值仅在后台或部署环境配置，不能提交到源码。
AMAP_WEB_SERVICE_KEY=
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
# 正式微信小程序的 AppID/Secret 由 Leo 在部署环境配置；不要提交真实密钥。
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# Private Fernet key file shared by web/workers. Required for managed credentials;
# never generate at boot, commit the key, or reuse DJANGO_SECRET_KEY.
MALL_WECHAT_CREDENTIAL_KEY_FILE=
# 微信支付 C2：配置文件由部署环境提供，当前不配置商户、不改变公开闸门。
# APIv3 key 文件须恰好 32 字节；私钥与微信公钥/平台证书为 PEM。
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_API_V3_KEY_FILE=
WECHAT_PAY_PRIVATE_KEY_FILE=
# JSON 对象：微信公钥 ID/平台证书序列号 -> 私有文件绝对路径；轮换可同时保留多个。
WECHAT_PAY_PLATFORM_KEYS={}
WECHAT_PAY_NOTIFY_URL=
# 物流轨迹：账号和商户联调完成前保持关闭；密钥只放部署环境。
KDNIAO_ENABLED=0
KDNIAO_EBUSINESS_ID=
KDNIAO_APP_KEY=
# D2 微信退款：仅完成真实商户验收后由部署持有人启用，默认关闭。
WECHAT_REFUND_ENABLED=0
WECHAT_REFUND_NOTIFY_URL=
# 多个本机隔离库同域体验时可设置不同会话Cookie名；生产默认sessionid。
DJANGO_SESSION_COOKIE_NAME=sessionid
# D5 积分兑换独立闸门；仅隔离库合成体验可开启，公开验收前保持关闭。
EXCHANGE_ORDER_ENABLED=0

# E0: production must mount this directory on persistent storage.
# MALL_MEDIA_ROOT=/var/lib/product-mall/files
# Media APIs enforce visibility; never publish this root as a static directory.
STORAGE_CODE_MAX_BYTES=209715200
STORAGE_EXPORT_MAX_BYTES=104857600
